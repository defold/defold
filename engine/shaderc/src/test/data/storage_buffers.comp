#version 430

layout(local_size_x = 1) in;
layout(std430, binding = 2, set = 1) readonly buffer Input { uint values[]; } input_buffer;
layout(std430, binding = 3, set = 1) buffer Output { uint values[]; } output_buffer;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    output_buffer.values[index] = input_buffer.values[index] + 1;
}
