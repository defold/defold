#version 140

// Scanline sweeper vertex contract.
in highp vec4 position;
in highp vec4 texcoord;
in highp vec4 effect_params;
in lowp vec4 color;
in highp vec2 texcoord0;
in highp vec4 sdf_params;

out highp vec2 var_texcoord;
out mediump vec4 var_color;
out highp vec2 var_sdf_texcoord;
flat out highp vec4 var_effect_params;
flat out highp vec4 var_glyph;
flat out highp vec4 var_params;

uniform vs_uniforms
{
    mat4 view_proj;
    vec4 viewport;
};

void main()
{
    var_texcoord = texcoord.xy;
    var_color = color;
    var_sdf_texcoord = texcoord0;
    var_effect_params = effect_params;
    var_glyph = vec4(texcoord.z, texcoord.w, position.z, position.w);
    var_params = sdf_params;
    gl_Position = view_proj * vec4(position.xy, 0.0, 1.0);
}
