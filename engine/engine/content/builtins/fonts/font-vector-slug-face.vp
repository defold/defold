#version 140

// Lean face-only Slug-style vertex contract.
in highp vec4 position;
in highp vec4 texcoord;
in highp vec4 effect_params;
in highp vec4 banding;
in lowp vec4 color;

out highp vec2 var_texcoord;
out mediump vec4 var_color;
flat out highp vec4 var_banding;
flat out highp vec2 var_jacobian;
flat out highp vec2 var_glyph;

uniform vs_uniforms
{
    mat4 view_proj;
    vec4 viewport;
};

void main()
{
    var_texcoord = texcoord.xy;
    var_color = color;
    var_banding = banding;
    var_jacobian = effect_params.xy;
    var_glyph = texcoord.zw;
    gl_Position = view_proj * vec4(position.xy, 0.0, 1.0);
}
