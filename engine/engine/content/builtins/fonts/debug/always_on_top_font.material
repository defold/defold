name: "always_on_top_font"
tags: "debug_text"
vertex_program: "/builtins/fonts/debug/always_on_top_font.vp"
fragment_program: "/builtins/fonts/debug/always_on_top_font.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
samplers {
  name: "texture_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_DEFAULT
  filter_mag: FILTER_MODE_MAG_DEFAULT
}
