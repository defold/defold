#version 140

#include "/builtins/fonts/font-effect.glsl"

out mediump vec2 var_texcoord0;
out highp vec4 var_effect;
out mediump vec4 var_face_color;
out mediump vec4 var_outline_color;
out highp vec2 var_decoration;

// positions are in world space
in mediump vec4 position;
in mediump vec2 texcoord0;
in mediump vec4 face_color;
in mediump vec4 outline_color;
in mediump vec4 shadow_color;
in mediump vec3 layer_mask;
in highp vec4 effect;

uniform vs_uniforms
{
    mat4 view_proj;
};

void main()
{
    var_texcoord0 = texcoord0;
    var_effect = effect;
    var_face_color = font_effect_vertex_color(var_effect, face_color);
    var_decoration = layer_mask.z < 0.0 ? vec2(layer_mask.y, -layer_mask.z) : vec2(0.0);
    gl_Position = view_proj * vec4(position.x, position.y, position.z, 1.0);
}
