local LOAD_TIMEOUT_SECONDS = 30

function init(self)
	self.load_started_at = socket.gettime()
	msg.post("#collectionproxy", "async_load")
end

function update(self, dt)
	-- Headless CI can run hundreds of frames before the async load completes.
	if socket.gettime() - self.load_started_at > LOAD_TIMEOUT_SECONDS then
		print("Timed out waiting for proxy_loaded after " .. LOAD_TIMEOUT_SECONDS .. " seconds!")
		sys.exit(1)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "init")
		msg.post(sender, "enable")

		-- The issue was that the loading became messed up, and we'd wait forever
		print("Loaded!")
		sys.exit(0)
	end
end
