function init(self)
	self.frame = 0
	msg.post("#proxy", "load")
end

function update(self, dt)
	self.frame = self.frame + 1
	if self.frame == 5 then
		sys.exit(0)
	end
end

function on_message(self, message_id, message)
	if message_id == hash("proxy_loaded") then
		msg.post("#proxy", "enable")
	end
end
