local function assert_near(expected, actual, name)
    assert(math.abs(expected - actual) < 0.0001,
        string.format("%s: expected %g, got %g", name, expected, actual))
end

local function assert_metrics(expected, actual)
    for _, name in ipairs({ "width", "height", "max_ascent", "max_descent" }) do
        assert_near(expected[name], actual[name], name)
    end
end

local function test_default_options(font)
    local plain = resource.get_text_metrics(font, "Hello World")
    assert_metrics(plain, resource.get_text_metrics(font, "Hello World", {}))
    assert_metrics(plain, resource.get_text_metrics(font, "Hello World", {
        width = 1,
        line_break = false,
        leading = 1,
        tracking = 0,
    }))
end

local function test_wrapping_and_leading(font)
    local word = resource.get_text_metrics(font, "Hello")
    local options = { width = word.width + 1, line_break = true }
    local wrapped = resource.get_text_metrics(font, "Hello Hello", options)
    assert_near(word.width, wrapped.width, "wrapped width")
    assert_near(word.height * 2, wrapped.height, "wrapped height")

    options.leading = 2
    local spaced = resource.get_text_metrics(font, "Hello Hello", options)
    assert_near(wrapped.width, spaced.width, "leading preserves width")
    assert_near(word.height * 3, spaced.height, "leading increases line spacing")
end

local function test_tracking(font)
    local plain = resource.get_text_metrics(font, "Hello World")
    local tracked = resource.get_text_metrics(font, "Hello World", { tracking = 0.5 })
    assert(tracked.width > plain.width, "tracking must increase width")
    assert_near(plain.height, tracked.height, "tracking preserves height")
    assert_near(plain.max_ascent, tracked.max_ascent, "tracking preserves ascent")
    assert_near(plain.max_descent, tracked.max_descent, "tracking preserves descent")
end

local function test_color_markup(font)
    local text = "Hello World"
    local markup = "Hello <color=#ff0000>World</color>"
    assert_metrics(resource.get_text_metrics(font, text), resource.get_text_metrics(font, markup))

    local word = resource.get_text_metrics(font, "Hello")
    local options = { width = word.width + 1, line_break = true }
    assert_metrics(resource.get_text_metrics(font, text, options), resource.get_text_metrics(font, markup, options))
end

local function test_size_markup(font)
    local plain = resource.get_text_metrics(font, "Hello")
    local larger = resource.get_text_metrics(font, "<size=28>Hello</size>")
    assert_near(plain.height * 2, larger.height, "size markup doubles height from the base font size of 14")
    assert(larger.width > plain.width, "size markup must increase width")

    local base_size = resource.get_text_metrics(font, "<size=14>Hello</size>")
    assert_metrics(plain, base_size)
end

local function test_sprite_markup(font)
    local plain = resource.get_text_metrics(font, "AB")
    -- The fixture font is size 14, with a line height greater than 16.
    local sprites = {
        { "<sprite width=32 height=16/>", 32, plain.height },
        { "<sprite width=48 height=32></sprite>", 48, 32 },
        { "<sprite/>", 14, plain.height },
        { "<sprite width=2em height=200%/>", 28, 28 },
    }
    for _, sprite in ipairs(sprites) do
        local metrics = resource.get_text_metrics(font, "A" .. sprite[1] .. "B")
        assert_near(plain.width + sprite[2], metrics.width, sprite[1] .. " reserves width")
        assert_near(sprite[3], metrics.height, sprite[1] .. " reserves height")
    end
end

local function test_invalid_markup(font)
    local malformed = resource.get_text_metrics(font, "<color=#ff0000>Hello</size>")
    local literal = resource.get_text_metrics(font, "&lt;color=#ff0000&gt;Hello&lt;/size&gt;")
    assert_metrics(literal, malformed)

    -- Invalid tag values are ignored when the markup syntax is otherwise valid.
    local plain = resource.get_text_metrics(font, "Hello")
    assert_metrics(plain, resource.get_text_metrics(font, "<size=0>Hello</size>"))
end

local function test_empty_text(font)
    local plain = resource.get_text_metrics(font, "")
    assert_near(0, plain.width, "empty width")
    assert_near(0, plain.height, "empty height")
    assert_metrics(plain, resource.get_text_metrics(font, "<color=#ff0000></color>"))
end

function init(self)
    local label_str = ""

    for i = 32, 127 do
        label_str = label_str .. string.char(i)
    end

    label.set_text("#label_bitmap", label_str)
    label.set_text("#label_distance_field", label_str)
end

function update(self, dt)
    -- The values use metrics generated by the native font code, matching the
    -- engine runtime. The base settings used are:
    --  font: "/builtins/fonts/vera_mo_bd.ttf" - monospaced
    --  size: 14
    --  antialias: 1
    --  alpha: 1.0
    --  outline_alpha: 1.0
    --  outline_width: 4.0
    --  shadow_alpha: 1.0
    --  shadow_blur: 2
    -- The 96 glyph advances total 809.15625 pixels. Layout padding adds
    -- 6 pixels for the migrated legacy bitmap font and 7 pixels for the
    -- distance-field font, preserving the original spacing of each format.

    local function test_label_metrics(label_name, test_metrics)
        -- Test that we are getting the expected value back from get_text_metrics
        local comp = "#" .. label_name
        local font = go.get(comp, "font")
        local metrics = resource.get_text_metrics(font, label.get_text(comp))

        local result = test_metrics.max_ascent  == metrics.max_ascent and
                       test_metrics.max_descent == metrics.max_descent and
                       test_metrics.width       == metrics.width and
                       test_metrics.height      == metrics.height

        if not result then
            pprint("Metrics for: '", label.get_text(comp), "'")
            pprint("Wanted:", test_metrics)
            pprint("Got:", metrics)
        end
        return result
    end

    local function test_label_bitmap()
        local metrics_valid = {
            max_ascent  = 12.9951171875,
            width       = 815.15625,
            height      = 16.296875,
            max_descent = 3.3017578125
        }

        return test_label_metrics("label_bitmap", metrics_valid)
    end

    local function test_label_df()
        local metrics_valid = {
            max_ascent  = 12.9951171875,
            width       = 816.15625,
            height      = 16.296875,
            max_descent = 3.3017578125,
        }

        return test_label_metrics("label_distance_field", metrics_valid)
    end

    local success = test_label_bitmap()
    success = test_label_df() and success

    local tests = {
        { "default options", test_default_options },
        { "wrapping and leading", test_wrapping_and_leading },
        { "tracking", test_tracking },
        { "color markup", test_color_markup },
        { "size markup", test_size_markup },
        { "sprite markup", test_sprite_markup },
        { "invalid markup", test_invalid_markup },
        { "empty text", test_empty_text },
    }
    for _, label_name in ipairs({ "label_bitmap", "label_distance_field" }) do
        local font = go.get("#" .. label_name, "font")
        for _, test in ipairs(tests) do
            -- Run every case and exit on failure instead of leaving the engine running after a Lua error.
            local ok, err = pcall(test[2], font)
            print(string.format("resource.get_text_metrics %s / %s: %s", label_name, test[1], ok and "PASS" or err))
            success = ok and success
        end
    end

    if success then
        msg.post("@system:", "exit", { code = 0 })
    else
        msg.post("@system:", "exit", { code = 1 })
    end
end
