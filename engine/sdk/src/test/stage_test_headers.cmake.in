cmake_minimum_required(VERSION 4.0)

# Stage the public include tree without changing the SDK component's install manifest.
set(sources [==[@_sdk_stage_sources@]==])
set(names [==[@_sdk_stage_files@]==])
set(stage "${STAGE_ROOT}/@_sdk_manifest_id@")
file(GLOB old_stages "${STAGE_ROOT}/*")
list(REMOVE_ITEM old_stages "${stage}")
if(old_stages)
  file(REMOVE_RECURSE ${old_stages})
endif()
file(MAKE_DIRECTORY "${stage}")
foreach(source name IN ZIP_LISTS sources names)
  set(output "${stage}/sdk/include/dmsdk/${name}")
  cmake_path(GET output PARENT_PATH directory)
  file(MAKE_DIRECTORY "${directory}")
  file(COPY_FILE "${source}" "${output}" ONLY_IF_DIFFERENT)
endforeach()
