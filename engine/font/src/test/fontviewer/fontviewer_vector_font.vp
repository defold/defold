in vec4 position;
in vec4 color;
in vec4 clip;
in vec2 font_position;
in float paint;
flat out int var_paint;
out vec4 var_color;
flat out vec4 var_clip;
out vec2 var_font_position;
out vec2 var_position;
void main()
{
    gl_Position = position;
    var_position = position.xy;
    var_paint = int(paint);
    var_color = color;
    var_clip = clip;
    var_font_position = font_position;
}
