#version 140

#include "/builtins/fonts/font-effect.glsl"

// positions are in world space
in mediump vec4 position;
in mediump vec2 texcoord0;
in mediump vec4 sdf_params;
in mediump vec4 face_color;
in mediump vec4 outline_color;
in mediump vec4 shadow_color;
in mediump vec3 layer_mask;
in highp vec4 effect;
out highp vec4 var_effect;

out mediump vec2 var_texcoord0;
out mediump vec4 var_face_color;
out mediump vec4 var_outline_color;
out mediump vec4 var_shadow_color;
out mediump vec4 var_sdf_params;
out mediump vec4 var_layer_mask;
out highp vec2 var_decoration;

uniform vs_uniforms
{
    highp mat4 view_proj;
};

void main()
{
    var_texcoord0 = texcoord0;
    var_effect = effect;
    vec4 effect_face_color = font_effect_vertex_color(var_effect, face_color);
    var_face_color = vec4(effect_face_color.xyz * effect_face_color.w, effect_face_color.w);
    var_outline_color = vec4(outline_color.xyz * outline_color.w, outline_color.w);
    var_shadow_color = vec4(shadow_color.xyz * shadow_color.w, shadow_color.w);
    var_sdf_params = sdf_params;
    bool dashed_decoration = layer_mask.z < 0.0;
    var_decoration = dashed_decoration ? vec2(layer_mask.y, -layer_mask.z) : vec2(0.0);
    vec3 decoration_layer_mask = vec3(1.0 - step(1.5, layer_mask.x),
                                      step(1.5, layer_mask.x) * (1.0 - step(2.5, layer_mask.x)),
                                      step(2.5, layer_mask.x));
    var_layer_mask.rgb = dashed_decoration ? decoration_layer_mask : layer_mask;
    var_layer_mask.a = var_layer_mask.r * var_layer_mask.g * var_layer_mask.b;
    gl_Position = view_proj * vec4(position.x, position.y, position.z, 1.0);
}
