#version 430
#define DM_USE_INSTANCE_TRANSFORM_BUFFER
#define DM_INSTANCE_WORLD_ATTRIBUTE custom_world
#include "/builtins/materials/instance_transforms.glsl"
in highp vec4 position;
uniform Matrices { highp mat4 view_proj; lowp vec4 tint; };
out lowp vec4 color;
vec4 transform_position()
{
    return dm_instance_world() * position;
}
void main()
{
    color = tint * dm_instance_world()[3].w;
    color.b = float(gl_InstanceIndex & 1);
    gl_Position = view_proj * transform_position();
}
