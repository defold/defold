require "model.lua_test_helpers"

play_anim_done = false

local function test_play_anim(self)
    model.play_anim("#fox", "Run", go.PLAYBACK_ONCE_FORWARD, {}, function(self, message_id, message, sender)
        if message_id == hash("model_animation_done") then
            play_anim_done = true
        end
    end)
end

function init(self)
    play_anim_done = false
    test_play_anim(self)
end
