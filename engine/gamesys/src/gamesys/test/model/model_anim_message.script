require "model.lua_test_helpers"

play_anim_message_done = false

function init(self)
    play_anim_message_done = false
    model.play_anim("#fox", "Run", go.PLAYBACK_ONCE_FORWARD)
end

function on_message(self, message_id, message, sender)
    if message_id == hash("model_animation_done") then
        play_anim_message_done = true
    end
end
