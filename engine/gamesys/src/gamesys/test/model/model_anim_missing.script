require "model.lua_test_helpers"

play_anim_missing_done = false

function init(self)
    play_anim_missing_done = false

    assert_not_error(function()
        model.play_anim("#fox", "Missing", go.PLAYBACK_LOOP_FORWARD, {
            blend_duration = 0.1,
            playback_rate = 1,
        })
    end)

    play_anim_missing_done = true
end
