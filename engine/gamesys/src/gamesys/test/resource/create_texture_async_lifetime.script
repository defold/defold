-- Leave an upload for the C++ test to complete or finalize, retaining only a
-- weak buffer reference so the test can detect leaked upload references.
function init(self)
    async_texture_callback_count = 0
    async_texture_done = false
    async_texture_buffers = setmetatable({}, { __mode = "v" })
    local params = {
        width = 16,
        height = 16,
        type = graphics.TEXTURE_TYPE_2D,
        format = graphics.TEXTURE_FORMAT_RGBA,
    }
    local pixels
    if not async_texture_without_buffer then
        pixels = buffer.create(params.width * params.height, {
            { name = hash("rgba"), type = buffer.VALUE_TYPE_UINT8, count = 4 }
        })
        async_texture_buffers[1] = pixels
    end

    local callback = function(self, request_id, result)
        local info = resource.get_texture_info(result.path)
        assert(info.width == params.width and info.height == params.height)
        async_texture_callback_count = async_texture_callback_count + 1
        async_texture_done = true
    end

    local path = "/async_texture_lifetime.texturec"
    if async_texture_invalid_data then
        params.compression_type = graphics.COMPRESSION_TYPE_BASIS_UASTC
        local ok = pcall(resource.create_texture_async, path, params, pixels, callback)
        assert(not ok, "Invalid compressed texture data must fail")
    else
        resource.create_texture_async(path, params, pixels, callback)
        if async_texture_release then
            resource.release(path)
        end
    end
end
