go.property("frame", 0)

local SIZE = 8
local TEXTURE_PATH = "/sprite/runtime_atlas_recreate.texturec"
local ATLAS_PATH = "/sprite/runtime_atlas_recreate.texturesetc"

local function make_half(id, x)
    local w = SIZE / 2
    return {
        id = id,
        width = w,
        height = SIZE,
        vertices = {0, 0, 0, SIZE, w, SIZE, w, 0},
        uvs      = {x, 0, x, SIZE, x + w, SIZE, x + w, 0},
        indices  = {0, 1, 2, 0, 2, 3}
    }
end

-- The previous atlas is fully released and a new one is created and assigned within
-- the same frame, so the allocator may hand back the same TextureSetResource address.
-- The single animation frame alternates between the left (1) and right (2) half.
local function recreate(self)
    if self.atlas then
        go.set("#sprite", "image", self.orig_atlas)
        resource.release(self.atlas)
        resource.release(self.texture)
    end

    self.frame = self.frame % 2 + 1

    local buf = buffer.create(SIZE * SIZE, { { name = hash("rgba"), type = buffer.VALUE_TYPE_UINT8, count = 4 } })
    self.texture = resource.create_texture(TEXTURE_PATH, {
        width = SIZE,
        height = SIZE,
        type = graphics.TEXTURE_TYPE_2D,
        format = graphics.TEXTURE_FORMAT_RGBA
    }, buf)

    self.atlas = resource.create_atlas(ATLAS_PATH, {
        texture = TEXTURE_PATH,
        animations = { { id = "default", width = SIZE / 2, height = SIZE, frames = { self.frame } } },
        geometries = { make_half("left", 0), make_half("right", SIZE / 2) }
    })

    go.set("#sprite", "image", self.atlas)
end

function init(self)
    self.orig_atlas = go.get("#sprite", "image")
    recreate(self)
end

function update(self, dt)
    recreate(self)
end

function final(self)
    go.set("#sprite", "image", self.orig_atlas)
    resource.release(self.atlas)
    resource.release(self.texture)
end
