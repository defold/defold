tests_done = false

local function assert_error(func)
    local ok, err = pcall(func)
    if not ok then
        print(err)
    end
    assert(not ok)
end

local function assert_near(a, b, eps)
    eps = eps or 0.001
    local diff = math.abs(a - b)
    if not (diff < eps) then
        local message = string.format("assert_near failed: %f differs from %f by %f", a, b, diff)
        error(debug.traceback(message))
    end
end

local function assert_vec3_near(a, b, eps)
    assert_near(a.x, b.x, eps)
    assert_near(a.y, b.y, eps)
    assert_near(a.z, b.z, eps)
end

local function assert_quat_near(a, b, eps)
    assert_near(a.x, b.x, eps)
    assert_near(a.y, b.y, eps)
    assert_near(a.z, b.z, eps)
    assert_near(a.w, b.w, eps)
end

local function world_contains_object(world, object)
    for _, item in ipairs(bullet3d.world.get_collision_objects(world)) do
        if item == object then
            return true
        end
    end
    return false
end

-- Verifies exported collision-object, rigid-body and shape constants. Stable
-- numeric values matter because scripts pass them back through the native API.
local function test_constants()
    local constants = {
        { bullet3d.collision_object.ACTIVE_TAG, 1 },
        { bullet3d.collision_object.ISLAND_SLEEPING, 2 },
        { bullet3d.collision_object.WANTS_DEACTIVATION, 3 },
        { bullet3d.collision_object.DISABLE_DEACTIVATION, 4 },
        { bullet3d.collision_object.DISABLE_SIMULATION, 5 },
        { bullet3d.collision_object.CF_STATIC_OBJECT, 1 },
        { bullet3d.collision_object.CF_KINEMATIC_OBJECT, 2 },
        { bullet3d.collision_object.CF_NO_CONTACT_RESPONSE, 4 },
        { bullet3d.collision_object.CF_CUSTOM_MATERIAL_CALLBACK, 8 },
        { bullet3d.collision_object.CF_CHARACTER_OBJECT, 16 },
        { bullet3d.collision_object.CF_DISABLE_VISUALIZE_OBJECT, 32 },
        { bullet3d.collision_object.CF_DISABLE_SPU_COLLISION_PROCESSING, 64 },
        { bullet3d.collision_object.CO_COLLISION_OBJECT, 1 },
        { bullet3d.collision_object.CO_RIGID_BODY, 2 },
        { bullet3d.collision_object.CO_GHOST_OBJECT, 3 },
        { bullet3d.collision_object.CO_SOFT_BODY, 4 },
        { bullet3d.collision_object.CO_HF_FLUID, 5 },
        { bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY, 1 },
        { bullet3d.shape.SHAPE_TYPE_SPHERE, 0 },
        { bullet3d.shape.SHAPE_TYPE_BOX, 1 },
        { bullet3d.shape.SHAPE_TYPE_CAPSULE, 2 },
        { bullet3d.shape.SHAPE_TYPE_HULL, 3 },
    }
    for _, entry in ipairs(constants) do
        assert(entry[1] == entry[2])
    end
end

-- Verifies world-handle identity/string conversion, Bullet/generic gravity
-- synchronization, restoration, and the collision-object count query.
-- This protects the shared-world plumbing used by every other Bullet3D call.
local function test_world(world)
    assert(bullet3d.world.is_valid(world))
    assert(string.find(tostring(world), "Bullet3D.bullet3d_world", 1, true))

    local gravity = bullet3d.world.get_gravity(world)
    bullet3d.world.set_gravity(world, vmath.vector3(1, -2, 3))
    assert_vec3_near(bullet3d.world.get_gravity(world), vmath.vector3(1, -2, 3))
    assert_vec3_near(physics.get_gravity(), vmath.vector3(1, -2, 3))
    bullet3d.world.set_gravity(world, gravity)

    -- Spawned collision objects are queued until the collection update, so only
    -- verify the query shape during script initialization.
    local count = bullet3d.world.get_collision_object_count(world)
    assert(type(count) == "number")
end

-- Verifies dynamic collision-object transforms, material/contact/CCD properties,
-- activation controls, structural flag queries, and Bullet native type predicates.
-- This catches unit-conversion and type-dispatch errors at the Lua/native boundary.
local function test_collision_object(collision_object)
    assert(bullet3d.collision_object.is_valid(collision_object))
    assert(string.find(tostring(collision_object), "Bullet3D.bullet3d_collision_object", 1, true))

    -- These values come directly from the spawned fixture and independently
    -- verify native-to-Defold transform and material conversion at scale 0.1.
    local initial_position, initial_rotation = bullet3d.collision_object.get_world_transform(collision_object)
    assert_vec3_near(initial_position, vmath.vector3(10, 0, 0))
    assert_quat_near(initial_rotation, vmath.quat())
    assert_near(bullet3d.collision_object.get_friction(collision_object), 0.1)
    assert_near(bullet3d.collision_object.get_restitution(collision_object), 0.2)

    local position = vmath.vector3(10, 5, -3)
    local rotation = vmath.quat_rotation_z(0.25)
    assert_error(function()
        bullet3d.collision_object.set_world_transform(collision_object, position, vmath.quat(0, 0, 0, 0))
    end)
    bullet3d.collision_object.set_world_transform(collision_object, position, rotation)
    local actual_position, actual_rotation = bullet3d.collision_object.get_world_transform(collision_object)
    assert_vec3_near(actual_position, position)
    assert_quat_near(actual_rotation, rotation)

    position = vmath.vector3(-4, 6, 8)
    bullet3d.collision_object.set_position(collision_object, position)
    assert_vec3_near(bullet3d.collision_object.get_position(collision_object), position)

    rotation = vmath.quat_rotation_x(0.4)
    assert_error(function()
        bullet3d.collision_object.set_rotation(collision_object, vmath.quat(math.huge, 0, 0, 1))
    end)
    bullet3d.collision_object.set_rotation(collision_object, rotation)
    assert_quat_near(bullet3d.collision_object.get_rotation(collision_object), rotation)
    actual_position, actual_rotation = bullet3d.collision_object.get_world_transform(collision_object)
    assert_vec3_near(actual_position, position)
    assert_quat_near(actual_rotation, rotation)

    bullet3d.collision_object.set_friction(collision_object, 0.37)
    assert_near(bullet3d.collision_object.get_friction(collision_object), 0.37)

    bullet3d.collision_object.set_restitution(collision_object, 0.42)
    assert_near(bullet3d.collision_object.get_restitution(collision_object), 0.42)

    bullet3d.collision_object.set_contact_processing_threshold(collision_object, 1.25)
    assert_near(bullet3d.collision_object.get_contact_processing_threshold(collision_object), 1.25)

    bullet3d.collision_object.set_activation_state(collision_object, bullet3d.collision_object.ISLAND_SLEEPING)
    assert(bullet3d.collision_object.get_activation_state(collision_object) == bullet3d.collision_object.ISLAND_SLEEPING)
    assert(not bullet3d.collision_object.is_awake(collision_object))
    bullet3d.collision_object.set_awake(collision_object, true)
    assert(bullet3d.collision_object.is_awake(collision_object))
    assert(bullet3d.collision_object.is_active(collision_object))
    bullet3d.collision_object.set_awake(collision_object, false)
    assert(not bullet3d.collision_object.is_awake(collision_object))
    bullet3d.collision_object.activate(collision_object)
    assert(bullet3d.collision_object.is_awake(collision_object))
    bullet3d.collision_object.force_activation_state(collision_object, bullet3d.collision_object.DISABLE_DEACTIVATION)
    assert(bullet3d.collision_object.get_activation_state(collision_object) == bullet3d.collision_object.DISABLE_DEACTIVATION)
    bullet3d.collision_object.force_activation_state(collision_object, bullet3d.collision_object.ACTIVE_TAG)
    bullet3d.collision_object.activate(collision_object, true)
    assert(bullet3d.collision_object.is_awake(collision_object))
    bullet3d.collision_object.set_deactivation_time(collision_object, 1.25)
    assert_near(bullet3d.collision_object.get_deactivation_time(collision_object), 1.25)

    assert(bullet3d.collision_object.get_internal_type(collision_object) == bullet3d.collision_object.CO_RIGID_BODY)
    assert(bullet3d.collision_object.get_collision_flags(collision_object) == 0)
    assert(not bullet3d.collision_object.has_collision_flag(collision_object, bullet3d.collision_object.CF_STATIC_OBJECT))
    assert(not bullet3d.collision_object.has_collision_flag(collision_object, bullet3d.collision_object.CF_KINEMATIC_OBJECT))
    assert(not bullet3d.collision_object.is_static(collision_object))
    assert(not bullet3d.collision_object.is_kinematic(collision_object))
    assert(not bullet3d.collision_object.is_static_or_kinematic(collision_object))
    assert(bullet3d.collision_object.has_contact_response(collision_object))
    assert(bullet3d.collision_object.is_rigid_body(collision_object))
    assert(not bullet3d.collision_object.is_ghost_object(collision_object))

    bullet3d.collision_object.set_ccd_motion_threshold(collision_object, 0.75)
    assert_near(bullet3d.collision_object.get_ccd_motion_threshold(collision_object), 0.75)
    bullet3d.collision_object.set_ccd_swept_sphere_radius(collision_object, 0.5)
    assert_near(bullet3d.collision_object.get_ccd_swept_sphere_radius(collision_object), 0.5)
end

-- Verifies every rigid-body query/mutator category, including scale-sensitive
-- transforms, thresholds, forces, torque, impulses, local-point velocity and AABB.
-- This prevents plausible-looking round trips from hiding incorrect native state.
local function test_rigid_body(world, rigid_body)
    assert(bullet3d.rigid_body.is_valid(rigid_body))
    assert(bullet3d.rigid_body.get_world(rigid_body) == world)
    assert_near(bullet3d.rigid_body.get_mass(rigid_body), 1.0)
    assert_near(bullet3d.rigid_body.get_inverse_mass(rigid_body), 1.0)
    assert_vec3_near(bullet3d.rigid_body.get_center_of_mass_position(rigid_body), vmath.vector3(10, 0, 0))
    assert_near(bullet3d.rigid_body.get_linear_sleeping_threshold(rigid_body), 8.0)
    assert_near(bullet3d.rigid_body.get_angular_sleeping_threshold(rigid_body), 1.0)

    -- The unit-box resource is centered at x=10. Exact bounds independently
    -- verify native-to-Defold AABB conversion at physics scale 0.1.
    local initial_aabb = bullet3d.rigid_body.compute_aabb(rigid_body)
    assert_vec3_near(initial_aabb.lower, vmath.vector3(9, -1, -1))
    assert_vec3_near(initial_aabb.upper, vmath.vector3(11, 1, 1))

    -- The computation uses the current body transform directly; it does not
    -- depend on the broadphase proxy being refreshed by a world update.
    bullet3d.collision_object.set_position(rigid_body, vmath.vector3(12, 0, 0))
    local moved_aabb = bullet3d.rigid_body.compute_aabb(rigid_body)
    assert_vec3_near(moved_aabb.lower, vmath.vector3(11, -1, -1))
    assert_vec3_near(moved_aabb.upper, vmath.vector3(13, 1, 1))
    bullet3d.collision_object.set_position(rigid_body, vmath.vector3(10, 0, 0))

    local linear_velocity = vmath.vector3(1, 2, 3)
    bullet3d.rigid_body.set_linear_velocity(rigid_body, linear_velocity)
    assert_vec3_near(bullet3d.rigid_body.get_linear_velocity(rigid_body), linear_velocity)

    local angular_velocity = vmath.vector3(0, 0, 2)
    bullet3d.rigid_body.set_angular_velocity(rigid_body, angular_velocity)
    assert_vec3_near(bullet3d.rigid_body.get_angular_velocity(rigid_body), angular_velocity)
    assert_vec3_near(bullet3d.rigid_body.get_velocity_in_local_point(rigid_body, vmath.vector3(0, 5, 0)), vmath.vector3(-9, 2, 3))
    assert_vec3_near(
        bullet3d.rigid_body.get_linear_velocity_from_world_point(rigid_body, vmath.vector3(10, 5, 0)),
        vmath.vector3(-9, 2, 3))
    assert_vec3_near(
        bullet3d.rigid_body.get_linear_velocity_from_local_point(rigid_body, vmath.vector3(0, 5, 0)),
        vmath.vector3(-9, 2, 3))

    -- The local-point helper rotates the input into world axes, unlike Bullet's
    -- legacy get_velocity_in_local_point relative-offset convention.
    local body_rotation = bullet3d.collision_object.get_rotation(rigid_body)
    bullet3d.collision_object.set_rotation(rigid_body, vmath.quat_rotation_z(math.pi * 0.5))
    assert_vec3_near(
        bullet3d.rigid_body.get_velocity_in_local_point(rigid_body, vmath.vector3(0, 5, 0)),
        vmath.vector3(-9, 2, 3))
    assert_vec3_near(
        bullet3d.rigid_body.get_linear_velocity_from_world_point(rigid_body, vmath.vector3(5, 0, 0)),
        vmath.vector3(1, -8, 3))
    assert_vec3_near(
        bullet3d.rigid_body.get_linear_velocity_from_local_point(rigid_body, vmath.vector3(0, 5, 0)),
        vmath.vector3(1, -8, 3))
    bullet3d.collision_object.set_rotation(rigid_body, body_rotation)

    bullet3d.rigid_body.set_damping(rigid_body, 0.2, 0.3)
    local linear_damping, angular_damping = bullet3d.rigid_body.get_damping(rigid_body)
    assert_near(linear_damping, 0.2)
    assert_near(angular_damping, 0.3)
    bullet3d.rigid_body.set_linear_damping(rigid_body, 0.4)
    bullet3d.rigid_body.set_angular_damping(rigid_body, 0.5)
    assert_near(bullet3d.rigid_body.get_linear_damping(rigid_body), 0.4)
    assert_near(bullet3d.rigid_body.get_angular_damping(rigid_body), 0.5)

    local linear_factor = vmath.vector3(1, 0.5, 0.25)
    bullet3d.rigid_body.set_linear_factor(rigid_body, linear_factor)
    assert_vec3_near(bullet3d.rigid_body.get_linear_factor(rigid_body), linear_factor)

    local angular_factor = vmath.vector3(0.25, 0.5, 1)
    bullet3d.rigid_body.set_angular_factor(rigid_body, angular_factor)
    assert_vec3_near(bullet3d.rigid_body.get_angular_factor(rigid_body), angular_factor)

    bullet3d.rigid_body.set_linear_factor(rigid_body, vmath.vector3(1, 1, 1))
    bullet3d.rigid_body.set_angular_factor(rigid_body, vmath.vector3(1, 1, 1))

    local original_gravity = bullet3d.rigid_body.get_gravity(rigid_body)
    local original_flags = bullet3d.rigid_body.get_flags(rigid_body)
    assert(original_flags == 0)
    assert(not bullet3d.rigid_body.has_flag(rigid_body, bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY))
    bullet3d.rigid_body.set_flags(rigid_body, bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY)
    assert(bullet3d.rigid_body.get_flags(rigid_body) == bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY)
    assert(bullet3d.rigid_body.has_flag(rigid_body, bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY))
    local custom_gravity = vmath.vector3(3, -4, 5)
    bullet3d.rigid_body.set_gravity(rigid_body, custom_gravity)
    assert_vec3_near(bullet3d.rigid_body.get_gravity(rigid_body), custom_gravity)
    bullet3d.rigid_body.set_gravity(rigid_body, original_gravity)
    bullet3d.rigid_body.set_flags(rigid_body, original_flags)
    assert(bullet3d.rigid_body.get_flags(rigid_body) == 0)
    assert(not bullet3d.rigid_body.has_flag(rigid_body, bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY))
    assert_vec3_near(bullet3d.rigid_body.get_gravity(rigid_body), original_gravity)

    bullet3d.rigid_body.set_sleeping_thresholds(rigid_body, 2.5, 0.75)
    assert_near(bullet3d.rigid_body.get_linear_sleeping_threshold(rigid_body), 2.5)
    assert_near(bullet3d.rigid_body.get_angular_sleeping_threshold(rigid_body), 0.75)

    local aabb = bullet3d.rigid_body.compute_aabb(rigid_body)
    assert(type(aabb) == "table")
    assert(type(aabb.lower) == "userdata")
    assert(type(aabb.upper) == "userdata")
    assert(aabb.lower.x < aabb.upper.x)
    assert(aabb.lower.y < aabb.upper.y)
    assert(aabb.lower.z < aabb.upper.z)

    bullet3d.rigid_body.clear_forces(rigid_body)
    bullet3d.rigid_body.apply_force(rigid_body, vmath.vector3(0, 2, 0), vmath.vector3(13, 0, 0))
    assert_vec3_near(bullet3d.rigid_body.get_total_force(rigid_body), vmath.vector3(0, 2, 0))
    assert_vec3_near(bullet3d.rigid_body.get_total_torque(rigid_body), vmath.vector3(0, 0, 6))
    bullet3d.rigid_body.apply_central_force(rigid_body, vmath.vector3(1, 0, 0))
    bullet3d.rigid_body.apply_torque(rigid_body, vmath.vector3(0, 0, 4))
    assert_vec3_near(bullet3d.rigid_body.get_total_force(rigid_body), vmath.vector3(1, 2, 0))
    assert_vec3_near(bullet3d.rigid_body.get_total_torque(rigid_body), vmath.vector3(0, 0, 10))
    bullet3d.rigid_body.clear_forces(rigid_body)
    assert_vec3_near(bullet3d.rigid_body.get_total_force(rigid_body), vmath.vector3())
    assert_vec3_near(bullet3d.rigid_body.get_total_torque(rigid_body), vmath.vector3())
    bullet3d.rigid_body.apply_force_at_relative_position(rigid_body, vmath.vector3(0, 2, 0), vmath.vector3(3, 0, 0))
    assert_vec3_near(bullet3d.rigid_body.get_total_force(rigid_body), vmath.vector3(0, 2, 0))
    assert_vec3_near(bullet3d.rigid_body.get_total_torque(rigid_body), vmath.vector3(0, 0, 6))
    bullet3d.rigid_body.clear_forces(rigid_body)

    bullet3d.rigid_body.set_linear_velocity(rigid_body, vmath.vector3())
    bullet3d.rigid_body.apply_central_impulse(rigid_body, vmath.vector3(1, 2, 3))
    assert_vec3_near(bullet3d.rigid_body.get_linear_velocity(rigid_body), vmath.vector3(1, 2, 3))
    bullet3d.rigid_body.set_linear_velocity(rigid_body, vmath.vector3())
    bullet3d.rigid_body.set_angular_velocity(rigid_body, vmath.vector3())
    bullet3d.rigid_body.apply_linear_impulse(rigid_body, vmath.vector3(1, 0, 0), vmath.vector3(10, 1, 0))
    assert_vec3_near(bullet3d.rigid_body.get_linear_velocity(rigid_body), vmath.vector3(1, 0, 0))
    assert_vec3_near(bullet3d.rigid_body.get_angular_velocity(rigid_body), vmath.vector3(0, 0, -1.5))

    bullet3d.rigid_body.set_linear_velocity(rigid_body, vmath.vector3())
    bullet3d.rigid_body.set_angular_velocity(rigid_body, vmath.vector3())
    bullet3d.rigid_body.apply_impulse(rigid_body, vmath.vector3(1, 0, 0), vmath.vector3(0, 1, 0))
    assert_vec3_near(bullet3d.rigid_body.get_linear_velocity(rigid_body), vmath.vector3(1, 0, 0))
    assert_vec3_near(bullet3d.rigid_body.get_angular_velocity(rigid_body), vmath.vector3(0, 0, -1.5))

    bullet3d.rigid_body.set_angular_velocity(rigid_body, vmath.vector3())
    bullet3d.rigid_body.apply_torque_impulse(rigid_body, vmath.vector3(0, 0, 1))
    assert_vec3_near(bullet3d.rigid_body.get_angular_velocity(rigid_body), vmath.vector3(0, 0, 1.5))

    bullet3d.rigid_body.set_mass_properties(rigid_body, 2, vmath.vector3(2, 4, 8))
    assert_near(bullet3d.rigid_body.get_mass(rigid_body), 2)
    assert_vec3_near(bullet3d.rigid_body.get_local_inertia(rigid_body), vmath.vector3(2, 4, 8))
    assert_error(function()
        bullet3d.rigid_body.set_mass_properties(rigid_body, 3, vmath.vector3(-1, 1, 1))
    end)
    assert_near(bullet3d.rigid_body.get_mass(rigid_body), 2)
    assert_error(function()
        bullet3d.rigid_body.set_mass(rigid_body, 0)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_mass(rigid_body, math.huge)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_mass(rigid_body, 1e-45)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_mass_properties(rigid_body, 3, vmath.vector3(1e-45, 1, 1))
    end)
    assert_near(bullet3d.rigid_body.get_mass(rigid_body), 2)
    assert_vec3_near(bullet3d.rigid_body.get_local_inertia(rigid_body), vmath.vector3(2, 4, 8))
    bullet3d.rigid_body.set_mass(rigid_body, 1)
    assert_near(bullet3d.rigid_body.get_mass(rigid_body), 1)
    local calculated_inertia = bullet3d.rigid_body.get_local_inertia(rigid_body)
    assert(calculated_inertia.x > 0 and calculated_inertia.y > 0 and calculated_inertia.z > 0)
end

-- Verifies non-finite, native-overflow and out-of-domain mutator inputs are
-- rejected before they can change Bullet state.
local function test_mutator_validation(world, collision_object, rigid_body)
    local infinity = math.huge
    local nan = 0 / 0

    local gravity = bullet3d.world.get_gravity(world)
    assert_error(function()
        bullet3d.world.set_gravity(world, vmath.vector3(0, -infinity, 0))
    end)
    assert_vec3_near(bullet3d.world.get_gravity(world), gravity)

    local position = bullet3d.collision_object.get_position(collision_object)
    assert_error(function()
        bullet3d.collision_object.set_position(collision_object, vmath.vector3(infinity, 0, 0))
    end)
    assert_vec3_near(bullet3d.collision_object.get_position(collision_object), position)

    local friction = bullet3d.collision_object.get_friction(collision_object)
    assert_error(function()
        bullet3d.collision_object.set_friction(collision_object, infinity)
    end)
    assert_error(function()
        bullet3d.collision_object.set_friction(collision_object, 1e100)
    end)
    assert_near(bullet3d.collision_object.get_friction(collision_object), friction)

    local deactivation_time = bullet3d.collision_object.get_deactivation_time(collision_object)
    assert_error(function()
        bullet3d.collision_object.set_deactivation_time(collision_object, nan)
    end)
    assert_near(bullet3d.collision_object.get_deactivation_time(collision_object), deactivation_time)

    local ccd_radius = bullet3d.collision_object.get_ccd_swept_sphere_radius(collision_object)
    local ccd_threshold = bullet3d.collision_object.get_ccd_motion_threshold(collision_object)
    assert_error(function()
        bullet3d.collision_object.set_ccd_swept_sphere_radius(collision_object, -0.1)
    end)
    assert_error(function()
        bullet3d.collision_object.set_ccd_motion_threshold(collision_object, -0.1)
    end)
    assert_near(bullet3d.collision_object.get_ccd_swept_sphere_radius(collision_object), ccd_radius)
    assert_near(bullet3d.collision_object.get_ccd_motion_threshold(collision_object), ccd_threshold)

    assert_error(function()
        bullet3d.collision_object.activate(collision_object, "false")
    end)
    bullet3d.collision_object.activate(collision_object, nil)

    local velocity = bullet3d.rigid_body.get_linear_velocity(rigid_body)
    assert_error(function()
        bullet3d.rigid_body.set_linear_velocity(rigid_body, vmath.vector3(infinity, 0, 0))
    end)
    assert_error(function()
        bullet3d.rigid_body.set_angular_factor(rigid_body, vmath.vector3(1, nan, 1))
    end)
    assert_vec3_near(bullet3d.rigid_body.get_linear_velocity(rigid_body), velocity)

    local linear_damping, angular_damping = bullet3d.rigid_body.get_damping(rigid_body)
    assert_error(function()
        bullet3d.rigid_body.set_damping(rigid_body, -0.1, angular_damping)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_damping(rigid_body, linear_damping, 1.1)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_linear_damping(rigid_body, infinity)
    end)
    local actual_linear_damping, actual_angular_damping = bullet3d.rigid_body.get_damping(rigid_body)
    assert_near(actual_linear_damping, linear_damping)
    assert_near(actual_angular_damping, angular_damping)

    local linear_threshold = bullet3d.rigid_body.get_linear_sleeping_threshold(rigid_body)
    local angular_threshold = bullet3d.rigid_body.get_angular_sleeping_threshold(rigid_body)
    assert_error(function()
        bullet3d.rigid_body.set_sleeping_thresholds(rigid_body, -0.1, angular_threshold)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_sleeping_thresholds(rigid_body, linear_threshold, infinity)
    end)
    assert_near(bullet3d.rigid_body.get_linear_sleeping_threshold(rigid_body), linear_threshold)
    assert_near(bullet3d.rigid_body.get_angular_sleeping_threshold(rigid_body), angular_threshold)
end

-- Verifies the retained read-only collision-filter accessors. World queries need
-- these exact bits to reproduce the collision filtering used by the simulation.
local function test_collision_filter_accessors(collision_object)
    local group = bullet3d.collision_object.get_collision_filter_group(collision_object)
    local mask = bullet3d.collision_object.get_collision_filter_mask(collision_object)
    assert(type(group) == "number" and group >= 0 and group <= 65535)
    assert(type(mask) == "number" and mask >= 0 and mask <= 65535)
end

-- Verifies that an in-world body with disabled world gravity keeps its custom
-- value, then follows the world again after the flag is cleared and it is activated.
-- This guards per-body gravity from being overwritten during world updates.
local function test_world_gravity_flag(world, rigid_body)
    local original_world_gravity = bullet3d.world.get_gravity(world)
    local original_flags = bullet3d.rigid_body.get_flags(rigid_body)
    local custom_gravity = vmath.vector3(3, -4, 5)

    bullet3d.rigid_body.set_flags(rigid_body, bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY)
    bullet3d.rigid_body.set_gravity(rigid_body, custom_gravity)
    bullet3d.world.set_gravity(world, vmath.vector3(6, -7, 8))
    assert_vec3_near(bullet3d.rigid_body.get_gravity(rigid_body), custom_gravity)

    bullet3d.rigid_body.set_flags(rigid_body, original_flags)
    bullet3d.collision_object.activate(rigid_body, true)
    bullet3d.world.set_gravity(world, original_world_gravity)
    assert(not bullet3d.rigid_body.has_flag(rigid_body, bullet3d.rigid_body.BT_DISABLE_WORLD_GRAVITY))
    assert_vec3_near(bullet3d.rigid_body.get_gravity(rigid_body), original_world_gravity)
end

-- Verifies the true branches of static and kinematic classification, their
-- structural flags, zero-mass rigid-body lookup, shared collision-object type,
-- and that a waking rigid-body mutator cannot activate a static body.
-- This prevents dynamic-only operations from changing immovable body state.
local function test_static_and_kinematic(static_url, kinematic_url)
    local static_object = bullet3d.get_collision_object(static_url)
    local static_body = bullet3d.get_rigid_body(static_url)
    assert(static_object == static_body)
    assert(bullet3d.collision_object.is_static(static_object))
    assert(not bullet3d.collision_object.is_kinematic(static_object))
    assert(bullet3d.collision_object.is_static_or_kinematic(static_object))
    assert(bullet3d.collision_object.has_collision_flag(static_object, bullet3d.collision_object.CF_STATIC_OBJECT))
    assert(bullet3d.collision_object.get_collision_flags(static_object) == bullet3d.collision_object.CF_STATIC_OBJECT)
    assert_near(bullet3d.rigid_body.get_mass(static_body), 0)
    assert_near(bullet3d.rigid_body.get_inverse_mass(static_body), 0)
    assert_error(function()
        bullet3d.rigid_body.set_mass(static_body, 1)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_mass_properties(static_body, 1, vmath.vector3(1, 1, 1))
    end)
    bullet3d.collision_object.force_activation_state(static_body, bullet3d.collision_object.ISLAND_SLEEPING)
    assert(not bullet3d.collision_object.is_awake(static_body))
    bullet3d.rigid_body.set_linear_velocity(static_body, vmath.vector3(1, 2, 3))
    assert(not bullet3d.collision_object.is_awake(static_body))

    local kinematic_object = bullet3d.get_collision_object(kinematic_url)
    local kinematic_body = bullet3d.get_rigid_body(kinematic_url)
    assert(kinematic_object == kinematic_body)
    assert(not bullet3d.collision_object.is_static(kinematic_object))
    assert(bullet3d.collision_object.is_kinematic(kinematic_object))
    assert(bullet3d.collision_object.is_static_or_kinematic(kinematic_object))
    assert(bullet3d.collision_object.has_collision_flag(kinematic_object, bullet3d.collision_object.CF_KINEMATIC_OBJECT))
    assert(bullet3d.collision_object.get_collision_flags(kinematic_object) == bullet3d.collision_object.CF_KINEMATIC_OBJECT)
    assert_near(bullet3d.rigid_body.get_mass(kinematic_body), 0)
    assert_near(bullet3d.rigid_body.get_inverse_mass(kinematic_body), 0)
    assert_error(function()
        bullet3d.rigid_body.set_mass(kinematic_body, 1)
    end)
    assert_error(function()
        bullet3d.rigid_body.set_mass_properties(kinematic_body, 1, vmath.vector3(1, 1, 1))
    end)
end

-- Verifies that triggers use generic collision-object userdata backed by a ghost
-- object, expose no contact response, and are rejected by rigid-body entry points.
-- This prevents ghost objects from being treated as native rigid bodies.
local function test_trigger(trigger_url)
    local trigger = bullet3d.get_collision_object(trigger_url)
    assert(trigger ~= nil)
    assert(trigger == bullet3d.get_collision_object(trigger_url))
    assert(bullet3d.collision_object.is_valid(trigger))
    assert(not bullet3d.rigid_body.is_valid(trigger))
    assert(string.find(tostring(trigger), "Bullet3D.bullet3d_collision_object", 1, true))
    assert(bullet3d.get_rigid_body(trigger_url) == nil)
    assert(not bullet3d.collision_object.is_rigid_body(trigger))
    assert(bullet3d.collision_object.is_ghost_object(trigger))
    assert(not bullet3d.collision_object.has_contact_response(trigger))
    assert(bullet3d.collision_object.get_internal_type(trigger) == bullet3d.collision_object.CO_GHOST_OBJECT)
    assert(bullet3d.collision_object.has_collision_flag(trigger, bullet3d.collision_object.CF_NO_CONTACT_RESPONSE))
    assert(bullet3d.collision_object.get_collision_flags(trigger) ==
        bullet3d.collision_object.CF_STATIC_OBJECT + bullet3d.collision_object.CF_NO_CONTACT_RESPONSE)
    assert_error(function()
        bullet3d.rigid_body.get_mass(trigger)
    end)
    return trigger
end

-- Verifies namespace/version lookup, stable handle identity and every API
-- category before retaining dynamic and trigger handles for lifetime checks.
-- Retaining the original userdata is necessary to detect accidental handle revival.
function init(self)
    assert(PHYSICS == "bullet3d")
    assert(bullet3d ~= nil)
    assert(bullet3d.world ~= nil)
    assert(bullet3d.collision_object ~= nil)
    assert(bullet3d.rigid_body ~= nil)
    test_constants()

    local version = bullet3d.get_version()
    assert(version.version == "2.77")
    assert(version.number == 277)
    assert(version.major == 2)
    assert(version.minor == 77)

    local world = bullet3d.get_world()
    assert(world ~= nil)
    assert(world == bullet3d.get_world())
    test_world(world)

    local rigid_url = "/bullet3d_rigid_body#collisionobject"
    local collision_object = bullet3d.get_collision_object(rigid_url)
    local rigid_body = bullet3d.get_rigid_body(rigid_url)
    assert(collision_object ~= nil)
    assert(rigid_body ~= nil)
    assert(collision_object == rigid_body)
    assert(collision_object == bullet3d.get_collision_object(rigid_url))
    assert(rigid_body == bullet3d.get_rigid_body(rigid_url))

    test_rigid_body(world, rigid_body)
    test_collision_object(collision_object)
    test_mutator_validation(world, collision_object, rigid_body)
    test_static_and_kinematic("/bullet3d_static#collisionobject", "/bullet3d_kinematic#collisionobject")

    local trigger = test_trigger("/bullet3d_trigger#collisionobject")
    assert(bullet3d.collision_object.get_internal_type(collision_object) ~= bullet3d.collision_object.get_internal_type(trigger))

    self.expected_trigger_position = vmath.vector3(20, 6, -4)
    self.expected_trigger_rotation = vmath.quat_rotation_y(0.35)
    bullet3d.collision_object.set_world_transform(trigger, self.expected_trigger_position, self.expected_trigger_rotation)

    self.collision_object = collision_object
    self.rigid_body = rigid_body
    self.trigger = trigger
    self.shape = bullet3d.collision_object.get_shape(collision_object, 1)
    assert(bullet3d.shape.is_valid(self.shape))
    self.world = world
    self.filter_stage = "wait_initial_enabled"
    self.filter_frames = 0
    self.invalidation_frames = 0
    self.delete_requested = false
end

-- First verifies spawned-object counts and next-frame trigger transform persistence
-- in Bullet and GO state, then verifies deletion invalidation and stale-handle errors.
-- This protects deferred synchronization and native-object lifetime boundaries.
function update(self, dt)
    if self.filter_stage == "wait_initial_enabled" then
        self.filter_frames = self.filter_frames + 1
        if not world_contains_object(self.world, self.collision_object) then
            assert(self.filter_frames < 5)
            return
        end

        test_collision_filter_accessors(self.collision_object)
        self.original_filter_group = bullet3d.collision_object.get_collision_filter_group(self.collision_object)
        self.original_filter_mask = bullet3d.collision_object.get_collision_filter_mask(self.collision_object)
        msg.post("/bullet3d_rigid_body#collisionobject", "disable")
        self.filter_stage = "wait_disabled"
        self.filter_frames = 0
        return
    end

    if self.filter_stage == "wait_disabled" then
        self.filter_frames = self.filter_frames + 1
        if world_contains_object(self.world, self.collision_object) then
            assert(self.filter_frames < 5)
            return
        end

        msg.post("/bullet3d_rigid_body#collisionobject", "enable")
        self.filter_stage = "wait_enabled"
        self.filter_frames = 0
        return
    end

    if self.filter_stage == "wait_enabled" then
        self.filter_frames = self.filter_frames + 1
        if not world_contains_object(self.world, self.collision_object) then
            assert(self.filter_frames < 5)
            return
        end

        assert(bullet3d.collision_object.get_collision_filter_group(self.collision_object) == self.original_filter_group)
        assert(bullet3d.collision_object.get_collision_filter_mask(self.collision_object) == self.original_filter_mask)
        self.filter_stage = nil
    end

    if not self.delete_requested then
        local count = bullet3d.world.get_collision_object_count(self.world)
        assert(count == 5)
        test_world_gravity_flag(self.world, self.rigid_body)
        local position, rotation = bullet3d.collision_object.get_world_transform(self.trigger)
        assert_vec3_near(position, self.expected_trigger_position)
        assert_quat_near(rotation, self.expected_trigger_rotation)
        assert_vec3_near(go.get_position("/bullet3d_trigger"), self.expected_trigger_position)
        assert_quat_near(go.get_rotation("/bullet3d_trigger"), self.expected_trigger_rotation)

        go.delete("/bullet3d_rigid_body")
        go.delete("/bullet3d_trigger")
        self.delete_requested = true
        return
    end

    self.invalidation_frames = self.invalidation_frames + 1

    local collision_object_valid = bullet3d.collision_object.is_valid(self.collision_object)
    local rigid_body_valid = bullet3d.rigid_body.is_valid(self.rigid_body)
    local trigger_valid = bullet3d.collision_object.is_valid(self.trigger)
    local shape_valid = bullet3d.shape.is_valid(self.shape)
    if collision_object_valid or rigid_body_valid or trigger_valid or shape_valid then
        assert(self.invalidation_frames < 10)
        return
    end

    assert_error(function()
        bullet3d.collision_object.get_friction(self.collision_object)
    end)
    assert_error(function()
        bullet3d.rigid_body.get_mass(self.rigid_body)
    end)
    assert_error(function()
        bullet3d.collision_object.get_world_transform(self.trigger)
    end)
    assert_error(function()
        bullet3d.shape.get_type(self.shape)
    end)

    tests_done = true
end
