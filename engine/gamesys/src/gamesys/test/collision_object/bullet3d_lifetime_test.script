tests_done = false
bullet3d_lifetime_ready = false
bullet3d_lifetime_reload_complete = false
bullet3d_lifetime_world = nil
bullet3d_lifetime_body = nil

local function assert_error(func)
    local ok = pcall(func)
    assert(not ok)
end

-- Captures live world and body userdata before C++ reloads the collision resource
-- or destroys the collection, allowing those exact handles to be checked afterwards.
function init(self)
    bullet3d_lifetime_world = bullet3d.get_world()
    bullet3d_lifetime_body = bullet3d.get_rigid_body("#collisionobject")

    assert(bullet3d_lifetime_world ~= nil)
    assert(bullet3d_lifetime_body ~= nil)
    assert(bullet3d.world.is_valid(bullet3d_lifetime_world))
    assert(bullet3d.collision_object.is_valid(bullet3d_lifetime_body))
    assert(bullet3d.rigid_body.is_valid(bullet3d_lifetime_body))

    bullet3d_lifetime_ready = true
end

-- Verifies that same-generation resource recreation invalidates only the old
-- native body handle while the retained world and a fresh body lookup remain valid.
function update(self, dt)
    if tests_done or not bullet3d_lifetime_reload_complete then
        return
    end

    assert(bullet3d.world.is_valid(bullet3d_lifetime_world))
    assert(bullet3d.get_world() == bullet3d_lifetime_world)
    assert(not bullet3d.collision_object.is_valid(bullet3d_lifetime_body))
    assert(not bullet3d.rigid_body.is_valid(bullet3d_lifetime_body))
    assert_error(function()
        bullet3d.rigid_body.get_mass(bullet3d_lifetime_body)
    end)

    local fresh_body = bullet3d.get_rigid_body("#collisionobject")
    assert(fresh_body ~= nil)
    assert(fresh_body ~= bullet3d_lifetime_body)
    assert(bullet3d.collision_object.is_valid(fresh_body))
    assert(bullet3d.rigid_body.is_valid(fresh_body))
    assert(bullet3d.rigid_body.get_world(fresh_body) == bullet3d_lifetime_world)

    tests_done = true
end
