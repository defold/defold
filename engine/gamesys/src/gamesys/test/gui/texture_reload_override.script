local ATLAS_A = "/gui/texture_setter_override_a.a.texturesetc"
local ATLAS_B = "/gui/texture_setter_override_b.a.texturesetc"

function init(self)
    self.updated = false
end

function update(self, dt)
    if self.updated then
        return
    end

    local atlas_info = resource.get_atlas(ATLAS_B)
    resource.set_atlas(ATLAS_A, atlas_info)
    self.updated = true
end
