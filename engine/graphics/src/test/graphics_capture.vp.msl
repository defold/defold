#include <metal_stdlib>

using namespace metal;

struct Input
{
    float3 position [[attribute(0)]];
    float3 color [[attribute(1)]];
};

struct Output
{
    float4 position [[position]];
    float3 color [[user(locn0)]];
};

vertex Output main0(Input in [[stage_in]])
{
    Output out;
    // Match shaderc_spvc.cpp: MSL vertex compilation enables FLIP_VERTEX_Y.
    out.position = float4(in.position.x, -in.position.y, in.position.z, 1.0);
    out.color = in.color;
    return out;
}
