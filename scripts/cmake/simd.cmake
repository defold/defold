include_guard(GLOBAL)

# Keep ISA flags local to consumers and isolated runtime-dispatched kernels.
function(defold_target_simd_x86_isa target isa)
  if(NOT TARGET_PLATFORM MATCHES "^x86_64-")
    return()
  endif()
  if(isa STREQUAL "SSE2")
    set(_level 2)
    set(_flags -msse2 -mno-sse3 -mno-avx)
  elseif(isa STREQUAL "SSE3")
    set(_level 3)
    set(_flags -msse3 -mno-ssse3 -mno-avx)
  elseif(isa STREQUAL "SSE4.2")
    set(_level 42)
    set(_flags -msse4.2 -mno-avx -mno-popcnt)
  elseif(isa STREQUAL "AVX2")
    set(_level 256)
    set(_flags -mavx2 -mno-avx512f -mno-fma -mno-popcnt)
  elseif(isa STREQUAL "AVX512")
    set(_level 512)
    # Disabling FMA also disables AVX-512 in Clang; prevent contraction instead.
    set(_flags -mavx2 -mavx512f -mavx512bw -mno-avx512dq -mno-avx512vl -ffp-contract=off -mno-popcnt)
  else()
    message(FATAL_ERROR "Unknown isolated SIMD ISA: ${isa}")
  endif()
  target_compile_definitions(${target} PRIVATE DM_SIMD_X86_ISA=${_level})
  if(CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
      foreach(_flag IN LISTS _flags)
        target_compile_options(${target} PRIVATE "/clang:${_flag}")
      endforeach()
    endif()
    # MSVC's default code generation is SSE2; higher instructions are explicit
    # intrinsics selected by DM_SIMD_X86_ISA, without enabling AVX globally.
  else()
    target_compile_options(${target} PRIVATE ${_flags})
  endif()
endfunction()
