{
  "schema_version": 1,
  "name": "Broad web component candidate 1",
  "status": "provisional evaluation gates, not a production recommendation",
  "candidate_mode": "overlap_completion",
  "control_mode": "direct",
  "configuration": {
    "render.poc_pipeline": "component",
    "render.poc_threaded": 1,
    "render.poc_web_components": 1,
    "render.poc_web_overlap": 1,
    "render.poc_web_prepare_overlap": 1,
    "render.poc_web_schedule": 1,
    "render.poc_web_stack_kb": 5120,
    "sound.use_thread": 0,
    "render.poc_web_cache_window": 1
  },
  "minimum_repeats": 3,
  "minimum_measurement_seconds": 120,
  "target_throughput_gain_percent": 10,
  "maximum_p99_regression_percent": 5,
  "maximum_live_memory_increase_percent": 20,
  "steady_state_growth_tolerance_mib": 0.5,
  "target_workloads": [
    "geometry1000"
  ],
  "required_external_evidence": [
    "clean vanilla web comparison",
    "representative animated model/mesh game replay",
    "lower-powered target device",
    "physical input-to-display latency",
    "energy and sustained thermal behavior"
  ]
}
