# Settings: Derived from src/engine/wscript, debug target
# Derived from src/engine/wscript, headless target: Removes Record,Sound,Graphics,Input
platforms:
    common:
        context:
            defines: ["DM_DEBUG"]

    osx:
        context:
            symbols: ["EngineRecord"]
            frameworks: ["CoreMedia"]
            linkFlags: ["-Wl,-weak_framework,ScreenCaptureKit"]
    win32:
        context:
            symbols: ["EngineRecord"]
            libs: ["dxgi", "dwmapi", "mfuuid"]
    linux:
        context:
            symbols: ["EngineRecord"]
