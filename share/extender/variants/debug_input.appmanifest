# Debug automation storage and standalone native recording dependencies.
platforms:
    common:
        context:
            defines: ["DM_DEBUG"]
    osx:
        context:
            libs: ["dmbedtls"]
            symbols: ["EngineRecord"]
            linkFlags: ["-Wl,-weak_framework,ScreenCaptureKit"]
            frameworks: ["CoreMedia"]
    ios:
        context:
            libs: ["dmbedtls"]
    win32:
        context:
            symbols: ["EngineRecord"]
            libs: ["dxgi", "dwmapi", "mfuuid"]
    linux:
        context:
            symbols: ["EngineRecord"]
