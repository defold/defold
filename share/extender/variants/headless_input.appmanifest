# Derived from src/engine/wscript, headless target: Removes Record,Sound,Graphics,Input
platforms:
    common:
        context:
            defines: ["DM_HEADLESS"]
            # Keep platform_service from the debug engine library list; it uses platform_null.
            symbols: ["EnginePlatform"]
            libs: ["sound_null","graphics_null","hid_null","platform_null"]
            excludeLibs: ["record", "record_script", "record_service", "openh264"]
            excludeSymbols: ["ScriptRecord", "EngineRecord"]

    osx:
        context:
            excludeLibs: ["record","sound","graphics","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    linux:
        context:
            excludeLibs: ["record","openh264","sound","graphics","graphics_opengles","graphics_vulkan","hid","platform","platform_vulkan"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterVulkan", "GraphicsAdapterOpenGLES"]
            excludeDynamicLibs: ["vulkan","X11-xcb","openal","Xext","X11","Xi","GL","EGL","GLESv1_CM","GLESv2"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    web:
        context:
            excludeLibs: ["record","sound","graphics","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    win32:
        context:
            excludeLibs: ["record","sound","graphics","graphics_dx12","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterVulkan","GraphicsAdapterDX12"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    android:
        context:
            excludeLibs: ["record","sound","graphics","graphics_opengles","graphics_vulkan","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterOpenGLES","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    arm64-ios:
        context:
            excludeLibs: ["record","sound","graphics","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    arm64_sim-ios:
        context:
            excludeLibs: ["record","sound","graphics","graphics_metal","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderVorbis","GraphicsAdapterOpenGL","GraphicsAdapterVulkan","GraphicsAdapterMetal"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]
