# Derived from src/engine/wscript, headless target: Removes Record,Sound,Graphics,Input
platforms:
    common:
        context:
            defines: ["DM_HEADLESS"]
            libs: ["record_null","sound_null","graphics_null","hid_null","platform_null"]

    osx:
        context:
            excludeLibs: ["automation_capture", "graphics_metal", "record","vpx","sound","tremolo","graphics","hid","platform"]
            libs: ["automation_capture_null", "dmbedtls"]
            excludeSymbols: ["GraphicsAdapterMetal", "DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    linux:
        context:
            excludeLibs: ["automation_capture", "record","vpx","sound","tremolo","graphics","graphics_gles","hid","platform"]
            libs: ["automation_capture_null"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterVulkan", "GraphicsAdapterOpenGLES"]
            excludeDynamicLibs: ["openal","Xext","X11","Xi","GL","GLU","EGL","GLESv1_CM","GLESv2"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    web:
        context:
            excludeLibs: ["record","vpx","sound","tremolo","graphics","hid","platform"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    win32:
        context:
            excludeLibs: ["automation_capture", "record","vpx","sound","libtremolo","graphics","hid","platform"]
            libs: ["automation_capture_null"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    android:
        context:
            excludeLibs: ["automation_capture", "record","vpx","sound","tremolo","graphics","graphics_opengles","graphics_vulkan","hid","platform"]
            libs: ["automation_capture_null"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterOpenGLES","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    arm64-ios:
        context:
            excludeLibs: ["automation_capture", "record","vpx","sound","tremolo","graphics","hid","platform"]
            libs: ["automation_capture_null", "dmbedtls"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterVulkan"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]

    arm64_sim-ios:
        context:
            excludeLibs: ["automation_capture", "record","vpx","sound","tremolo","graphics","graphics_metal","hid","platform"]
            libs: ["automation_capture_null", "dmbedtls"]
            excludeSymbols: ["DefaultSoundDevice","AudioDecoderWav","AudioDecoderStbVorbis","AudioDecoderTremolo","GraphicsAdapterOpenGL","GraphicsAdapterVulkan","GraphicsAdapterMetal"]
            symbols: ["NullSoundDevice", "GraphicsAdapterNull"]
