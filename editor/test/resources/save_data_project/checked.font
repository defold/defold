font: "/builtins/fonts/vera_mo_bd.ttf"
material: "/builtins/fonts/font.material"
size: 32
vector_font_mode: VECTOR_FONT_MODE_BITMAP
render_mode: MODE_MULTI_LAYER
antialias: 0
alpha: 0.9
outline_alpha: 0.8
outline_width: 3.0
shadow_alpha: 0.3
shadow_blur: 8
shadow_x: 4.0
shadow_y: -4.0
all_chars: true
cache_width: 2048
cache_height: 2048
characters: " !\"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\303\245\303\244\303\266"
styles {
  name: "default"
}
styles {
  name: "notice"
  markup: "<color=#ff6600><ul>"
}
