output_directory: "build/liveupdate"
packages {
  name: "assets"
  provider: "folder"
  rules { name: "Sources" operation: REMOVE path: "/unused/.*" }
}
packages {
  name: "extra"
  provider: "custom-provider"
  rules { name: "Package" operation: REMOVE package: "assets" }
}
providers {
  provider: "custom-provider"
  properties { name: "format" value: "custom" }
}
providers {
  provider: "zip"
  properties { name: "compression-level" value: "9" }
}
