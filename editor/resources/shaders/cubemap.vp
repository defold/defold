#version 140

in highp vec3 position;
in mediump vec3 normal;

uniform vertex_uniforms {
    highp mat4 mtx_view_proj;
    highp mat4 mtx_world;
};

out highp vec3 var_world_position;
out mediump vec3 var_world_normal;

void main() {
    vec4 world_position = mtx_world * vec4(position, 1.0);
    var_world_position = world_position.xyz;
    var_world_normal = normalize(mat3(mtx_world) * normal);
    gl_Position = mtx_view_proj * world_position;
}
