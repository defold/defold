local M = {}

local function settings_from_text(text)
    local settings = {}
    local category
    for line in text:gmatch("[^\r\n]+") do
        local section = line:match("^%s*%[([^%]]*)%]")
        if section then
            category = section
        elseif category == "liveupdate" then
            local key, value = line:match("^%s*([^=]-)%s*=%s*(.-)%s*$")
            if key then settings[key] = value end
        end
    end
    return settings
end

local function quoted(value)
    -- Protobuf text strings use the same escapes for these characters.
    return '"' .. value:gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\r', '\\r'):gsub('\t', '\\t') .. '"'
end

local function convert(selection)
    local source = editor.get(selection, "path")
    local settings = settings_from_text(editor.get(selection, "text"))
    local mode = settings.mode or "Zip"
    assert(mode == "Zip" or mode == "Folder",
        tostring(localization.message("liveupdate.unsupported-publisher", {mode = mode})))
    local provider = mode == "Zip" and "zip" or "folder"
    local directory, name
    if mode == "Zip" then
        directory = settings["zip-filepath"]
        name = settings["zip-filename"]
    else
        directory = settings["output-directory"]
        name = settings["output-folder-name"]
    end
    if not directory or directory == "" then directory = "." end
    name = (name or ""):gsub("[^a-zA-Z0-9._-]+", "_")
    if mode == "Zip" then name = name:gsub("%.zip$", "") end
    if name == "" then name = "liveupdate" end
    local stem = name:match("^[^.]*"):lower()
    if not name:match("^[a-zA-Z0-9]") or name:lower() == "base"
        or ({con = true, prn = true, aux = true, nul = true})[stem]
        or stem:match("^com[1-9]$") or stem:match("^lpt[1-9]$") then
        name = "liveupdate_" .. name
    end

    local compression = editor.get("/game.project", "project.compress_archive") and "LZ4" or "NONE"
    local content = {
        "# Publisher settings and excluded content converted from " .. source,
        "# Clear game.project > Live Update > Settings, then select this file in Archive > Manifest.",
        "output_directory: " .. quoted(directory),
        'base_file_compression_preset: "legacy"',
        'file_compression_presets { name: "legacy" file_compression: ' .. compression .. ' }',
        'container_presets { name: "legacy" provider: ' .. quoted(provider)
            .. ' zip_level: ' .. (mode == "Zip" and (settings["zip-compression-level"] or "1") or "1") .. ' }',
        "packages {",
        "  name: " .. quoted(name),
        '  container_preset: "legacy"',
        '  file_compression_preset: "legacy"',
        editor.liveupdate.legacy_rules(),
        "}"
    }

    local destination = "/liveupdate.archivemanifest"
    local suffix = 0
    while editor.resource_attributes(destination).exists or editor.external_file_attributes(destination:sub(2)).exists do
        suffix = suffix + 1
        destination = "/liveupdate" .. suffix .. ".archivemanifest"
    end
    editor.create_resources({{destination, table.concat(content, "\n") .. "\n"}})
    editor.ui.open_resource(destination)
end

function M.get_commands()
    return {{
        label = localization.message("liveupdate.convert-settings"),
        locations = {"Assets"},
        id = "defold.liveupdate.convert-settings",
        query = {selection = {type = "resource", cardinality = "one"}},
        active = function(opts)
            return editor.get(opts.selection, "path"):match("%.settings$") ~= nil
                and editor.can_get(opts.selection, "text")
        end,
        run = function(opts)
            convert(opts.selection)
        end
    }}
end

return M
