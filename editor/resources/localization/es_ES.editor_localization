# Properties

property.tooltip = {help, select, none {} other {{help}\n\n}}Disponible como `{id}` en scripts del editor.

# Properties: universal

property.blend-mode = Modo de fusión
property.blend-mode.tooltip = Controla cómo se combinan los píxeles de este elemento con gráficos posteriores. **Alfa** da transparencia normal, **Añadir** abrillanta, **Multiplicar** oscurece y **Pantalla** produce un efecto brillante más suave; los modos disponibles dependen del tipo de elemento.
property.id = Id
property.id.tooltip = El identificador utilizado para dirigirse a esta instancia de colección, objeto del juego, o componente en tiempo de ejecución. Debe ser único entre sus hermanos; junto con la jerarquía, forma la URL del elemento.
property.image = Imagen
property.image.tooltip = El origen del archivo de imagen utilizado para construir este recurso. En un atlas es una imagen para ser empaquetada; en una fuente de celdas (tile source) contiene la cuadrícula de las celdas.
property.material = Material
property.material.tooltip = El material utilizado para renderizar este elemento. Define los shaders y sus entradas, así que elige uno compatible con la geometría y texturas del elemento.
property.name = Nombre
property.name.tooltip = El nombre utilizado para identificar esta entrada o recurso. Utilice un nombre único y descriptivo cuando otras entradas o APIs en tiempo de ejecución necesitan referirse a él.
property.path = Ruta
property.path.tooltip = El recurso del proyecto utilizado como prototipo para esta colección, objeto del juego o componente. Los cambios en el prototipo se reflejan en todos los casos, mientras que las sobrescrituras de propiedades específicas de las instancias siguen siendo locales.
property.position = Posición
property.position.tooltip = La translación a lo largo de los ejes X, Y, y Z, relativos a su padre. Moviendo un padre también mueve sus hijos.
property.rotation = Rotación
property.rotation.tooltip = La orientación alrededor de los ejes X, Y, y Z en grados, relativos a su padre. Rotar un padre también rota sus hijos.
property.scale = Escalar
property.scale.tooltip = Multiplica el tamaño del elemento a lo largo de los ejes X, Y, y Z relativos a su padre. Un valor de `1` mantiene la escala original.
property.size = Tamaño
property.size.tooltip = El ancho, alto, y si es aplicable, la profundidad del elemento. Cuando es solo de lectura, el tamaño es calculado automáticamente por el contenido del elemento o recursos de renderizado. Para nodos GUI, el tamaño también define los límites usados por interacción de usuario.
property.url = URL
property.url.tooltip = La dirección de solo lectura en tiempo de ejecución derivada de la jerarquía y el **Id**. Apunta a un objeto del juego o componente, o sirve como prefijo de dirección para los contenidos de una instancia de colección.

# Properties: appmanifest

property.appmanifest.physics-2d = Física 2D
property.appmanifest.physics-2d.tooltip = Selecciona la implementación de Box2D para incluir, o **nunca** para eliminar la física 2D y reducir el tamaño del motor. Box2D 3 puede comportarse de manera diferente a la implementación antigua, por lo que los proyectos existentes pueden necesitar ajustes de la física.
property.appmanifest.physics-3d = Física 3D
property.appmanifest.physics-3d.tooltip = Incluye el motor de física 3D de bala. Deshabilita esto cuando el proyecto no utiliza físicas 3D para reducir el tamaño del motor.
property.appmanifest.rig+model = Rig + Modelo
property.appmanifest.rig+model.tooltip = Elige si incluir tanto el renderizado de modelos como la animación de rig, solo la funcionalidad de rig o ninguno de los dos. Excluir la funcionalidad no usada reduce el tamaño del motor.
property.appmanifest.exclude-record = Excluir registro
property.appmanifest.exclude-record.tooltip = Elimina el soporte de grabación de vídeo de escritorio usado por el mensaje del sistema `start_record`. Actívalo cuando el proyecto no graba el juego para reducir el tamaño del motor.
property.appmanifest.profiler = Perfilador
property.appmanifest.profiler.tooltip = Elige qué compilaciones incluyen la funcionalidad del perfilador. **Sólo para depuración** lo excluye de las versiones de lanzamiento, **nunca** lo excluye totalmente, y **Siempre** también lo incluye en las versiones de lanzamiento.
property.appmanifest.exclude-sound = Excluir sonido
property.appmanifest.exclude-sound.tooltip = Elimina toda la funcionalidad de reproducción de sonido del motor. Activa esto solo cuando el proyecto no reproduzca audio.
property.appmanifest.exclude-gui = Excluir GUI
property.appmanifest.exclude-gui.tooltip = Eliminar recursos GUI, componentes y soporte Lua del motor. Actívalo solo cuando el proyecto no use escenas GUI o scripts.
property.appmanifest.exclude-particle-fx = Excluir partícula FX
property.appmanifest.exclude-particle-fx.tooltip = Elimina recursos de efectos de partículas, componentes y soporte de Lua, incluyendo nodos de partículas en escenas GUI. Las escenas GUI sin nodos de partículas permanecen soportadas.
property.appmanifest.exclude-tilemap = Excluir Tilemaps (mapas de celdas)
property.appmanifest.exclude-tilemap.tooltip = Elimina los recursos de mapas de celdas, los componentes y el soporte Lua del motor. Actívalo solo cuando el proyecto no use los mapas de celdas.
property.appmanifest.exclude-sound-decoder-wav = Excluir decodificador de sonido\: WAV
property.appmanifest.exclude-sound-decoder-wav.tooltip = Elimina el soporte para los recursos de sonido `.wav`. Activa esto solo cuando el proyecto no reproduzca el audio WAV.
property.appmanifest.exclude-sound-decoder-ogg = Excluir decodificador de sonido\: OGG
property.appmanifest.exclude-sound-decoder-ogg.tooltip = Elimina soporte para recursos de sonido Ogg Vorbis. Activa esto solo cuando el proyecto no reproduce audio `.ogg`.
property.appmanifest.include-sound-decoder-opus = Incluir decodificador de sonido\: Opus
property.appmanifest.include-sound-decoder-opus.tooltip = Incluye soporte para recursos de sonido Ogg Opus. El decodificador Opus está excluido por defecto y es necesario para reproducir audio `.opus`.
property.appmanifest.exclude-input = Excluir interacción de usuario
property.appmanifest.exclude-input.tooltip = Elimina toda la interacción de usuario del motor. Activa esto solo cuando el proyecto no utiliza el teclado, el ratón, toques de pantalla, el gamepad u otra interacción.
property.appmanifest.exclude-liveupdate = Excluir Live Update
property.appmanifest.exclude-liveupdate.tooltip = Elimina la funcionalidad Live Update usada para montar recursos excluidos del paquete inicial. Habilita esto solo cuando el proyecto no descarga y monta contenido de Live Update.
property.appmanifest.exclude-image = Excluir imagen
property.appmanifest.exclude-image.tooltip = Elimina el módulo Lua `image` del motor. Activa esto solo cuando los scripts del proyecto no utilizan sus funciones de carga de imagen y datos de imagen.
property.appmanifest.exclude-types = Excluir tipos de datos
property.appmanifest.exclude-types.tooltip = Elimina el módulo Lua `types` del motor. Activa esto solo cuando los scripts del proyecto no usen sus funciones de comprobación de tipos de datos.
property.appmanifest.exclude-basis-transcoder = Excluir Transcodificador Basis
property.appmanifest.exclude-basis-transcoder.tooltip = Elimina el transcodificador de textura Basis Universal. Activa esto solo cuando ningún perfil de textura utiliza compresión Basis Universal.
property.appmanifest.use-android-support-lib = Usar biblioteca de soporte para Android
property.appmanifest.use-android-support-lib.tooltip = Utiliza la biblioteca de soporte de Android obsoleta en lugar de AndroidX. Habilita esto solo para dependencias antiguas que no hayan migrado a AndroidX.
property.appmanifest.graphics = Gráficos
property.appmanifest.graphics.tooltip = Selecciona el backend gráfico incluido en las compilaciones de Windows y Linux. Incluyendo tanto OpenGL como Vulkan permiten un respaldo cuando el backend preferido no está disponible, pero aumenta el tamaño del motor.
property.appmanifest.graphics-osx = Gráficos (macOS)
property.appmanifest.graphics-osx.tooltip = Selecciona el backend gráfico incluido en las compilaciones de macOS. Vulkan es el predeterminado; una opción combinada incluye un backend de respaldo pero aumenta el tamaño del motor.
property.appmanifest.graphics-ios = Gráficos (iOS)
property.appmanifest.graphics-ios.tooltip = Selecciona el backend gráfico incluido en las compilaciones de iOS. OpenGL es el valor predeterminado; una opción combinada incluye un backend de respaldo pero aumenta el tamaño del motor.
property.appmanifest.graphics-android = Gráficos (Android)
property.appmanifest.graphics-android.tooltip = Selecciona el backend gráfico incluido en las compilaciones de Android. Por defecto incluye ambos, prefiriendo Vulkan cuando está disponible y OpenGL ES como respaldo.
property.appmanifest.graphics-web = Gráficos (HTML5)
property.appmanifest.graphics-web.tooltip = Selecciona el backend de gráficos incluido en las compilaciones HTML5. WebGL es el predeterminado; incluyendo ambos WebGL y WebGPU permite un respaldo, pero aumenta el tamaño del motor.
property.appmanifest.use-font-layout = Usar sistema de disposición de texto completo
property.appmanifest.use-font-layout.tooltip = Incluye el sistema completo de disposición de texto requerido para la generación de fuentes SDF en tiempo de ejecución a partir de fuentes TrueType. Rasterización de glifos en tiempo de ejecución también requiere `font.runtime_generation` en `game.project`; soporta características como texto de derecha a izquierda.
property.appmanifest.use-rich-text = Usar texto enriquecido
property.appmanifest.use-rich-text.tooltip = Incluye análisis de texto enriquecido y efectos de estilo para etiquetas y texto GUI. Deshabilita esto para reducir el tamaño del motor; entonces el texto etiquetado se mostrará como texto plano.

