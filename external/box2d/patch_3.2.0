+// DEFOLD EDIT BEGIN
+b2Vec2 b2Body_GetTotalForce( b2BodyId bodyId )
+{
+	b2World* world = b2GetWorld( bodyId.world0 );
+	b2Body* body = b2GetBodyFullId( world, bodyId );
+	if ( b2GetBodyState( world, body ) == NULL )
+	{
+		return b2Vec2_zero;
+	}
+	return b2GetBodySim( world, body )->force;
+}
