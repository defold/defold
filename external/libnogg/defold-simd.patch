+/* Adjacent bins on a flat section have the same gain.  Keeping the
+ * multiplication contiguous lets the compiler vectorize the run. */
+static inline void apply_floor1_gain(float *output, int begin, int end, int y)
+{
+    const float gain = floor1_inverse_db_table[y];
+    for (int x = begin; x < end; x++) {
+        output[x] *= gain;
+    }
+}

