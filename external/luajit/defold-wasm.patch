+enum { VM_ENTER, VM_RETURN, VM_RETURN_ERROR };
+
+static int vminterp_run(lua_State *L, int mode, ptrdiff_t result, int nres,
+                       const BCIns *resume_pc)
+{
+  global_State *g = G(L);
+  void *cf = cframe_raw(L->cframe);
+  const BCIns *pc = NULL;
+  cTValue *kbase;
+  TValue *base, *mb = NULL;
+  GCfunc *fn;
+  GCproto *pt;
+  BCIns ins;
+  BCOp op;
+  BCReg a, b, c, d;
+  int skiphook = 0;
+
+  if (resume_pc) {
+    fn = curr_func(L);
+    pt = funcproto(fn);
+    kbase = mref(pt->k, cTValue);
+    pc = resume_pc;
+    goto vm_reload;
+  }
+  if (mode == VM_RETURN_ERROR) {
+    copyTV(L, L->base+1, L->base);
+    setboolV(L->base, 0);
+    L->top = L->base+2;
+    result = savestack(L, L->base);
+    nres = 2;
+    goto vm_return;
+  }
+  if (mode == VM_RETURN) goto vm_return;
+
+vm_enter:
+  fn = curr_func(L);
+  if ((g->hookmask & (LUA_MASKCALL|HOOK_ACTIVE)) == LUA_MASKCALL) {
+    setcframe_pc(cf, frame_pc(L->base-1));
+    (void)lj_dispatch_call(L, mref(fn->c.pc, const BCIns)+1);
+    setcframe_pc(cf, NULL);
+  }
+  if (isluafunc(fn)) {
+    int nargs = (int)(L->top-L->base), i;
+    MSize need;
+    pt = funcproto(fn);
+    need = pt->framesize;
+    if (pt->flags & PROTO_VARARG) need += nargs+1;
+    if (L->base+need >= tvref(L->maxstack)) {
+      setcframe_pc(cf, proto_bc(pt)+1);
+      lj_state_growstack(L, need);
+    }
+    base = L->base;
+    if (pt->flags & PROTO_VARARG) {
+      TValue *vbase = L->top+1;
+      setframe_gc(vbase-1, obj2gco(fn), LJ_TFUNC);
+      setframe_ftsz(vbase-1, (nargs+1)*(ptrdiff_t)sizeof(TValue)+FRAME_VARG);
+      for (i = 0; i < pt->numparams; i++) {
+        if (i < nargs) { copyTV(L, vbase+i, base+i); setnilV(base+i); }
+        else setnilV(vbase+i);
+      }
+      L->base = vbase;
+    } else {
+      for (i = nargs; i < pt->numparams; i++) setnilV(base+i);
+    }
+    L->top = L->base+pt->framesize;
+    pc = proto_bc(pt)+1;
+    kbase = mref(pt->k, cTValue);
+    goto vm_reload;
+  } else {
+    TValue savedframe = L->base[-1];
+    int id = fn->c.ffid;
+    BCOp fop = bc_op(*mref(fn->c.pc, const BCIns));
+    setcframe_pc(cf, frame_pc(L->base-1));
+    lj_state_checkstack(L, LUA_MINSTACK);
+    if (fop >= BC__MAX && (id == FF_pcall || id == FF_xpcall)) {
+      int delta = id == FF_pcall ? 1 : 2;
+      lj_lib_checkany(L, 1);
+      if (id == FF_xpcall) {
+        TValue tmp;
+        lj_lib_checkfunc(L, 2);
+        copyTV(L, &tmp, L->base);
+        copyTV(L, L->base, L->base+1);
+        copyTV(L, L->base+1, &tmp);
+      }
+      mb = L->base+delta;
+      if (!tvisfunc(mb-1)) { lj_meta_call(L, mb-1, L->top); L->top++; }
+      setframe_ftsz(mb-1, delta*(ptrdiff_t)sizeof(TValue)+
+                   (hook_active(G(L)) ? FRAME_PCALLH : FRAME_PCALL));
+      L->base = mb;
+      goto vm_enter;
+    }
+    if (fop >= BC__MAX && id == FF_coroutine_yield) {
+      if (!cframe_canyield(L->cframe)) lj_err_caller(L, LJ_ERR_CYIELD);
+      L->cframe = NULL;
+      L->status = LUA_YIELD;
+      return LUA_YIELD;
+    }
+    if (fop >= BC__MAX) {
+      nres = vminterp_fast(L, fn);
+    } else {
+      setvmstate(G(L), C);
+      nres = fop == BC_FUNCCW ? G(L)->wrapf(L, fn->c.f) : fn->c.f(L);
+      setgcref(G(L)->cur_L, obj2gco(L));
+      setvmstate(G(L), INTERP);
+    }
+    if (nres == VM_TAILCALL) {
+      if (!tvisfunc(L->base-1)) {
+        lj_meta_call(L, L->base-1, L->top);
+        L->top++;
+      }
+      setframe_ftsz(L->base-1, frame_ftsz(&savedframe));
+      goto vm_enter;
+    }
+    if (nres < 0) return LUA_YIELD;  /* lua_yield() from a C function. */
+    result = savestack(L, L->top-nres);
+    goto vm_return;
+  }
