+#define VM_FASTDEF(name, ma, mb, mc, mt) \
+  static const BCIns *vminterp_op_##name(VM_FASTARGS) \
+  { \
+    int status = vminterp_fastop(vm, &pc, &base, &kbase, &fn, ins, BC_##name); \
+    if (status == VM_FAST_FALLBACK) { vm->L->base = base; return pc-1; } \
+    if (status == VM_FAST_DISPATCH) { vm->L->base = base; return pc; } \
+    if (status == VM_FAST_YIELD || status == VM_FAST_RETURN) { \
+      vm->status = status == VM_FAST_RETURN ? LUA_OK : LUA_YIELD; \
+      return NULL; \
+    } \
+    ins = *pc++; \
+    if (bc_op(ins) >= BC__MAX) { vm->L->base = base; return pc-1; } \
+    __attribute__((musttail)) \
+    return vminterp_dispatchers[bc_op(ins)](vm, pc, base, kbase, fn, ins); \
+  }
