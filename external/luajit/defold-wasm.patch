diff --git a/tests/wasm/api.c b/tests/wasm/api.c
new file mode 100644
--- /dev/null
+++ b/tests/wasm/api.c
@@ -0,0 +1,261 @@
+/* Exercise C entry points, protected calls and coroutine suspension. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+#include "luajit.h"
+
+static int fail(lua_State *L)
+{
+  return luaL_error(L, "C error");
+}
+
+static int handler(lua_State *L)
+{
+  assert(strstr(lua_tostring(L, 1), "C error"));
+  lua_pushliteral(L, "handled");
+  return 1;
+}
+
+static int many(lua_State *L)
+{
+  int i;
+  assert(lua_checkstack(L, 1000));
+  for (i = 0; i < 1000; i++) lua_pushinteger(L, i);
+  return 1000;
+}
+
+static int suspend(lua_State *L)
+{
+  assert(lua_isyieldable(L));
+  lua_pushinteger(L, 42);
+  return lua_yield(L, 1);
+}
+
+static int nested_call(lua_State *L)
+{
+  lua_pushvalue(L, 1);
+  lua_call(L, 0, 1);
+  return 1;
+}
+
+static int no_results(lua_State *L)
+{
+  (void)L;
+  return 0;
+}
+
+static int echo(lua_State *L)
+{
+  return lua_gettop(L);
+}
+
+static int closure_value(lua_State *L)
+{
+  lua_pushvalue(L, lua_upvalueindex(1));
+  return 1;
+}
+
+static int grow_stack(lua_State *L)
+{
+  assert(lua_checkstack(L, 4096));
+  lua_gc(L, LUA_GCCOLLECT, 0);
+  lua_pushvalue(L, 1);
+  return 1;
+}
+
+static int protected_call(lua_State *L)
+{
+  assert(lua_touserdata(L, 1) == (void *)L);
+  lua_pushcfunction(L, fail);
+  lua_call(L, 0, 0);
+  return 0;
+}
+
+static int hook_yields;
+static int wrapped_calls;
+static int hook_events;
+static lua_State *hook_target;
+
+static int wrap_call(lua_State *L, lua_CFunction f)
+{
+  wrapped_calls++;
+  return f(L);
+}
+
+static void yielding_hook(lua_State *L, lua_Debug *ar)
+{
+  assert(ar->event == LUA_HOOKCOUNT);
+  if (hook_target && L != hook_target) return;
+  if (hook_yields++ < 3) lua_yield(L, 0);
+}
+
+static void counting_hook(lua_State *L, lua_Debug *ar)
+{
+  (void)L;
+  (void)ar;
+  hook_events++;
+}
+
+static int enable_hook(lua_State *L)
+{
+  lua_sethook(L, counting_hook, LUA_MASKCALL|LUA_MASKRET|LUA_MASKLINE, 0);
+  return 0;
+}
+
+static int run(lua_State *L, const char *s)
+{
+  int status = luaL_dostring(L, s);
+  if (status) fprintf(stderr, "%s\n", lua_tostring(L, -1));
+  return status;
+}
+
+/* Exercise fixed-argument entry and zero/one-result returns into both kinds
+** of C frames, including missing arguments, discarded results and fallback
+** to vararg entry or result padding in the full interpreter.
+*/
+static void call_results(lua_State *L)
+{
+  static const char *sources[] = {
+    "return function(a,b) end",
+    "return function(a,b) return a end",
+    "return function(a,b) return b end",
+    "return function(...) return ... end"
+  };
+  int f, protected, nargs, want, i;
+  for (f = 0; f < 4; f++) {
+    assert(luaL_loadstring(L, sources[f]) == 0);
+    lua_call(L, 0, 1);
+    for (protected = 0; protected < 2; protected++) {
+      for (nargs = 0; nargs <= 3; nargs++) {
+        for (want = LUA_MULTRET; want <= 3; want++) {
+          int nres = f == 0 ? 0 : f == 3 ? nargs : 1;
+          int got = want == LUA_MULTRET ? nres : want;
+          lua_pushvalue(L, 1);
+          for (i = 0; i < nargs; i++) lua_pushinteger(L, 7+i);
+          if (protected) assert(lua_pcall(L, nargs, want, 0) == 0);
+          else lua_call(L, nargs, want);
+          assert(lua_gettop(L) == 1+got);
+          for (i = 0; i < got; i++) {
+            int arg = f == 2 ? 1 : f == 3 ? i : 0;
+            if (i >= nres || arg >= nargs) assert(lua_isnil(L, 2+i));
+            else assert(lua_tointeger(L, 2+i) == 7+arg);
+          }
+          lua_settop(L, 1);
+        }
+      }
+    }
+    lua_settop(L, 0);
+  }
+}
+
+int main(void)
+{
+  lua_State *L = luaL_newstate(), *co;
+  int i;
+  assert(L);
+  luaL_openlibs(L);
+  call_results(L);
+  lua_register(L, "c_no_results", no_results);
+  lua_register(L, "c_echo", echo);
+  lua_register(L, "c_grow", grow_stack);
+  lua_register(L, "c_enable_hook", enable_hook);
+  lua_register(L, "c_fail", fail);
+  lua_pushinteger(L, 73);
+  lua_pushcclosure(L, closure_value, 1);
+  lua_setglobal(L, "c_closure");
+  assert(run(L, "local c=c_closure; local value=c(); assert(value==73); "
+                "c_no_results(); local a,b=c_no_results(); assert(a==nil and b==nil); "
+                "a,b=c_echo(7,8,9); assert(a==7 and b==8); "
+                "a,b=c_echo(); assert(a==nil and b==nil); "
+                "local function args() return 7,8,9 end; "
+                "local t={c_echo(args())}; assert(#t==3 and t[3]==9); "
+                "local ok,e=pcall(function() c_fail() end); "
+                "assert(not ok and e:match('C error'))") == 0);
+  assert(run(L, "c_enable_hook(); local total=0; "
+                "for i=1,3 do total=total+i end; assert(total==6)") == 0);
+  assert(hook_events > 0);
+  lua_sethook(L, NULL, 0, 0);
+  lua_pushcfunction(L, handler);
+  lua_pushcfunction(L, fail);
+  assert(lua_pcall(L, 0, 1, 1) == LUA_ERRRUN);
+  assert(!strcmp(lua_tostring(L, -1), "handled"));
+  lua_settop(L, 0);
+  assert(lua_cpcall(L, protected_call, L) == LUA_ERRRUN);
+  assert(strstr(lua_tostring(L, -1), "C error"));
+  lua_settop(L, 0);
+
+  lua_pushcfunction(L, many);
+  lua_call(L, 0, 1200);
+  assert(lua_gettop(L) == 1200);
+  for (i = 0; i < 1000; i++) assert(lua_tointeger(L, i+1) == i);
+  for (; i < 1200; i++) assert(lua_isnil(L, i+1));
+  lua_settop(L, 0);
+  assert(run(L, "local keep={value=17}; local function f(x) "
+                "local value=c_grow(x); assert(keep.value==17); return value end; "
+                "local arg={value=42}; local value=f(arg); "
+                "assert(value==arg and value.value==42)") == 0);
+
+  lua_pushlightuserdata(L, (void *)wrap_call);
+  assert(luaJIT_setmode(L, -1, LUAJIT_MODE_WRAPCFUNC|LUAJIT_MODE_ON));
+  lua_pop(L, 1);
+  lua_pushcfunction(L, many);
+  lua_call(L, 0, 1);
+  assert(wrapped_calls == 1 && lua_tointeger(L, -1) == 0);
+  lua_pop(L, 1);
+  assert(run(L, "c_no_results(); local value=c_echo(42); assert(value==42)") == 0);
+  assert(wrapped_calls == 3);
+  assert(luaJIT_setmode(L, 0, LUAJIT_MODE_WRAPCFUNC|LUAJIT_MODE_OFF));
+
+  lua_register(L, "c_yield", suspend);
+  lua_register(L, "c_nested", nested_call);
+  lua_register(L, "c_many", many);
+  assert(run(L, "local t={c_many()}; assert(#t==1000 and t[1000]==999)") == 0);
+  co = lua_newthread(L);
+  assert(luaL_loadstring(co, "local x=c_yield(); return x+1") == 0);
+  assert(lua_resume(co, 0) == LUA_YIELD);
+  assert(lua_gettop(co) == 1 && lua_tointeger(co, 1) == 42);
+  lua_settop(co, 0);
+  lua_pushinteger(co, 99);
+  assert(lua_resume(co, 1) == 0);
+  assert(lua_gettop(co) == 1 && lua_tointeger(co, 1) == 100);
+  lua_settop(L, 0);
+
+  co = lua_newthread(L);
+  assert(luaL_loadstring(co, "local n=0; for i=1,10 do n=n+i end; return n") == 0);
+  lua_sethook(co, yielding_hook, LUA_MASKCOUNT, 1);
+  for (i = 0; i < 3; i++) {
+    assert(lua_resume(co, 0) == LUA_YIELD);
+    lua_settop(co, 0);
+  }
+  assert(lua_resume(co, 0) == 0);
+  assert(lua_gettop(co) == 1 && lua_tointeger(co, 1) == 55);
+  lua_settop(L, 0);
+
+  assert(run(L, "local co=coroutine.create(function() local x=c_yield(); return x+1 end); "
+                "local ok,x=coroutine.resume(co); assert(ok and x==42); "
+                "ok,x=coroutine.resume(co,99); assert(ok and x==100)") == 0);
+  hook_yields = 0;
+  co = lua_newthread(L);
+  assert(luaL_loadstring(co, "local n=0; for i=1,10 do n=n+i end; return n") == 0);
+  hook_target = co;
+  lua_sethook(co, yielding_hook, LUA_MASKCOUNT, 1);
+  lua_setglobal(L, "hooked_co");
+  assert(run(L, "for i=1,3 do assert(coroutine.resume(hooked_co)) end; "
+                "local ok,n=coroutine.resume(hooked_co); assert(ok and n==55)") == 0);
+  lua_sethook(L, NULL, 0, 0);
+  hook_target = NULL;
+
+  assert(run(L, "assert(c_nested(function() return 42 end)==42); "
+                "local ok,e=pcall(c_nested,function() error('nested error') end); "
+                "assert(not ok and e:match('nested error'))") == 0);
+  assert(run(L, "local function f(n) return f(n+1)+1 end; "
+                "local ok,e=pcall(f,0); assert(not ok and e:match('stack overflow')); "
+                "assert(pcall(function() return 42 end))") == 0);
+  lua_close(L);
+  puts("passed C API tests");
+  return 0;
+}
diff --git a/tests/wasm/benchmark.mjs b/tests/wasm/benchmark.mjs
new file mode 100644
--- /dev/null
+++ b/tests/wasm/benchmark.mjs
@@ -0,0 +1,193 @@
+// Compare Wasm interpreters, optionally alongside native macOS interpreters.
+import {execFileSync} from "node:child_process";
+import {cpSync, mkdirSync, readFileSync, writeFileSync, statSync} from "node:fs";
+import {dirname, join, resolve} from "node:path";
+import {fileURLToPath} from "node:url";
+import {arch, cpus, platform, release} from "node:os";
+import {createHash} from "node:crypto";
+
+const run = (program, args, options = {}) =>
+  execFileSync(program[0], [...program.slice(1), ...args], options);
+const sha256 = path => createHash("sha256").update(readFileSync(path)).digest("hex");
+const compilerVersion = compiler =>
+  execFileSync(compiler, ["--version"], {encoding:"utf8"}).split("\n")[0];
+const commit = path => {
+  try { return execFileSync("git", ["-C", path, "rev-parse", "HEAD"], {encoding:"utf8"}).trim(); }
+  catch { return null; }
+};
+const median = values => [...values].sort((a,b) => a-b)[Math.floor(values.length/2)];
+
+// Build the Wasm baseline and optional native interpreters out of tree.
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
+const compareNative = process.argv.includes("--native");
+const args = process.argv.slice(2).filter(arg => arg !== "--native");
+const lua = args[0];
+if (!lua) throw new Error("Usage: node tests/wasm/benchmark.mjs /path/to/lua-5.1.1 [output-directory] [--native]");
+if (compareNative && platform() !== "darwin") throw new Error("--native requires macOS");
+const baseline = resolve(lua);
+const output = resolve(args[1] || join(root, compareNative ? "build/interpreter-comparison" : "build/wasm-benchmark"));
+const header = readFileSync(join(baseline, "lua.h"), "utf8");
+if (!/^#define\s+LUA_RELEASE\s+"Lua 5\.1\.1"/m.test(header))
+  throw new Error("The baseline must be Lua 5.1.1");
+mkdirSync(output, {recursive:true});
+const emcc = process.env.EMCC || "emcc";
+const flags = ["-O2", "-fomit-frame-pointer", "-mtail-call", "-sSUPPORT_LONGJMP=wasm",
+  "-sENVIRONMENT=node", "-sNODERAWFS=1", "-sALLOW_MEMORY_GROWTH=1",
+  "-sSTACK_SIZE=1048576", "-sEXIT_RUNTIME=1"];
+const sources = ("lapi lcode ldebug ldo ldump lfunc lgc llex lmem lobject lopcodes " +
+  "lparser lstate lstring ltable ltm lundump lvm lzio lauxlib lbaselib ldblib " +
+  "liolib lmathlib loslib ltablib lstrlib loadlib linit lua").split(" ");
+const buildLua511 = (compiler, flags, target) =>
+  execFileSync(compiler, [...flags, ...sources.map(s => join(baseline, s+".c")),
+    "-lm", "-o", target], {stdio:"inherit"});
+const baselineJs = join(output, "lua-5.1.1.js");
+console.log("Building the Lua 5.1.1 baseline with Emscripten -O2");
+buildLua511(emcc, flags, baselineJs);
+
+const runner = join(root, "tests/wasm/benchmark_runner.lua");
+const workloads = join(root, "tests/wasm/benchmarks.lua");
+const samples = 7;
+const programs = {
+  lua511:[process.execPath, baselineJs],
+  luajit:[process.execPath, join(root, "src/luajit.js")]
+};
+let native;
+if (compareNative) {
+  const cc = process.env.CC || "cc";
+  const target = process.env.MACOSX_DEPLOYMENT_TARGET || "15.0";
+  const nativeFlags = ["-O2", "-fomit-frame-pointer"];
+  // Lua 5.1.1's LUA_USE_MACOSX selects the obsolete dyld module API.
+  const luaFlags = [...nativeFlags, "-mmacosx-version-min="+target, "-DLUA_USE_POSIX", "-DLUA_USE_DLOPEN"];
+  const nativeLua = join(output, "lua-5.1.1-macos");
+  console.log("Building native Lua 5.1.1 with Clang -O2");
+  buildLua511(cc, luaFlags, nativeLua);
+
+  const nativeRoot = join(output, "luajit-macos");
+  mkdirSync(nativeRoot, {recursive:true});
+  for (const directory of ["src", "dynasm"])
+    cpSync(join(root, directory), join(nativeRoot, directory), {recursive:true});
+  writeFileSync(join(nativeRoot, ".relver"), readFileSync(join(root, "src/luajit_relver.txt")));
+  const defines = ["-DLUAJIT_DISABLE_JIT", "-DLUAJIT_DISABLE_FFI", "-DLUAJIT_DISABLE_PROFILE"];
+  const nativeSrc = join(nativeRoot, "src");
+  const env = {...process.env, MACOSX_DEPLOYMENT_TARGET:target};
+  const makeFlags = ["-C", nativeSrc, "CC="+cc, "HOST_CC="+cc,
+    "BUILDMODE=static", "CCOPT="+nativeFlags.join(" "), "XCFLAGS="+defines.join(" ")];
+  console.log("Building native LuaJIT's assembly interpreter without JIT, FFI or profiling");
+  execFileSync("make", [...makeFlags, "clean"], {stdio:"inherit", env});
+  execFileSync("make", [...makeFlags, "-j8"], {stdio:"inherit", env});
+  const luajit = join(nativeSrc, "luajit");
+  const nativeArch = execFileSync(luajit, ["-e",
+    "assert(not jit.status()); assert(not pcall(jit.on)); assert(not pcall(require, 'ffi')); io.write(jit.arch)"],
+    {encoding:"utf8"});
+  programs.native_lua511 = [nativeLua];
+  programs.native_luajit = [luajit];
+  native = {
+    compiler:compilerVersion(cc),
+    deployment_target:target, arch:nativeArch,
+    lua511:{flags:luaFlags},
+    luajit:{flags:nativeFlags, defines, jit:false, ffi:false, profiling:false,
+      backend:"assembly", allocator:"default native LuaJIT allocator"}
+  };
+}
+
+// Compile each interpreter's bytecode, then measure isolated workloads.
+const data = {};
+for (const [name, program] of Object.entries(programs)) {
+  const bytecode = join(output, name+".bc");
+  run(program, [runner, "--compile", workloads, bytecode]);
+  data[name] = {};
+}
+const names = run(programs.lua511,
+  [runner, "--list", join(output, "lua511.bc")], {encoding:"utf8"}).trim().split("\n");
+if (!names.length || new Set(names).size !== names.length)
+  throw new Error("Benchmark names must be unique");
+const orders = [];
+for (let round = 0; round < samples; round++) {
+  const pairs = [["lua511", "luajit"]];
+  if (compareNative) pairs.push(["native_lua511", "native_luajit"]);
+  if (round%2) pairs.forEach(pair => pair.reverse());
+  if (round%4 === 1 || round%4 === 2) pairs.reverse();
+  const order = pairs.flat();
+  orders.push(order);
+  console.log(`Measuring round ${round+1}/${samples}: ${order.join(" then ")} (two warmups each)`);
+  for (const name of order) {
+    const records = data[name];
+    for (const workload of names) {
+      const raw = run(programs[name],
+        [runner, join(output, name+".bc"), "1", name.startsWith("native_") ? native.arch : "wasm32", workload],
+        {encoding:"utf8", maxBuffer:1024*1024});
+      const [actual, seconds, checksum] = raw.trim().split("\t");
+      if (actual !== workload || !Number.isFinite(Number(seconds)) || Number(seconds) <= 0)
+        throw new Error("Invalid benchmark output: "+name+"/"+workload);
+      if (!records[workload]) records[workload] = {seconds:[], checksum};
+      if (records[workload].checksum !== checksum) throw new Error("Unstable checksum: "+workload);
+      records[workload].seconds.push(Number(seconds));
+    }
+  }
+}
+
+// Validate all results before publishing timings or ratios.
+const rows = names.map(name => {
+  for (const engine of Object.keys(programs)) {
+    if (data.lua511[name].checksum !== data[engine][name]?.checksum)
+      throw new Error("Interpreter results differ: "+engine+"/"+name);
+    if (data[engine][name].seconds.length !== samples)
+      throw new Error("Missing benchmark samples: "+engine+"/"+name);
+  }
+  const baselineMs = median(data.lua511[name].seconds)*1000;
+  const luajitMs = median(data.luajit[name].seconds)*1000;
+  const row = {name, lua511_ms:baselineMs, luajit_ms:luajitMs,
+    speedup_over_lua511:baselineMs/luajitMs,
+    checksum:data.lua511[name].checksum};
+  if (compareNative) {
+    row.native_lua511_ms = median(data.native_lua511[name].seconds)*1000;
+    row.native_luajit_ms = median(data.native_luajit[name].seconds)*1000;
+    row.native_speedup_over_lua511 = row.native_lua511_ms/row.native_luajit_ms;
+    row.native_over_wasm_speedup = row.native_speedup_over_lua511/row.speedup_over_lua511;
+  }
+  return row;
+});
+
+// Save raw samples and provenance alongside the shareable tables.
+const result = {
+  timestamp:new Date().toISOString(), node:process.version,
+  emscripten:compilerVersion(emcc),
+  host:{platform:platform(), release:release(), arch:arch(), cpu:cpus()[0]?.model},
+  baseline:{path:baseline, release:"Lua 5.1.1", commit:commit(baseline)},
+  luajit:{path:root, commit:commit(root), working_tree:true, jit:false, ffi:false,
+    interpreter_sha256:sha256(join(root, "src/lj_vminterp.c")),
+    bytecode_reader_sha256:sha256(join(root, "src/lj_bcread.c")),
+    wasm_sha256:sha256(join(root, "src/luajit.wasm"))},
+  flags, native, programs, warmups:2, samples, orders, fresh_process_per_workload_per_round:true,
+  workloads_sha256:sha256(workloads),
+  runner_sha256:sha256(runner),
+  timing:"os.clock around workload only; parsing and process startup excluded; GC enabled; unrelated workload closures collected; two warmups per workload per round",
+  wasm_bytes:{lua511:statSync(join(output, "lua-5.1.1.wasm")).size,
+    luajit:statSync(join(root, "src/luajit.wasm")).size},
+  rows, raw:data
+};
+writeFileSync(join(output, "results.json"), JSON.stringify(result, null, 2)+"\n");
+const timingRow = (name, luaMs, luajitMs) => name.padEnd(24)+
+  luaMs.toFixed(2).padStart(9)+luajitMs.toFixed(2).padStart(10)+
+  (luaMs/luajitMs).toFixed(2).padStart(15)+"x";
+const lines = ["Wasm interpreter comparison: Lua 5.1.1 and the LuaJIT C backend",
+  "Median milliseconds. Speedup = Lua 5.1.1 time / LuaJIT time; > 1 means LuaJIT is faster.",
+  "Seven rounds with alternating interpreter order. Fresh process and two warmups per workload per round.",
+  "Node startup and bytecode loading are excluded. GC is enabled.", "",
+  "Workload                 Lua 5.1.1    LuaJIT    Speedup vs Lua"];
+for (const row of rows) lines.push(timingRow(row.name, row.lua511_ms, row.luajit_ms));
+if (compareNative) {
+  lines.push("", "Native macOS: the same Lua 5.1.1 and LuaJIT with JIT and FFI compiled out.",
+    "Workload                 Lua 5.1.1    LuaJIT    Speedup vs Lua",
+    ...rows.map(row => timingRow(row.name, row.native_lua511_ms, row.native_luajit_ms)),
+    "", "Ratio comparison. Gap = native speedup / Wasm speedup; larger gaps suggest more relative headroom.",
+    "Workload                 macOS speedup   Wasm speedup   Gap");
+  for (const row of rows) lines.push(row.name.padEnd(24)+
+    row.native_speedup_over_lua511.toFixed(2).padStart(12)+"x"+
+    row.speedup_over_lua511.toFixed(2).padStart(14)+"x"+
+    row.native_over_wasm_speedup.toFixed(2).padStart(9)+"x");
+}
+const report = lines.join("\n")+"\n";
+writeFileSync(join(output, "results.txt"), report);
+console.log(report);
+console.log("Full results: "+join(output, "results.json"));
diff --git a/tests/wasm/benchmark_runner.lua b/tests/wasm/benchmark_runner.lua
new file mode 100644
--- /dev/null
+++ b/tests/wasm/benchmark_runner.lua
@@ -0,0 +1,40 @@
+if arg[1] == "--compile" then
+  local f = assert(io.open(arg[3], "wb"))
+  assert(f:write(string.dump(assert(loadfile(arg[2])))))
+  assert(f:close())
+  return
+end
+
+if arg[1] == "--list" then
+  for _, workload in ipairs(assert(loadfile(arg[2]))()) do print(workload.name) end
+  return
+end
+
+if jit then assert(jit.arch == (arg[3] or "wasm32") and not jit.status()) end
+local function loadworkloads(path, selected)
+  local workloads = assert(loadfile(path))()
+  if not selected then return workloads end
+  for _, workload in ipairs(workloads) do
+    if workload.name == selected then return {workload} end
+  end
+  error("Unknown workload: "..selected)
+end
+-- The loader's temporary stack frame and all unrelated closures can be
+-- collected before warming up the selected workload.
+local workloads = loadworkloads(arg[1], arg[4])
+local samples = tonumber(arg[2]) or 7
+for _, workload in ipairs(workloads) do
+  local expected
+  for i = 1, 2 do
+    collectgarbage("collect")
+    expected = workload.run()
+  end
+  for i = 1, samples do
+    collectgarbage("collect")
+    local start = os.clock()
+    local result = workload.run()
+    local elapsed = os.clock()-start
+    assert(result == expected)
+    io.write(string.format("%s\t%.9f\t%.17g\n", workload.name, elapsed, result))
+  end
+end
diff --git a/tests/wasm/benchmarks.lua b/tests/wasm/benchmarks.lua
new file mode 100644
--- /dev/null
+++ b/tests/wasm/benchmarks.lua
@@ -0,0 +1,104 @@
+-- Common Lua 5.1 workloads. Each implementation compiles its own bytecode.
+local function add(a, b) return a+b end
+local function fib(n) if n < 2 then return n end; return fib(n-1)+fib(n-2) end
+local function tail(n, total)
+  if n == 0 then return total end
+  return tail(n-1, total+1)
+end
+
+return {
+  {name="numeric_for", run=function()
+    local sum = 0
+    for i = 1, 10000000 do sum = sum+i end
+    return sum
+  end},
+  {name="floating_for", run=function()
+    local sum = 0
+    for i = 0.5, 1000000, 0.5 do sum = sum+i end
+    return sum
+  end},
+  {name="branching_loop", run=function()
+    local sum = 0
+    for i = 1, 2000000 do
+      if i%3 == 0 then sum = sum+i
+      elseif i%3 == 1 then sum = sum-i
+      else sum = sum+1 end
+    end
+    return sum
+  end},
+  {name="arithmetic", run=function()
+    local x = 1
+    for i = 1, 2000000 do x = (x*1664525+1013904223)%4294967296 end
+    return x
+  end},
+  {name="lua_calls", run=function()
+    local sum = 0
+    for i = 1, 2000000 do sum = add(sum, i) end
+    return sum
+  end},
+  {name="recursive_fib", run=function() return fib(29) end},
+  {name="tail_calls", run=function() return tail(1000000, 0) end},
+  {name="table_access", run=function()
+    local t, sum = {}, 0
+    for i = 1, 1024 do t[i] = i end
+    for i = 1, 3000000 do sum = sum+t[i%1024+1] end
+    return sum
+  end},
+  {name="table_allocation", run=function()
+    local sum = 0
+    for i = 1, 100000 do
+      local t = {i, i+1, x=i%17}
+      sum = sum+t[1]+t[2]+t.x
+    end
+    return sum
+  end},
+  {name="string_library", run=function()
+    local sum = 0
+    for i = 1, 150000 do
+      local s = string.reverse(string.upper("abcd"..(i%1000)))
+      sum = sum+string.byte(s, 1)+#string.sub(s, 2, 5)
+    end
+    return sum
+  end},
+  {name="string_slices", run=function()
+    local text, sum = "abcdefghijklmnopqrstuvwxyz0123456789", 0
+    for i = 1, 200000 do
+      local first = i%16+1
+      sum = sum+#string.sub(text, first, first+7)+#string.sub(text, -first)
+    end
+    return sum
+  end},
+  {name="string_case", run=function()
+    local texts, sum = {"Hello, Lua!", "Mixed CASE 0123", "aBcDeFgHiJkLmNoP"}, 0
+    for i = 1, 150000 do
+      local upper = string.upper(texts[i%3+1])
+      local lower = string.lower(upper)
+      local reverse = string.reverse(lower)
+      sum = sum+#reverse+string.byte(reverse)
+    end
+    return sum
+  end},
+  {name="protected_calls", run=function()
+    local sum = 0
+    for i = 1, 100000 do
+      local ok, value = pcall(add, i, 1)
+      assert(ok)
+      sum = sum+value
+    end
+    return sum
+  end},
+  {name="coroutine_switch", run=function()
+    local co = coroutine.create(function()
+      for i = 1, 50000 do coroutine.yield(i) end
+      return 0
+    end)
+    local sum = 0
+    for i = 1, 50000 do
+      local ok, value = coroutine.resume(co)
+      assert(ok)
+      sum = sum+value
+    end
+    assert(coroutine.resume(co))
+    return sum
+  end}
+}
diff --git a/tests/wasm/callpath_api.c b/tests/wasm/callpath_api.c
new file mode 100644
--- /dev/null
+++ b/tests/wasm/callpath_api.c
@@ -0,0 +1,90 @@
+/* Check result counts across Lua callers, C callbacks, wrappers and hooks. */
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+#include "luajit.h"
+
+static int wrapped_calls, hook_events;
+
+static int values(lua_State *L)
+{
+  int i, n = (int)lua_tointeger(L, 1);
+  assert(lua_checkstack(L, 1024));
+  lua_gc(L, LUA_GCCOLLECT, 0);
+  for (i = 0; i < n; i++) {
+    if (i == 1) lua_pushnil(L);
+    else if (i == 2) lua_pushnumber(L, -0.0);
+    else lua_pushinteger(L, i+11);
+  }
+  return n;
+}
+
+static int wrap(lua_State *L, lua_CFunction function)
+{
+  wrapped_calls++;
+  return function(L);
+}
+
+static void hook(lua_State *L, lua_Debug *ar)
+{
+  (void)L;
+  (void)ar;
+  hook_events++;
+}
+
+int main(void)
+{
+  lua_State *L = luaL_newstate();
+  int wrapped, hooked, n, want;
+  assert(L);
+  luaL_openlibs(L);
+  for (wrapped = 0; wrapped <= 1; wrapped++) {
+    if (wrapped) {
+      lua_pushlightuserdata(L, (void *)wrap);
+      assert(luaJIT_setmode(L, -1, LUAJIT_MODE_WRAPCFUNC|LUAJIT_MODE_ON));
+      lua_pop(L, 1);
+    }
+    lua_register(L, "c_values", values);
+    assert(luaL_dostring(L, "function tail_values(n) return c_values(n) end")==0);
+    for (hooked = 0; hooked <= 1; hooked++) {
+      lua_sethook(L, hooked ? hook : NULL, LUA_MASKCOUNT, 1);
+      for (n = 0; n <= 8; n++) {
+        for (want = 0; want <= 8; want++) {
+          char code[512];
+          int i, used;
+          lua_settop(L, 0);
+          if (!want) {
+            snprintf(code, sizeof(code), "tail_values(%d);return 999", n);
+          } else {
+            used = snprintf(code, sizeof(code), "local ");
+            for (i = 0; i < want; i++)
+              used += snprintf(code+used, sizeof(code)-used, "%sx%d", i ? "," : "", i);
+            used += snprintf(code+used, sizeof(code)-used, "=tail_values(%d);return ", n);
+            for (i = 0; i < want; i++)
+              used += snprintf(code+used, sizeof(code)-used, "%sx%d", i ? "," : "", i);
+          }
+          assert(luaL_loadstring(L, code) == 0);
+          assert(lua_pcall(L, 0, LUA_MULTRET, 0) == 0);
+          assert(lua_gettop(L) == (want ? want : 1));
+          if (!want) assert(lua_tointeger(L, 1) == 999);
+          for (i = 0; i < want; i++) {
+            if (i >= n || i == 1) assert(lua_isnil(L, i+1));
+            else if (i == 2) assert(lua_tonumber(L, i+1) == 0 && signbit(lua_tonumber(L, i+1)));
+            else assert(lua_tointeger(L, i+1) == i+11);
+          }
+        }
+      }
+    }
+    lua_sethook(L, NULL, 0, 0);
+    if (wrapped) assert(luaJIT_setmode(L, 0, LUAJIT_MODE_WRAPCFUNC|LUAJIT_MODE_OFF));
+  }
+  assert(wrapped_calls > 0 && hook_events > 0);
+  lua_close(L);
+  puts("passed 324 C callback result-count cases");
+  return 0;
+}
diff --git a/tests/wasm/callpath_tests.lua b/tests/wasm/callpath_tests.lua
