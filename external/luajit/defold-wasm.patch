@@ -0,0 +1,146 @@
+local count=0
+local function pack(...) return {n=select('#',...),...} end
+local function paths(name,run)
+  local fast=pack(run())
+  local hooks=0
+  debug.sethook(function() hooks=hooks+1 end,'',1)
+  local slow=pack(run())
+  debug.sethook()
+  assert(hooks>0 and fast.n==slow.n,name)
+  for i=1,fast.n do
+    local a,b=fast[i],slow[i]
+    if type(a)=='number' and a~=a then assert(type(b)=='number' and b~=b,name)
+    else assert(a==b,name..' result '..i) end
+    if type(a)=='number' and a==0 then assert(1/a==1/b,name..' signed zero') end
+  end
+  count=count+1
+  print('ok '..count..' - '..name)
+end
+
+paths('all four open and closed upvalue writes',function()
+  local value
+  local function write(v) value=v;value='literal';value=1.25;value=false;value=v end
+  write(11)
+  local first=value
+  local function make()
+    local closed
+    return function(v) closed=v;closed='literal';closed=1.25;closed=nil;closed=v end,
+           function() return closed end
+  end
+  local set,get=make()
+  for i=1,100 do set({value=i});collectgarbage('step',1) end
+  collectgarbage('collect')
+  return first,get().value
+end)
+paths('global writes and environment metamethod fallback',function()
+  local env=setmetatable({value=1},{__index=_G,__newindex=function(t,k,v) rawset(t,k,v+10) end})
+  local run=setfenv(function() value=7;created=9;return value,created end,env)
+  return run()
+end)
+paths('fixed and expanded varargs, padding, nils and CALLM',function()
+  local function fixed(a,...) local x,y,z,w=...;return a,x,y,z,w end
+  local function relay(...) return ... end
+  local function prefix(x,...) return x,relay(...) end
+  local a=pack(fixed(1,2,nil,4))
+  local b=pack(prefix(7,nil,9,-0.0))
+  local empty=pack(relay())
+  local function many(...) return select('#',...),... end
+  local c=pack(many(prefix(7,nil,9)))
+  assert(a.n==5 and a[5]==nil and empty.n==0 and b.n==4 and c.n==4)
+  return a[1],a[2],a[3],a[4],a[5],b[1],b[2],b[3],b[4],c[1],c[2],c[3],c[4]
+end)
+paths('vararg tailcalls and deep argument stack growth',function()
+  local function tail(n,...) if n==0 then return ... end;return tail(n-1,...) end
+  local values={}
+  for i=1,1500 do values[i]=i end
+  local result=pack(tail(200,unpack(values)))
+  assert(result.n==1500 and result[1500]==1500)
+  return result.n,result[1],result[500],result[1500]
+end)
+paths('vararg protected calls and coroutine yields',function()
+  local function relay(...) return ... end
+  local co=coroutine.create(function(...)
+    local a,b,c=relay(...)
+    local x,y=coroutine.yield(a,b,c)
+    return relay(x,nil,y)
+  end)
+  local a=pack(coroutine.resume(co,7,nil,9))
+  local b=pack(coroutine.resume(co,11,13))
+  local ok,x,y,z=pcall(relay,17,nil,19)
+  return a.n,a[1],a[2],a[3],a[4],b.n,b[1],b[2],b[3],b[4],ok,x,y,z
+end)
+paths('bulk table initialization, zero results, nil holes and resizing',function()
+  local function empty() end
+  local function values() return 7,nil,9,-0.0 end
+  local a={empty()}
+  local b={1,2,values()}
+  local input={}
+  for i=1,1500 do input[i]=i end
+  local c={unpack(input)}
+  collectgarbage('collect')
+  assert(next(a)==nil and b[3]==7 and b[4]==nil and #c==1500)
+  return b[1],b[3],b[4],b[5],b[6],c[1],c[1500]
+end)
+paths('closure creation, closing and shared upvalue lifetime',function()
+  local functions={}
+  for i=1,80 do
+    local value=i
+    functions[i]=function() value=value+1;return value end
+  end
+  collectgarbage('collect')
+  local sum=0
+  for i=1,80 do sum=sum+functions[i]() end
+  return sum,functions[1](),functions[80]()
+end)
+paths('numeric power and coercion/metamethod fallbacks',function()
+  local function power(a,b) return a^b end
+  local object=setmetatable({},{__pow=function(_,b) return b+7 end})
+  return power(2,3),power(4,0.5),power(-0.0,3),power(-2,0.5),power(0,-1),power('2',3),power(object,5)
+end)
+paths('string concat, number coercion and yielding metamethod',function()
+  local a,b,c='a\0','b','c'
+  local joined=a..b..c
+  local co=coroutine.create(function()
+    local object=setmetatable({},{__concat=function(_,x) coroutine.yield('waiting');return 'value'..x end})
+    return object..'!'
+  end)
+  local ok,x=coroutine.resume(co)
+  local done,y=coroutine.resume(co)
+  return #joined,string.byte(joined,2),joined,4 .. 'x',ok,x,done,y
+end)
+paths('integer bit operations and signed shift/index boundaries',function()
+  local function bits(a,b) return ~a,a&b,a|b,a~b,a<<b,a>>b,a~>>b end
+  local a=pack(bits(-2147483648,31))
+  local b=pack(bits(-1,-1))
+  local c=pack(bits(37,32))
+  local d=pack(bits(7.5,2.25))
+  assert(not pcall(bits,{},2) and not pcall(bits,'7',2))
+  return a[1],a[2],a[3],a[4],a[5],a[6],a[7],b[1],b[2],b[3],b[4],b[5],b[6],b[7],c[5],c[6],c[7],d[1],d[2],d[7]
+end)
+paths('library type checks and raw array reads',function()
+  local t=setmetatable({7,8,9},{__index=function() error('unexpected index') end})
+  local total=0
+  table.foreachi(t,function(i,v) total=total+i+v end)
+  assert(not pcall(table.foreachi,7,function() end))
+  return total,table.getn(t),string.len('a\0b')
+end)
+do
+  local finalized,hooks=0,0
+  local proxy=newproxy(true)
+  getmetatable(proxy).__gc=function()
+    local function grow(n) if n==0 then return end;grow(n-1) end
+    grow(120)
+    finalized=finalized+1
+    debug.sethook(function() hooks=hooks+1 end,'',1)
+  end
+  proxy=nil
+  local functions={}
+  for i=1,500 do local x=i;functions[i]=function() return x end end
+  collectgarbage('collect')
+  for i=1,10 do assert(functions[i]()==i) end
+  debug.sethook()
+  assert(finalized==1 and hooks>0)
+  count=count+1
+  print('ok '..count..' - allocation finalizer stack growth and hook activation')
+end
+print('passed '..count..' bytecode regression groups')
diff --git a/tests/wasm/run.sh b/tests/wasm/run.sh
