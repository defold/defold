+local cases={
+  {'table LEN exits the shared loop',function()
+    local values={2,4,6}
+    local sum=0
+    for i=1,200 do
+      local size=#values
+      sum=sum+size
+      sum=sum+1
+    end
+    assert(sum==800)
+    return sum
+  end},
+  {'short arithmetic next to return',function()
+    local function one(x) return x+1 end
+    local function two(x) local y=x+1;return y*2 end
+    local function chain(a,b,c,d) return a+b+c+d end
+    assert(one(4)==5 and two(4)==10)
+    assert(chain(1,2,3,4)==10 and chain('1',2,3,4)==10)
+    return one(9)+two(9)
+  end},
+  {'conditional jumps leave and reenter the loop',function()
+    local i,sum=0,0
+    while i<250 do
+      i=i+1
+      if i%2==0 then sum=sum+i;sum=sum+1
+      else sum=sum-i;sum=sum-1 end
+    end
+    assert(sum==125)
+    return sum
+  end},
+  {'numeric coercion and metamethods after lookahead',function()
+    local events=0
+    local object=setmetatable({}, {__add=function(left,right)
+      events=events+1
+      return right+4
+    end})
+    local function sequence(value)
+      local a=value+2
+      local b=a*3
+      return b-1
+    end
+    assert(sequence('4')==17 and sequence(object)==17 and events==1)
+    return sequence('6')
+  end},
+  {'numeric loop body includes a cold call',function()
+    local function identity(value) return value end
+    local sum=0
+    for i=1,150 do
+      sum=sum+i
+      sum=identity(sum)
+      sum=sum+1
+    end
+    assert(sum==11475)
+    return sum
+  end},
+  {'table misses and custom iterators retain the full path',function()
+    local stored=0
+    local values=setmetatable({}, {__newindex=function(t,key,value)
+      stored=stored+1
+      rawset(t,key,value)
+    end})
+    for i=1,25 do values[i]=i end
+    local function iterator(state,key)
+      collectgarbage('step',1)
+      key=key+1
+      if key<=#state then return key,state[key] end
+    end
+    local sum=0
+    for key,value in iterator,values,0 do sum=sum+key+value end
+    assert(sum==650 and stored==25)
+    return sum
+  end},
+}
+for i,case in ipairs(cases) do
+  local expected=case[2]()
+  local hooks=0
+  debug.sethook(function() hooks=hooks+1 end,'',1)
+  local actual=case[2]()
+  debug.sethook()
+  assert(hooks>0 and actual==expected,case[1])
+  print('ok '..i..' - '..case[1])
+end
+print('passed '..#cases..' dispatch entry/exit regression groups')
