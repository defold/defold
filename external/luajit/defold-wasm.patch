+/* BASE/KBASE/GLREG stay local between bytecodes, like the fixed registers
+** in the assembler VMs. Publish PC before a helper can throw or call Lua,
+** and reload BASE after helpers which can resize the Lua stack.
+*/
+vm_reload:
+  base = L->base;
+vm_dispatch:
+  if (g->hookmask == 0) {
+    VMFastState vm;
+    vm.L = L; vm.cf = cf;
+    ins = *pc++;
+    if (bc_op(ins) < BC__MAX)
+      pc = vminterp_dispatchers[bc_op(ins)](&vm, pc, base, kbase, fn, ins);
+    else pc--;
+    if (pc == NULL) return vm.status;
+    fn = curr_func(L); pt = funcproto(fn);
+    base = L->base; kbase = mref(pt->k, cTValue);
+  }
+  ins = *pc++;
+  op = bc_op(ins);
+  if (LJ_UNLIKELY(g->hookmask & (LUA_MASKLINE|LUA_MASKCOUNT|LUA_MASKRET)) &&
+      !skiphook && !hook_active(g)) {
+    uint8_t mask = g->hookmask;
+    if ((mask & (LUA_MASKLINE|LUA_MASKCOUNT)) ||
+        ((mask & LUA_MASKRET) && bc_isret(op))) {
+      if (mask & (LUA_MASKLINE|LUA_MASKCOUNT)) g->hookcount--;
+      if ((mask & LUA_MASKLINE) || g->hookcount == 0 ||
+          ((mask & LUA_MASKRET) && bc_isret(op)))
+        lj_dispatch_ins(L, pc);
+      base = L->base;
+    }
+  }
+  skiphook = 0;
+  a = bc_a(ins); b = bc_b(ins); c = bc_c(ins); d = bc_d(ins);
+  switch (op) {
+  case BC_ISLT: case BC_ISGE: case BC_ISLE: case BC_ISGT: {
+    int cond;
+    if (tvisnumber(base+a) && tvisnumber(base+d)) {
+      double x = numberVnum(base+a), y = numberVnum(base+d);
+      cond = op <= BC_ISGE ? x < y : x <= y;
+      cond ^= op & 1;
+    } else {
+      setcframe_pc(cf, pc);
+      mb = lj_meta_comp(L, base+a, base+d, (int)op);
+      if ((uintptr_t)mb > 1) goto vm_mmcall;
+      cond = (int)(uintptr_t)mb;
+    }
+    if (!cond) pc++;
+    break;
+  }
+  case BC_ISEQV: case BC_ISNEV: case BC_ISEQS: case BC_ISNES:
+  case BC_ISEQN: case BC_ISNEN: case BC_ISEQP: case BC_ISNEP: {
+    TValue key;
+    cTValue *v = base+d;
+    int cond;
+    if (op == BC_ISEQS || op == BC_ISNES) {
+      setstrV(L, &key, gco2str(proto_kgc(pt, ~(ptrdiff_t)d))); v = &key;
+    } else if (op == BC_ISEQN || op == BC_ISNEN) {
+      v = VM_KNUM(d);
+    } else if (op == BC_ISEQP || op == BC_ISNEP) {
+      setpriV(&key, ~d); v = &key;
+    }
+    cond = vminterp_equal(base+a, v);
+    if (!cond && itype(base+a) == itype(v) &&
+        (tvistab(v) || tvisudata(v))) {
+      setcframe_pc(cf, pc);
+      mb = lj_meta_equal(L, gcV(base+a), gcV(v), op & 1);
+      if ((uintptr_t)mb > 1) goto vm_mmcall;
+      cond = (int)(uintptr_t)mb;
+    } else cond ^= op & 1;
+    if (!cond) pc++;
+    break;
+  }
+  case BC_ISTC: case BC_ISFC: case BC_IST: case BC_ISF: {
+    int cond = tvistruecond(base+d);
+    if (op == BC_ISFC || op == BC_ISF) cond = !cond;
+    if (!cond) pc++;
+    else if (op == BC_ISTC || op == BC_ISFC) copyTV(L, base+a, base+d);
+    break;
+  }
+  case BC_ISTYPE: case BC_ISNUM:
+    if (op == BC_ISNUM ? !tvisnumber(base+a) : itype(base+a) != ~(d-1)) {
+      setcframe_pc(cf, pc);
+      lj_meta_istype(L, a, d);
+      goto vm_reload;
+    }
+    break;
+  case BC_MOV: copyTV(L, base+a, base+d); break;
+  case BC_NOT: setboolV(base+a, !tvistruecond(base+d)); break;
+  case BC_UNM:
+    if (tvisint(base+d) && intV(base+d) != 0 && intV(base+d) != INT32_MIN)
+      setintV(base+a, -intV(base+d));
+    else if (tvisnumber(base+d)) setnumV(base+a, -numberVnum(base+d));
+    else {
+      setcframe_pc(cf, pc);
+      mb = lj_meta_arith(L, base+a, base+d, base+d, op);
+      if (mb) goto vm_mmcall;
+    }
+    break;
+  case BC_LEN:
+    if (tvisstr(base+d)) setintV(base+a, (int32_t)strV(base+d)->len);
+    else if (tvistab(base+d) &&
+             (!LJ_52 || tvisnil(lj_meta_lookup(L, base+d, MM_len))))
+      setintV(base+a, (int32_t)lj_tab_len(tabV(base+d)));
+    else {
+      setcframe_pc(cf, pc);
+      mb = lj_meta_len(L, base+d);
+      if (mb) goto vm_mmcall;
+    }
+    break;
+  case BC_ADDVN: VM_ARITH_K(+, __builtin_add_overflow, base+b, VM_KNUM(c), 0, VM_ARITH_SLOW);
+  case BC_ADDNV: VM_ARITH_K(+, __builtin_add_overflow, base+b, VM_KNUM(c), 1, VM_ARITH_SLOW);
+  case BC_ADDVV: VM_ARITH_DUAL(+, __builtin_add_overflow, base+b, base+c, VM_ARITH_SLOW);
+  case BC_SUBVN: VM_ARITH_K(-, __builtin_sub_overflow, base+b, VM_KNUM(c), 0, VM_ARITH_SLOW);
+  case BC_SUBNV: VM_ARITH_K(-, __builtin_sub_overflow, base+b, VM_KNUM(c), 1, VM_ARITH_SLOW);
+  case BC_SUBVV: VM_ARITH_DUAL(-, __builtin_sub_overflow, base+b, base+c, VM_ARITH_SLOW);
+  case BC_MULVN: VM_ARITH_K(*, __builtin_mul_overflow, base+b, VM_KNUM(c), 0, VM_ARITH_SLOW);
+  case BC_MULNV: VM_ARITH_K(*, __builtin_mul_overflow, base+b, VM_KNUM(c), 1, VM_ARITH_SLOW);
+  case BC_MULVV: VM_ARITH_DUAL(*, __builtin_mul_overflow, base+b, base+c, VM_ARITH_SLOW);
+  case BC_DIVVN: VM_ARITH_KFP(x/y, base+b, VM_KNUM(c), 0, VM_ARITH_SLOW);
+  case BC_DIVNV: VM_ARITH_KFP(x/y, base+b, VM_KNUM(c), 1, VM_ARITH_SLOW);
+  case BC_DIVVV: VM_ARITH_FP(x/y, base+b, base+c, VM_ARITH_SLOW);
+  case BC_MODVN: VM_ARITH_KMOD(base+b, VM_KNUM(c), 0, VM_ARITH_SLOW);
+  case BC_MODNV: VM_ARITH_KMOD(base+b, VM_KNUM(c), 1, VM_ARITH_SLOW);
+  case BC_MODVV: VM_ARITH_MOD(base+b, base+c, VM_ARITH_SLOW);
+  case BC_POW: VM_ARITH_FP(pow(x, y), base+b, base+c, VM_ARITH_SLOW);
+  case BC_CAT:
+    setcframe_pc(cf, pc);
+    mb = lj_meta_cat(L, base+c, (int)(c-b));
+    if (mb) goto vm_mmcall;
+    copyTV(L, L->base+a, L->base+b);
+    goto vm_reload;
+  case BC_KSTR:
+    setstrV(L, base+a, gco2str(proto_kgc(pt, ~(ptrdiff_t)d)));
+    break;
+  case BC_KSHORT: setintV(base+a, (int16_t)d); break;
+  case BC_KNUM: copyTV(L, base+a, VM_KNUM(d)); break;
+  case BC_KPRI: setpriV(base+a, ~d); break;
+  case BC_KNIL:
+    do { setnilV(base+a); } while (a++ < d);
+    break;
+  case BC_UGET:
+    copyTV(L, base+a, uvval(gco2uv(gcref(fn->l.uvptr[d]))));
+    break;
+  case BC_USETV: case BC_USETS: case BC_USETN: case BC_USETP: {
+    GCupval *uv = gco2uv(gcref(fn->l.uvptr[a]));
+    TValue *v = uvval(uv);
+    if (op == BC_USETV) copyTV(L, v, base+d);
+    else if (op == BC_USETS) setstrV(L, v, gco2str(proto_kgc(pt, ~(ptrdiff_t)d)));
+    else if (op == BC_USETN) copyTV(L, v, VM_KNUM(d));
+    else setpriV(v, ~d);
+    if (uv->closed && isblack(obj2gco(uv)) && tviswhite(v))
+      lj_gc_barrieruv(G(L), v);
+    break;
+  }
+  case BC_UCLO:
+    lj_func_closeuv(L, base+a);
+    pc += bc_j(ins);
+    break;
+  case BC_FNEW: {
+    GCfunc *newfn;
+    setcframe_pc(cf, pc);
+    newfn = lj_func_newL_gc(L, gco2pt(proto_kgc(pt, ~(ptrdiff_t)d)), &fn->l);
+    setfuncV(L, L->base+a, newfn);
+    goto vm_reload;
+  }
+  case BC_TNEW: case BC_TDUP: {
+    GCtab *t;
+    setcframe_pc(cf, pc);
+    lj_gc_check(L);
+    if (op == BC_TNEW) {
+      uint32_t asize = d & 0x7ff;
+      t = lj_tab_new(L, asize == 0x7ff ? asize+2 : asize, d >> 11);
+    } else t = lj_tab_dup(L, gco2tab(proto_kgc(pt, ~(ptrdiff_t)d)));
+    settabV(L, L->base+a, t);
+    goto vm_reload;
+  }
+  case BC_GGET: case BC_TGETV: case BC_TGETS: case BC_TGETB: {
+    TValue env, key;
+    cTValue *o = base+b, *k = base+c;
+    cTValue *v;
+    if (op == BC_GGET) {
+      settabV(L, &env, tabref(fn->l.env)); o = &env;
+      setstrV(L, &key, gco2str(proto_kgc(pt, ~(ptrdiff_t)d)));
+      k = &key;
+    } else if (op == BC_TGETS) {
+      setstrV(L, &key, gco2str(proto_kgc(pt, ~(ptrdiff_t)c))); k = &key;
+    } else if (op == BC_TGETB) {
+      setintV(&key, c); k = &key;
+    }
+    if (tvistab(o)) {
+      GCtab *t = tabV(o);
+      v = NULL;
+      if (tvisint(k) && inarray(t, intV(k))) v = arrayslot(t, intV(k));
+      else if (tvisstr(k)) {
+        v = vminterp_getstr(t, strV(k));
+        if (v == NULL) v = niltv(L);
+      }
+      if (v && (!tvisnil(v) || vminterp_nomm(t, MM_index))) {
+        copyTV(L, base+a, v);
+        break;
+      }
+    }
+    setcframe_pc(cf, pc);
+    v = lj_meta_tget(L, o, k);
+    if (v) {
+      copyTV(L, L->base+a, v);
+    } else {
+      mb = L->top;
+      L->top = mb+2;
+      goto vm_mmcall_prepared;
+    }
+    goto vm_reload;
+  }
+  case BC_GSET: case BC_TSETV: case BC_TSETS: case BC_TSETB: {
+    TValue env, key;
+    cTValue *o = base+b, *k = base+c;
+    TValue *v;
+    if (op == BC_GSET) {
+      settabV(L, &env, tabref(fn->l.env)); o = &env;
+      setstrV(L, &key, gco2str(proto_kgc(pt, ~(ptrdiff_t)d))); k = &key;
+    } else if (op == BC_TSETS) {
+      setstrV(L, &key, gco2str(proto_kgc(pt, ~(ptrdiff_t)c))); k = &key;
+    } else if (op == BC_TSETB) {
+      setintV(&key, c); k = &key;
+    }
+    if (tvistab(o)) {
+      GCtab *t = tabV(o);
+      v = NULL;
+      if (tvisint(k) && inarray(t, intV(k))) v = arrayslot(t, intV(k));
+      else if (tvisstr(k)) {
+        v = (TValue *)vminterp_getstr(t, strV(k));
+        t->nomm = 0;
+        if (v == NULL && vminterp_nomm(t, MM_newindex)) {
+          setcframe_pc(cf, pc);
+          v = lj_tab_newkey(L, t, k);
+        }
+      }
+      if (v && (!tvisnil(v) || vminterp_nomm(t, MM_newindex))) {
+        lj_gc_anybarriert(L, t);
+        copyTV(L, v, L->base+a);
+        goto vm_reload;
+      }
+    }
+    setcframe_pc(cf, pc);
+    v = lj_meta_tset(L, o, k);
+    if (v) copyTV(L, v, L->base+a);
+    else {
+      mb = L->top;
+      copyTV(L, mb+2, L->base+a);
+      L->top = mb+3;
+      goto vm_mmcall_prepared;
+    }
+    goto vm_reload;
+  }
+  case BC_TGETR: {
+    cTValue *v = lj_tab_getint(tabV(base+b), intV(base+c));
+    if (v) copyTV(L, base+a, v);
+    else setnilV(base+a);
+    break;
+  }
+  case BC_TSETR: {
+    GCtab *t = tabV(base+b);
+    TValue *v;
+    setcframe_pc(cf, pc);
+    v = lj_tab_setint(L, t, intV(base+c));
+    lj_gc_anybarriert(L, t);
+    copyTV(L, v, L->base+a);
+    goto vm_reload;
+  }
+  case BC_TSETM: {
+    GCtab *t = tabV(base+a-1);
+    uint32_t start = VM_KNUM(d)->u32.lo;
+    uint32_t n = cframe_multres_n(cf)-1;
+    if (n) {
+      if (start+n > t->asize) {
+        setcframe_pc(cf, pc);
+        lj_tab_reasize(L, t, start+n);
+      }
+      lj_gc_anybarriert(L, t);
+      memcpy(arrayslot(t, start), L->base+a, n*sizeof(TValue));
+    }
+    L->top = L->base+pt->framesize;
+    goto vm_reload;
+  }
+  case BC_CALLM: case BC_CALL:
+    mb = base+a+1;
+    L->top = mb+c-1+(op == BC_CALLM ?
+             cframe_multres_n(cf) : 0);
+    goto vm_call;
+  case BC_ITERC: case BC_ITERN:
+    copyTV(L, base+a, base+a-3);
+    copyTV(L, base+a+1, base+a-2);
+    copyTV(L, base+a+2, base+a-1);
+    mb = base+a+1;
+    L->top = mb+2;
+    goto vm_call;
+  case BC_CALLMT: case BC_CALLT: {
+    ptrdiff_t ret = frame_ftsz(base-1);
+    int nargs = (int)d-1+(op == BC_CALLMT ?
+                (int)cframe_multres_n(cf) : 0);
+    TValue callable;
+    copyTV(L, &callable, base+a);
+    L->top = base+a+1+nargs;
+    if (!tvisfunc(&callable)) {
+      setcframe_pc(cf, pc);
+      lj_meta_call(L, base+a, L->top);
+      nargs++;
+      copyTV(L, &callable, base+a);
+    }
+    if (frame_isvarg(base-1)) {
+      L->base = frame_prevd(base-1)+1;
+      ret = frame_ftsz(L->base-1);
+    }
+    memmove(L->base, base+a+1, (size_t)nargs*sizeof(TValue));
+    copyTV(L, L->base-1, &callable);
+    setframe_ftsz(L->base-1, ret);
+    L->top = L->base+nargs;
+    goto vm_enter;
+  }
+  case BC_VARG: {
+    ptrdiff_t delta = frame_sized(base-1)/(ptrdiff_t)sizeof(TValue);
+    ptrdiff_t first = c-delta;
+    int n = (int)(-1-first), i;
+    if (n < 0) n = 0;
+    if (b == 0) {
+      setcframe_pc(cf, pc);
+      lj_state_checkstack(L, (MSize)n);
+      base = L->base;
+      cframe_multres(cf) = (uint32_t)n+1;
+    } else n = (int)b-1;
+    for (i = 0; i < n; i++) {
+      if (first+i < -1) copyTV(L, base+a+i, base+first+i);
+      else setnilV(base+a+i);
+    }
+    if (b == 0 && base+a+n > L->top) L->top = base+a+n;
+    break;
+  }
+  case BC_ISNEXT: case BC_JMP:
+    pc += bc_j(ins);
+    break;
+  case BC_RETM: case BC_RET: case BC_RET0: case BC_RET1:
+    nres = (int)d-1;
+    if (op == BC_RETM) nres += (int)cframe_multres_n(cf);
+    result = savestack(L, base+a);
+    goto vm_return;
+  case BC_FORI: case BC_FORL: case BC_IFORL: {
+    int cond;
+    if (op == BC_FORI &&
+        !((tvisint(base+a) && tvisint(base+a+1) && tvisint(base+a+2)) ||
+          (tvisnum(base+a) && tvisnum(base+a+1) && tvisnum(base+a+2)))) {
+      setcframe_pc(cf, pc);
+      lj_meta_for(L, base+a);
+    }
+    if (tvisint(base+a)) {
+      int32_t idx = intV(base+a), stop = intV(base+a+1), step = intV(base+a+2);
+      if (op != BC_FORI && __builtin_add_overflow(idx, step, &idx)) break;
+      cond = step >= 0 ? idx <= stop : idx >= stop;
+      setintV(base+a, idx); setintV(base+a+3, idx);
+    } else {
+      double idx = numV(base+a), stop = numV(base+a+1), step = numV(base+a+2);
+      if (op != BC_FORI) idx += step;
+      setnumV(base+a, idx);
+      cond = signbit(step) ? idx >= stop : idx <= stop;
+      setnumV(base+a+3, idx);
+    }
+    if (op == BC_FORI ? !cond : cond) {
+      pc += bc_j(ins);
+      if (op != BC_FORI && bc_j(ins) == -2 && g->hookmask == 0 &&
+          vminterp_fuseloop(L, base, a, *pc, kbase)) pc += 2;
+    }
+    break;
+  }
+  case BC_ITERL: case BC_IITERL:
+    if (!tvisnil(base+a)) { copyTV(L, base+a-1, base+a); pc += bc_j(ins); }
+    break;
+  case BC_LOOP: case BC_ILOOP:
+    break;
+  case BC_BNOT:
+    if (tvisint(base+d)) setintV(base+a, ~intV(base+d));
+    else {
+      setcframe_pc(cf, pc);
+      lj_meta_bitop(L, base+a, base+d, base+d, op);
+    }
+    break;
+  case BC_BAND: VM_BIT(x & y);
+  case BC_BOR: VM_BIT(x | y);
+  case BC_BXOR: VM_BIT(x ^ y);
+  case BC_BSHL: VM_BIT(x << (y & 31));
+  case BC_BSHR: VM_BIT(x >> (y & 31));
+  case BC_BSAR: VM_BIT((int32_t)x >> (y & 31));
+  default:
+    setcframe_pc(cf, pc);
+    lj_err_msg(L, LJ_ERR_BCBAD);
+    break;
+  }
+  goto vm_dispatch;
+
+vm_mmcall:
+  L->top = mb+2;
+vm_mmcall_prepared:
+  setframe_pc(mb-2, pc);
+  if (!tvisfunc(mb-1)) { lj_meta_call(L, mb-1, L->top); L->top++; }
+  setframe_ftsz(mb-1, (char *)mb-(char *)L->base+FRAME_CONT);
+  L->base = mb;
+  goto vm_enter;
+
+vm_call:
+  if (!tvisfunc(mb-1)) {
+    setcframe_pc(cf, pc);
+    lj_meta_call(L, mb-1, L->top); L->top++;
+  }
+  setframe_pc(mb-1, pc);
+  L->base = mb;
+  goto vm_enter;
+
+vm_return:
+  base = L->base;
+  while (frame_isvarg(base-1)) base = frame_prevd(base-1)+1;
+  L->base = base;
+  cframe_multres(cf) = (uint32_t)nres+1;
+  if (frame_islua(base-1)) {
+    TValue *dest = base-1;
+    int want;
+    pc = frame_pc(base-1);
+    want = (int)bc_b(pc[-1])-1;
+    L->base = frame_prevl(base-1)+1;
+    /* RET0/RET1 use direct moves in vm_arm{,64}.dasc. */
+    if (nres == 1) copyTV(L, dest, restorestack(L, result));
+    else if (nres > 1)
+      memmove(dest, restorestack(L, result), (size_t)nres*sizeof(TValue));
+    while (nres < want) setnilV(dest+nres++);
+    fn = curr_func(L);
+    pt = funcproto(fn);
+    kbase = mref(pt->k, cTValue);
+    L->top = L->base+pt->framesize;
+    if (want < 0 && dest+nres > L->top) L->top = dest+nres;
+    goto vm_reload;
+  } else if (frame_ispcall(base-1)) {
+    TValue *caller = frame_prevd(base-1)+1;
+    memmove(caller+1, restorestack(L, result), (size_t)nres*sizeof(TValue));
+    setboolV(caller, 1);
+    L->base = caller;
+    result = savestack(L, caller);
+    nres++;
+    goto vm_return;
+  } else if (frame_iscont(base-1)) {
+    ASMFunction cont = frame_contf(base-1);
+    TValue value;
+    ptrdiff_t cat = savestack(L, base-2);
+    uint32_t multres = (uint32_t)(base-3)->u64;
+    pc = frame_contpc(base-1);
+    if (nres) copyTV(L, &value, restorestack(L, result));
+    else setnilV(&value);
+    L->base = frame_prevd(base-1)+1;
+    L->top = curr_topL(L);
+    base = L->base;
+    fn = curr_func(L);
+    pt = funcproto(fn);
+    kbase = mref(pt->k, cTValue);
+    if (cont == lj_cont_ra) copyTV(L, base+bc_a(pc[-1]), &value);
+    else if (cont == lj_cont_condt || cont == lj_cont_condf) {
+      if (tvistruecond(&value) != (cont == lj_cont_condt)) pc++;
+    } else if (cont == lj_cont_cat) {
+      TValue *top = restorestack(L, cat);
+      int left = (int)(top-(base+bc_b(pc[-1])));
+      copyTV(L, top, &value);
+      if (left) {
+        setcframe_pc(cf, pc);
+        mb = lj_meta_cat(L, top, left);
+        if (mb) goto vm_mmcall;
+      }
+      copyTV(L, L->base+bc_a(pc[-1]), L->base+bc_b(pc[-1]));
+    } else if (cont == lj_cont_hook) {
+      cframe_multres(cf) = multres;
+      skiphook = 1;
+    } else lj_assertL(cont == lj_cont_nop, "unknown continuation");
+    goto vm_reload;
+  } else {
+    ptrdiff_t dest = savestack(L, base-1);
+    ptrdiff_t caller = savestack(L, frame_prevd(base-1)+1);
+    int want = cframe_nres(cf)-1;
+    L->top = restorestack(L, dest)+nres;
+    if (want > nres) lj_state_checkstack(L, (MSize)(want-nres));
+    base = restorestack(L, dest);
+    memmove(base, restorestack(L, result), (size_t)nres*sizeof(TValue));
+    while (nres < want) setnilV(base+nres++);
+    L->top = base+(want >= 0 ? want : nres);
+    L->base = restorestack(L, caller);
+    return LUA_OK;
+  }
+}
+
+#undef VM_ARITH_SLOW
+#undef VM_ARITH_DUAL
+#undef VM_ARITH_FP
+#undef VM_ARITH_MOD
+#undef VM_ARITH_K
+#undef VM_ARITH_KFP
+#undef VM_ARITH_KMOD
+#undef VM_BIT
+#undef VM_KNUM
+
+/* -- VM entry points and error unwinding --------------------------------- */
+
+/* Resume a yielded C/fast function directly into its Lua caller. Ordinary
+** coroutine loops stay in the small tail-call handlers between yields;
+** continuations and hooks still enter the full interpreter.
+*/
+static const BCIns *vminterp_resumefast(VMFastState *vm, TValue *result)
+{
+  lua_State *L = vm->L;
+  GCfunc *fn;
+  GCproto *pt;
+  TValue *dest = L->base-1;
+  const BCIns *pc = frame_pc(dest);
+  BCIns ins;
+  int nres = (int)(L->top-result), want = (int)bc_b(pc[-1])-1;
+  L->base = frame_prevl(dest)+1;
+  fn = curr_func(L); pt = funcproto(fn);
+  vminterp_fastresults(vm, pt, L->base, dest, result, nres, want);
+  ins = *pc++;
+  if (bc_op(ins) >= BC__MAX) return pc-1;
+  return vminterp_dispatchers[bc_op(ins)](vm, pc, L->base,
+                                    mref(pt->k, cTValue), fn, ins);
+}
+
+/* Fixed-argument C API calls can enter the small handlers directly. Keep the
+** surrounding C frame and error boundary for callbacks and protected Lua
+** calls; hooks, varargs and stack growth use the full interpreter entry.
+*/
+static int vminterp_enter(lua_State *L, void *cf)
+{
+  GCfunc *fn = curr_func(L);
+  if (G(L)->hookmask == 0 && isluafunc(fn)) {
+    GCproto *pt = funcproto(fn);
+    TValue *base = L->base;
+    if (!(pt->flags & PROTO_VARARG) &&
+        base+pt->framesize < tvref(L->maxstack)) {
+      VMFastState vm;
+      const BCIns *pc = proto_bc(pt)+1;
+      BCIns ins;
+      int i, nargs = (int)(L->top-base);
+      for (i = nargs; i < pt->numparams; i++) setnilV(base+i);
+      L->top = base+pt->framesize;
+      vm.L = L; vm.cf = cf;
+      ins = *pc++;
+      if (bc_op(ins) < BC__MAX)
+        pc = vminterp_dispatchers[bc_op(ins)](&vm, pc, base,
+                                         mref(pt->k, cTValue), fn, ins);
+      else pc--;
+      if (pc == NULL) return vm.status;
+      return vminterp_run(L, VM_ENTER, 0, 0, pc);
+    }
+  }
+  return vminterp_run(L, VM_ENTER, 0, 0, NULL);
+}
+
+static int vminterp_call(lua_State *L, TValue *base, int nres1, ptrdiff_t ef,
+                        int type, int resume, lua_CFunction func, void *ud,
+                        lua_CPFunction cp)
+{
+  VMInterpCFrame cf;
+  void *prev = L->cframe;
+  int status;
+  cf.errfunc = (int32_t)ef;
+  cf.nres = cp ? -(int32_t)savestack(L, L->top) : nres1;
+  cf.prev = prev;
+  cf.multres = 1;
+  setcframe_L(&cf, L);
+  setcframe_pc(&cf, (const BCIns *)L);
+  L->cframe = (void *)((intptr_t)&cf | (resume ? CFRAME_RESUME : 0));
+  setgcref(G(L)->cur_L, obj2gco(L));
+  setvmstate(G(L), INTERP);
+  status = setjmp(cf.errjmp);
+  if (status == VM_FFERR) {
+    status = vminterp_run(L, VM_RETURN_ERROR, 0, 0, NULL);
+  } else if (status == LUA_OK) {
+    if (cp) {
+      base = cp(L, func, ud);
+      if (base == NULL) goto done;
+    }
+    if (resume && L->status == LUA_YIELD) {
+      L->status = LUA_OK;
+      if (G(L)->hookmask == 0 && frame_islua(L->base-1)) {
+        VMFastState vm;
+        const BCIns *pc;
+        vm.L = L; vm.cf = &cf;
+        pc = vminterp_resumefast(&vm, base);
+        if (pc == NULL) { status = vm.status; goto done; }
+        status = vminterp_run(L, VM_ENTER, 0, 0, pc);
+      } else {
+        status = vminterp_run(L, VM_RETURN, savestack(L, base),
+                             (int)(L->top-base), NULL);
+      }
+    } else {
+      ptrdiff_t delta = (char *)base-(char *)L->base;
+      if (!tvisfunc(base-1)) { lj_meta_call(L, base-1, L->top); L->top++; }
+      setframe_ftsz(base-1, delta+type);
+      L->base = base;
+      status = vminterp_enter(L, &cf);
+    }
+  }
+done:
+  if (status == LUA_OK) L->cframe = prev;
+  setvmstate(G(L), C);
+  return status;
+}
+
+void lj_vm_call(lua_State *L, TValue *base, int nres1)
+{
+  (void)vminterp_call(L, base, nres1, -1, FRAME_C, 0, NULL, NULL, NULL);
+}
+
+int lj_vm_pcall(lua_State *L, TValue *base, int nres1, ptrdiff_t ef)
+{
+  return vminterp_call(L, base, nres1, ef, FRAME_CP, 0, NULL, NULL, NULL);
+}
+
+int lj_vm_cpcall(lua_State *L, lua_CFunction func, void *ud, lua_CPFunction cp)
+{
+  return vminterp_call(L, NULL, 0, 0, FRAME_CP, 0, func, ud, cp);
+}
+
+int lj_vm_resume(lua_State *L, TValue *base, int nres1, ptrdiff_t ef)
+{
+  return vminterp_call(L, base, nres1, ef, FRAME_CP, 1, NULL, NULL, NULL);
+}
+
+void LJ_FASTCALL lj_vm_unwind_c(void *cframe, int errcode)
+{
+  longjmp(((VMInterpCFrame *)cframe)->errjmp, errcode);
+}
+
+void LJ_FASTCALL lj_vm_unwind_ff(void *cframe)
+{
+  longjmp(((VMInterpCFrame *)cframe)->errjmp, VM_FFERR);
+}
