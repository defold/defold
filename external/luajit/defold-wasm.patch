+  case BC_RETM: case BC_RET: case BC_RET0: case BC_RET1: {
+    TValue *rbase = base, *dest, *caller;
+    int nres = op == BC_RET1 ? 1 : op == BC_RET0 ? 0 : (int)d-1;
+    if (op == BC_RETM) nres += (int)cframe_multres_n(vm->cf);
+    while (frame_isvarg(rbase-1)) rbase = frame_prevd(rbase-1)+1;
+    dest = rbase-1;
+    if (!frame_islua(dest) &&
+        (op == BC_RET || op == BC_RETM || rbase != base)) return 0;
+    if (frame_islua(dest)) {
+      pc = frame_pc(dest);
+      caller = frame_prevl(dest)+1;
+      *pfn = frame_func(caller-1); pt = funcproto(*pfn);
+      vminterp_fastresults(vm, pt, caller, dest, base+a, nres,
+                          (int)bc_b(pc[-1])-1);
+      base = caller;
+      kbase = mref(pt->k, cTValue);
+      break;
+    }
+    if (frame_isc(dest)) {
+      int want = cframe_nres(vm->cf)-1;
+      if (want < -1 || want > 1) return 0;
+      caller = frame_prevd(dest)+1;
+      if (want != 0) {
+        if (nres) copyTV(L, dest, base+a);
+        else if (want == 1) setnilV(dest);
+      }
+      cframe_multres(vm->cf) = (uint32_t)nres+1;
+      L->top = dest+(want >= 0 ? want : nres);
+      L->base = caller;
+      return VM_FAST_RETURN;
+    }
+    if (op == BC_RET0) return 0;
+    {
+      int want, i;
+      if (frame_typep(dest) != FRAME_PCALL) return 0;
+      dest = frame_prevd(dest);
+      if (!frame_islua(dest)) return 0;
+      pc = frame_pc(dest);
+      want = (int)bc_b(pc[-1])-1;
+      caller = frame_prevl(dest)+1;
+      setboolV(dest, 1);
+      copyTV(L, dest+1, base+a);
+      cframe_multres(vm->cf) = 3;
+      for (i = 2; i < want; i++) setnilV(dest+i);
+      base = caller;
+      *pfn = frame_func(base-1); pt = funcproto(*pfn);
+      L->top = base+pt->framesize;
+      if (want < 0 && dest+2 > L->top) L->top = dest+2;
+      kbase = mref(pt->k, cTValue);
+      break;
+    }
+  }
+  case BC_FORI: case BC_FORL: case BC_IFORL: {
+    int cond;
+    if (tvisint(base+a)) {
+      int32_t idx, stop, step;
+      if (op == BC_FORI && (!tvisint(base+a+1) || !tvisint(base+a+2))) return 0;
+      idx = intV(base+a); stop = intV(base+a+1); step = intV(base+a+2);
+      if (op != BC_FORI && __builtin_add_overflow(idx, step, &idx)) break;
+      cond = step >= 0 ? idx <= stop : idx >= stop;
+      setintV(base+a, idx); setintV(base+a+3, idx);
+    } else if (tvisnum(base+a)) {
+      double idx, stop, step;
+      if (op == BC_FORI && (!tvisnum(base+a+1) || !tvisnum(base+a+2))) return 0;
+      idx = numV(base+a); stop = numV(base+a+1); step = numV(base+a+2);
+      if (op != BC_FORI) idx += step;
+      cond = signbit(step) ? idx >= stop : idx <= stop;
+      setnumV(base+a, idx); setnumV(base+a+3, idx);
+    } else return 0;
+    if (op == BC_FORI ? !cond : cond) {
+      pc += bc_j(ins);
+      if (op != BC_FORI && tvisint(base+a)) {
+        if ((bc_j(ins) == -3 || bc_j(ins) == -4) &&
+            vminterp_fusemuladd(L, base, a, pc, kbase, (int)-bc_j(ins)-1))
+          pc -= bc_j(ins);
+        else if (bc_j(ins) == -2 && vminterp_fuseloop(L, base, a, *pc, kbase))
+          pc += 2;
+      }
+    }
+    break;
+  }
+  case BC_JMP: case BC_ISNEXT: pc += bc_j(ins); break;
+  case BC_LOOP: case BC_ILOOP: break;
+  default: return 0;
+  }
+  *ppc = pc; *pbase = base; *pkbase = kbase;
+  return status;
+}
