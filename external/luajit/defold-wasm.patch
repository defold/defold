+#if LJ_TARGET_WASM32
+/* Dumps trim trailing nil array slots from constructor templates. Recover
+** capacity from constant-index stores in the same straight-line block, so
+** TDUP does not need to grow the array again on every execution.
+*/
+static void bcread_ktab_capacity(LexState *ls, GCproto *pt)
+{
+  const BCIns *pc = proto_bc(pt)+1, *end = proto_bc(pt)+pt->sizebc;
+  for (; pc < end; pc++) {
+    if (bc_op(*pc) == BC_TDUP) {
+      const BCIns *p;
+      BCReg reg = bc_a(*pc);
+      GCobj *o;
+      GCtab *t;
+      MSize asize, top, nstore = 0;
+      if (bc_d(*pc) >= pt->sizekgc) continue;
+      o = proto_kgc(pt, ~(ptrdiff_t)bc_d(*pc));
+      if (o->gch.gct != ~LJ_TTAB) continue;
+      t = gco2tab(o);
+      top = asize = t->asize;
+      for (p = pc+1; p < end; p++) {
+        BCOp op = bc_op(*p);
+        if ((op == BC_TSETB || op == BC_TSETS) && bc_b(*p) == reg) {
+          if (op == BC_TSETB && bc_c(*p) >= top) {
+            top = bc_c(*p)+1;
+            nstore++;
+            /* Keep sparse keys in the hash part. */
+            if (top-t->asize <= 2*nstore+1) asize = top;
+          }
+        } else if (op < BC_MOV || op >= BC__MAX ||
+                   bcmode_a(op) != BCMdst || bc_a(*p) == reg) {
+          break;
+        }
+      }
+      if (asize > t->asize) lj_tab_reasize(ls->L, t, asize);
+    }
+  }
+}
+#endif
+
 /* Read a prototype. */
 GCproto *lj_bcread_proto(LexState *ls)
 {
@@ -387,6 +427,9 @@
     setmref(pt->uvinfo, NULL);
     setmref(pt->varinfo, NULL);
   }
+#if LJ_TARGET_WASM32
+  bcread_ktab_capacity(ls, pt);
+#endif
   return pt;
 }
 
