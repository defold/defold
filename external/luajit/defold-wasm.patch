+++ b/tests/wasm/run.sh
@@ -0,0 +1,59 @@
+#!/bin/sh
+set -eu
+
+WASM_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+WASM_NODE=${NODE:-node}
+WASM_EMCC=${EMCC:-emcc}
+WASM_TMP=$(mktemp -d "${TMPDIR:-/tmp}/luajit-wasm-test.XXXXXX")
+trap 'rm -rf "$WASM_TMP"' EXIT HUP INT TERM
+export LUA_PATH="$WASM_ROOT/src/?.lua;;"
+
+"$WASM_NODE" "$WASM_ROOT/src/luajit.js" "$WASM_ROOT/tests/wasm/interpreter.lua"
+for mode in -b -bg; do
+  "$WASM_NODE" "$WASM_ROOT/src/luajit.js" "$mode" \
+    "$WASM_ROOT/tests/wasm/interpreter.lua" "$WASM_TMP/interpreter.ljbc"
+  "$WASM_NODE" "$WASM_ROOT/src/luajit.js" "$WASM_TMP/interpreter.ljbc"
+done
+
+if test -n "${HOST_LUAJIT:-}"; then
+  "$HOST_LUAJIT" -bW "$WASM_ROOT/tests/wasm/interpreter.lua" "$WASM_TMP/host.ljbc"
+  "$WASM_NODE" "$WASM_ROOT/src/luajit.js" "$WASM_TMP/host.ljbc"
+  # GC64 dumps must be rejected, rather than executed with the wrong frames.
+  "$HOST_LUAJIT" -bX "$WASM_ROOT/tests/wasm/interpreter.lua" "$WASM_TMP/gc64.ljbc"
+  if "$WASM_NODE" "$WASM_ROOT/src/luajit.js" "$WASM_TMP/gc64.ljbc" >"$WASM_TMP/gc64.log" 2>&1; then
+    echo "GC64 bytecode was incorrectly accepted" >&2
+    exit 1
+  fi
