diff --git a/tests/wasm/tailcall_api.c b/tests/wasm/tailcall_api.c
new file mode 100644
--- /dev/null
+++ b/tests/wasm/tailcall_api.c
@@ -0,0 +1,68 @@
+/* Exercise C tailcall frames across callbacks, errors and coroutine resumes. */
+#include <assert.h>
+#include <stdio.h>
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+
+static int hook_events;
+static int echo(lua_State *L)
+{
+  int n = lua_gettop(L);
+  assert(lua_checkstack(L, 4096));
+  lua_gc(L, LUA_GCCOLLECT, 0);
+  return n;
+}
+static int fail(lua_State *L) { return luaL_error(L, "tail callback error"); }
+static int suspend(lua_State *L)
+{
+  lua_pushinteger(L, 41);
+  return lua_yield(L, 1);
+}
+static void hook(lua_State *L, lua_Debug *ar)
+{
+  (void)L; (void)ar;
+  hook_events++;
+}
+static int enable_hook(lua_State *L)
+{
+  lua_sethook(L, hook, LUA_MASKCOUNT, 1);
+  lua_pushinteger(L, 17);
+  return 1;
+}
+static void run(lua_State *L, const char *code)
+{
+  int status = luaL_dostring(L, code);
+  if (status) fprintf(stderr, "%s\n", lua_tostring(L, -1));
+  assert(status == 0);
+  assert(lua_gettop(L) == 0);
+}
+int main(void)
+{
+  lua_State *L = luaL_newstate();
+  assert(L);
+  luaL_openlibs(L);
+  lua_register(L, "c_echo", echo);
+  lua_register(L, "c_fail", fail);
+  lua_register(L, "c_suspend", suspend);
+  lua_register(L, "c_hook", enable_hook);
+  run(L, "local function t() return c_echo() end; local a,b=t(); assert(a==nil and b==nil)");
+  run(L, "local function args() return 11,nil,33 end; local function t(x) return c_echo(x,args()) end; "
+         "local a,b,c,d,e=t(7); assert(a==7 and b==11 and c==nil and d==33 and e==nil)");
+  run(L, "local function t(...) return c_echo(...) end; local a,b,c=t(8,nil,9); assert(a==8 and b==nil and c==9)");
+  run(L, "local function t() return c_fail() end; local ok,e=pcall(function() local x=t(); return x end); "
+         "assert(not ok and e:match('tail callback error'))");
+  run(L, "local function t() return c_suspend() end; "
+         "local co=coroutine.create(function() local x=t(); return x+1 end); "
+         "local ok,x=coroutine.resume(co); assert(ok and x==41); "
+         "ok,x=coroutine.resume(co,44); assert(ok and x==45 and coroutine.status(co)=='dead')");
+  run(L, "for i=1,20 do local x=assert(loadstring('return function(x) return c_echo(x) end'))()(73); assert(x==73) end");
+  run(L, "local function t() return c_hook() end; local x=t(); local sum=0; "
+         "for i=1,20 do sum=sum+i end; assert(x==17 and sum==210)");
+  assert(hook_events > 0);
+  lua_sethook(L, NULL, 0, 0);
+  run(L, "local function t(n) if n==0 then return c_echo(17) end; return t(n-1) end; local x=t(10000); assert(x==17)");
+  lua_close(L);
+  puts("passed 8 targeted C-tailcall callback/error/yield/GC/hook regressions");
+  return 0;
+}
