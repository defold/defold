+test("table constructor bytecode round trips", function()
+  local function construct(i)
+    return {
+      {i, i+1, x=i%17},
+      {i, 1, i+2, x=false},
+      {nil, i, nil, i+2, x=i},
+      {[0]=42, i, i+1, x=i},
+      {[1]=17, [2]=i, [4]=i+3, x="fixed"},
+      {i, {i, i+1, x=i}, i+2, x=true},
+      {[255]=i, x=false}
+    }
+  end
+  local function equal_tables(a, b)
+    for k, v in pairs(a) do
+      if type(v) == "table" then equal_tables(v, b[k])
+      else same(v, b[k]) end
+    end
+    for k in pairs(b) do assert(a[k] ~= nil) end
+  end
+  local loaded = assert(loadstring(string.dump(construct)))
+  local reloaded = assert(loadstring(string.dump(loaded)))
+  for i = 1, 1000 do
+    equal_tables(construct(i), loaded(i))
+    equal_tables(construct(i), reloaded(i))
+    if i%100 == 0 then collectgarbage() end
+  end
+  local function sparse()
+    local t = {}
+    for i = 1, 200 do t[i] = {[255]=i, x=i} end
+    return t
+  end
+  local function allocated(f)
+    collectgarbage()
+    collectgarbage("stop")
+    local before = collectgarbage("count")
+    local keep = f()
+    local size = collectgarbage("count")-before
+    collectgarbage("restart")
+    same(keep[200][255], 200)
+    return size
+  end
+  -- A sparse byte key must not reserve a 256-slot array per table.
+  local source_size = allocated(sparse)
+  local dumped_size = allocated(assert(loadstring(string.dump(sparse))))
+  assert(dumped_size < 2*source_size)
+end)
