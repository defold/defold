+  for i,v,x in callable,{5,6},0 do sum=sum+i+v+x end
+  return sum
+end)
+paths('next invalid-key errors preserve protected call',function()
+  local ok,err=pcall(function() for k,v in next,{},'missing' do error('unexpected entry') end end)
+  assert(not ok and tostring(err):find('invalid key'))
+  return ok,type(err)
+end)
+paths('iteration across yield and full collections',function()
+  local co=coroutine.create(function()
+    for i,v in ipairs({8,9,10}) do collectgarbage('collect');coroutine.yield(i,v) end
+    return 99,nil
+  end)
+  local sum=0
+  for n=1,3 do local ok,i,v=coroutine.resume(co);assert(ok);sum=sum+i+v end
+  local ok,last,missing=coroutine.resume(co);assert(ok)
+  return sum,last,missing
+end)
+
+paths('math integers, floats, infinities, signed zero and NaN',function()
+  local values={-2147483648,-3,-0.0,0,0.25,-0.25,2147483647,2147483648,math.huge,-math.huge,0/0}
+  local results={n=0}
+  local function add(value) results.n=results.n+1;results[results.n]=value end
+  for _,x in ipairs(values) do
+    add(math.abs(x));add(math.floor(x));add(math.ceil(x))
+    add(math.min(x,0,-0.0,4.5));add(math.max(x,0,-0.0,4.5))
+  end
+  return unpack(results,1,results.n)
+end)
+paths('math coercion, extra arguments, missing arguments and errors',function()
+  local a,b,c=math.abs('-2.5'),math.floor('2.5'),math.ceil('-2.5')
+  local lo,hi=math.min('2',3),math.max(2,'3')
+  assert(not pcall(math.min));assert(not pcall(math.floor))
+  assert(not pcall(math.max,1,{}));assert(not pcall(math.abs,{}))
+  return a,b,c,lo,hi,math.floor(4.5,{}),math.min(-0.0,0),math.max(0,-0.0)
+end)
+
+paths('fixed multiple returns with truncation, expansion and nil holes',function()
+  local function values(x) return x,nil,x+2,0/0,-0.0,'last' end
+  values(1)
+  local first=values(2)
+  local a,b,c,d,e,f,g,h=values(3)
+  return first,a,b,c,d,e,f,g,h
+end)
+paths('multiple returns through pcall, varargs, deep stacks and yields',function()
+  local function multiple(x) return x,nil,x+1 end
+  local function varargs(...) local a,b,c=multiple(...);return a,b,c end
+  local function deep(n) if n==0 then return varargs(7) end;local a,b,c=deep(n-1);return a,b,c end
+  local ok,a,b,c=pcall(deep,80);assert(ok)
+  local co=coroutine.create(function() coroutine.yield(multiple(9));return multiple(11) end)
+  local y,d,e,f=coroutine.resume(co);assert(y)
+  local z,g,h,i=coroutine.resume(co);assert(z)
+  return a,b,c,d,e,f,g,h,i
+end)
+print('passed '..count..' experiment regression tests')
