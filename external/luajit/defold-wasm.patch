+
+enum {
+  VM_FAST_FALLBACK, VM_FAST_NEXT, VM_FAST_DISPATCH,
+  VM_FAST_YIELD, VM_FAST_RETURN
+};
+
+#define VM_FAST_SLOW(rb, rc) return VM_FAST_FALLBACK
+
+static LJ_AINLINE int vminterp_fastop(VMFastState *vm, const BCIns **ppc,
+                                    TValue **pbase, cTValue **pkbase,
+                                    GCfunc **pfn, BCIns ins, BCOp op)
+{
+  lua_State *L = vm->L;
+  const BCIns *pc = *ppc;
+  TValue *base = *pbase;
+  cTValue *kbase = *pkbase;
+  GCfunc *fn = *pfn;
+  GCproto *pt = funcproto(fn);
+  BCReg a = bc_a(ins), b = bc_b(ins), c = bc_c(ins), d = bc_d(ins);
+  int status = VM_FAST_NEXT;
+  switch (op) {
+  case BC_MOV: copyTV(L, base+a, base+d); break;
+  case BC_NOT: setboolV(base+a, !tvistruecond(base+d)); break;
+  case BC_ISTYPE: case BC_ISNUM:
+    if (op == BC_ISNUM ? !tvisnumber(base+a) : itype(base+a) != ~(d-1))
+      return 0;  /* Coercion and argument errors retain the full path. */
+    break;
+  case BC_KSHORT: setintV(base+a, (int16_t)d); break;
+  case BC_KNUM: copyTV(L, base+a, VM_KNUM(d)); break;
+  case BC_KPRI: setpriV(base+a, ~d); break;
+  case BC_KSTR:
+    setstrV(L, base+a, gco2str(proto_kgc(pt, ~(ptrdiff_t)d)));
+    break;
+  case BC_KNIL:
+    do { setnilV(base+a); } while (a++ < d);
+    break;
+  case BC_UGET:
+    copyTV(L, base+a, uvval(gco2uv(gcref(fn->l.uvptr[d]))));
+    break;
+  case BC_USETV: case BC_USETS: case BC_USETN: case BC_USETP: {
+    GCupval *uv = gco2uv(gcref(fn->l.uvptr[a]));
+    TValue *v = uvval(uv);
+    if (op == BC_USETV) copyTV(L, v, base+d);
+    else if (op == BC_USETS) setstrV(L, v, gco2str(proto_kgc(pt, ~(ptrdiff_t)d)));
+    else if (op == BC_USETN) copyTV(L, v, VM_KNUM(d));
+    else setpriV(v, ~d);
+    if (uv->closed && isblack(obj2gco(uv)) && tviswhite(v))
+      lj_gc_barrieruv(G(L), v);
+    break;
+  }
+  case BC_UCLO:
+    L->base = base;
+    setcframe_pc(vm->cf, pc);
+    lj_func_closeuv(L, base+a);
+    pc += bc_j(ins);
+    break;
+  case BC_FNEW: {
+    GCfunc *newfn;
+    L->base = base;
+    setcframe_pc(vm->cf, pc);
+    newfn = lj_func_newL_gc(L, gco2pt(proto_kgc(pt, ~(ptrdiff_t)d)), &fn->l);
+    base = L->base;
+    setfuncV(L, base+a, newfn);
+    status = G(L)->hookmask ? VM_FAST_DISPATCH : VM_FAST_NEXT;
+    break;
+  }
+  case BC_UNM:
+    if (tvisint(base+d) && intV(base+d) != 0 && intV(base+d) != INT32_MIN)
+      setintV(base+a, -intV(base+d));
+    else if (tvisnumber(base+d)) setnumV(base+a, -numberVnum(base+d));
+    else return 0;
+    break;
+  case BC_LEN:
+    if (tvisstr(base+d)) setintV(base+a, (int32_t)strV(base+d)->len);
+    else if (tvistab(base+d) && !LJ_52)
+      setintV(base+a, (int32_t)lj_tab_len(tabV(base+d)));
+    else return 0;
+    break;
+  case BC_ADDVN: VM_ARITH_K(+, __builtin_add_overflow, base+b, VM_KNUM(c), 0, VM_FAST_SLOW);
+  case BC_ADDNV: VM_ARITH_K(+, __builtin_add_overflow, base+b, VM_KNUM(c), 1, VM_FAST_SLOW);
+  case BC_ADDVV: VM_ARITH_DUAL(+, __builtin_add_overflow, base+b, base+c, VM_FAST_SLOW);
+  case BC_SUBVN: VM_ARITH_K(-, __builtin_sub_overflow, base+b, VM_KNUM(c), 0, VM_FAST_SLOW);
+  case BC_SUBNV: VM_ARITH_K(-, __builtin_sub_overflow, base+b, VM_KNUM(c), 1, VM_FAST_SLOW);
+  case BC_SUBVV: VM_ARITH_DUAL(-, __builtin_sub_overflow, base+b, base+c, VM_FAST_SLOW);
