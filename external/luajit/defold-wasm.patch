+++ b/tests/wasm/opcode_api.c
@@ -0,0 +1,97 @@
+/* Exercise internal raw/type bytecodes and verify actual fast-path coverage. */
+#include <assert.h>
+#include <stdio.h>
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+#include "lj_obj.h"
+#include "lj_bc.h"
+
+#ifdef FAST_COVERAGE
+extern uint32_t lj_vm_fast_taken[BC__MAX];
+#endif
+
+static void run(lua_State *L, const char *code)
+{
+  int status = luaL_dostring(L, code);
+  if (status) fprintf(stderr, "%s\n", lua_tostring(L, -1));
+  assert(status == 0);
+  assert(lua_gettop(L) == 0);
+}
+
+static GCproto *function(lua_State *L, const char *code)
+{
+  int status = luaL_dostring(L, code);
+  if (status) fprintf(stderr, "%s\n", lua_tostring(L, -1));
+  assert(status == 0 && lua_isfunction(L, -1));
+  return funcproto(funcV(L->top-1));
+}
+
+static void checkfunction(lua_State *L, const char *name, BCOp op, BCReg type)
+{
+  GCproto *pt = function(L, "return function(x) local y=x;return y end");
+  BCIns *bc = (BCIns *)proto_bc(pt);
+  assert(pt->sizebc == 3 && bc_op(bc[1]) == BC_MOV);
+  bc[1] = BCINS_AD(op, 0, type);
+  bc[2] = BCINS_AD(BC_RET1, 0, 2);
+  lua_setglobal(L, name);
+}
+
+int main(int argc, char **argv)
+{
+  lua_State *L = luaL_newstate();
+  GCproto *pt;
+  BCIns *bc;
+  MSize i;
+  int reads = 0, writes = 0;
+  assert(L && (argc == 2 || argc == 3));
+  luaL_openlibs(L);
+  if (argc == 3) {
+    lua_pushstring(L, argv[2]);
+    lua_setglobal(L, "bench_counts");
+  }
+  pt = function(L, "return function(t,k,v) t[k]=v;return t[k] end");
+  bc = (BCIns *)proto_bc(pt);
+  for (i = 1; i < pt->sizebc; i++) {
+    if (bc_op(bc[i]) == BC_TGETV) { setbc_op(bc+i, BC_TGETR); reads++; }
+    if (bc_op(bc[i]) == BC_TSETV) { setbc_op(bc+i, BC_TSETR); writes++; }
+  }
+  assert(reads == 1 && writes == 1);
+  lua_setglobal(L, "raw_slot");
+  checkfunction(L, "check_string", BC_ISTYPE, ~LJ_TSTR+1);
+  checkfunction(L, "check_table", BC_ISTYPE, ~LJ_TTAB+1);
+  checkfunction(L, "check_integer", BC_ISTYPE, ~LJ_TNUMX+1);
+  checkfunction(L, "check_number", BC_ISNUM, ~LJ_TNUMX+2);
+  run(L, "for hooked=0,1 do "
+         "if hooked==1 then debug.sethook(function() end,'',1) end; "
+         "local t=setmetatable({}, {__index=function() error('index called') end,"
+         "__newindex=function() error('newindex called') end}); "
+         "for _,k in ipairs({0,-7,1,3,1024}) do "
+         "local v={key=k};assert(raw_slot(t,k,v)==v);collectgarbage('step',1);"
+         "assert(raw_slot(t,k,nil)==nil) end; "
+         "assert(check_string('value')=='value' and check_string(17)=='17');"
+         "assert(check_table(t)==t and not pcall(check_table,false));"
+         "assert(check_integer(17)==17 and check_integer('19')==19);"
+         "assert(check_number(17)==17 and check_number(1.25)==1.25 and check_number('2.5')==2.5);"
+         "assert(not pcall(check_string,{}) and not pcall(check_number,{}));"
+         "debug.sethook() end");
+  if (luaL_dofile(L, argv[1])) {
+    fprintf(stderr, "%s\n", lua_tostring(L, -1));
+    assert(0);
+  }
+#ifdef FAST_COVERAGE
+  {
+    BCOp expected[] = {BC_ISTYPE,BC_ISNUM,BC_POW,BC_CAT,
+      BC_USETV,BC_USETS,BC_USETN,BC_USETP,BC_UCLO,BC_FNEW,BC_GSET,
+      BC_TGETR,BC_TSETR,BC_TSETM,BC_VARG,BC_RETM,BC_RET,
+      BC_BNOT,BC_BAND,BC_BOR,BC_BXOR,BC_BSHL,BC_BSHR,BC_BSAR};
+    for (i = 0; i < sizeof(expected)/sizeof(expected[0]); i++) {
+      printf("fast opcode %d: %u\n", (int)expected[i], lj_vm_fast_taken[expected[i]]);
+      assert(lj_vm_fast_taken[expected[i]] > 0);
+    }
+  }
+#endif
+  lua_close(L);
+  puts("passed raw/type bytecodes, coercion/error fallback and hook parity");
+  return 0;
+}
