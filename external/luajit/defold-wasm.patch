+  return total,n,keys
+end)
+paths('ipairs holes and raw lookup',function()
+  local t=setmetatable({[1]=11,[3]=33},{__index=function() error('unexpected metamethod') end})
+  local total,n=0,0
+  for i,v in ipairs(t) do total=total+i+v;n=n+1 end
+  return total,n
+end)
+paths('ipairs converted control and signed index wrap',function()
+  local iter=select(1,ipairs({}))
+  local total=0
+  for i,v in iter,{3,4},'0' do total=total+i+v end
+  local t={[-2147483648]=91}
+  for i,v in iter,t,2147483647 do total=total+i+v end
+  return total
+end)
+paths('pairs mixed keys and deleting current entries',function()
+  local t={10,20,x=30,[false]=40,[2.5]=50};local sum,n=0,0
+  for k,v in pairs(t) do sum=sum+v;n=n+1;t[k]=nil;collectgarbage('step',1) end
