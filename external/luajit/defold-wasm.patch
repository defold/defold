diff --git a/tests/wasm/interpreter.lua b/tests/wasm/interpreter.lua
new file mode 100644
--- /dev/null
+++ b/tests/wasm/interpreter.lua
@@ -0,0 +1,849 @@
+-- Exercise the portable interpreter from source and precompiled bytecode.
+local tests = 0
+local function test(name, f)
+  f()
+  tests = tests + 1
+  print("ok " .. tests .. " - " .. name)
+end
+
+local function same(actual, expected)
+  assert(actual == expected, tostring(actual) .. " ~= " .. tostring(expected))
+end
+
+local function pack(...)
+  return {n = select("#", ...), ...}
+end
+
+local function values(expected, ...)
+  local actual = pack(...)
+  same(actual.n, expected.n or #expected)
+  for i = 1, actual.n do same(actual[i], expected[i]) end
+end
+
+-- Count hooks force the full interpreter to execute one bytecode at a time.
+-- Compare its results with the hook-free handlers, including NaN and -0.
+local function checkpaths(f, ...)
+  local args = pack(...)
+  local actual = pack(f(unpack(args, 1, args.n)))
+  local hooks = 0
+  debug.sethook(function() hooks=hooks+1 end, "", 1)
+  local expected = pack(f(unpack(args, 1, args.n)))
+  debug.sethook()
+  assert(hooks > 0)
+  same(actual.n, expected.n)
+  for i = 1, actual.n do
+    local a, b = actual[i], expected[i]
+    if a ~= a then assert(b ~= b) else same(a, b) end
+    if type(a) == "number" and a == 0 then same(1/a, 1/b) end
+  end
+end
+
+-- Configuration, arithmetic and control flow.
+
+test("interpreter configuration", function()
+  same(jit.arch, "wasm32")
+  same(jit.status(), false)
+  same(pcall(jit.on), false)
+  same(pcall(require, "ffi"), false)
+end)
+
+test("arithmetic and comparisons", function()
+  local x, y = 17, 5
+  values({22, 12, 85, 3.4, 2, 1419857}, x+y, x-y, x*y, x/y, x%y, x^y)
+  values({20, 14, 51, 17/3, 2}, x+3, x-3, x*3, x/3, x%3)
+  values({20, -14, 51, 3/17, 3}, 3+x, 3-x, 3*x, 3/x, 3%x)
+  same(-x, -17)
+  local zero = 0
+  same(1/(-zero), -math.huge)
+  same(-2147483648 - 1, -2147483649)
+  same(2147483647 + 1, 2147483648)
+  same(x * 2147483647, 36507221999)
+  same((-x) % y, 3)
+  same(x % (-y), -3)
+  local s = "12"
+  same(s + x, 29)
+  same(-s, -12)
+  assert(x > y and x >= y and y < x and y <= x and x ~= y)
+  assert(x == 17 and x ~= "17" and x ~= nil and x ~= false)
+  assert("a" < "b" and "b" <= "b" and "b" > "a" and "b" >= "b")
+  local nan = 0/0
+  assert(nan ~= nan and not (nan < x) and not (nan > x))
+  assert(not (nan <= x) and not (nan >= x))
+  same(not nil, true)
+  same(not false, true)
+  same(not 0, false)
+  same(false or 4, 4)
+  same(true and 5, 5)
+end)
+
+test("comparison branches and hook fallback", function()
+  local function order(a, b)
+    local score = 0
+    if a < b then score=score+1 end
+    if a <= b then score=score+2 end
+    if a > b then score=score+4 end
+    if a >= b then score=score+8 end
+    return score, a==b, a~=b
+  end
+  local numbers = {-2147483648, -1, 0, 1.5, 2147483647, 2147483648,
+                   -math.huge, math.huge, 0/0}
+  for _, a in ipairs(numbers) do
+    for _, b in ipairs(numbers) do checkpaths(order, a, b) end
+  end
+  checkpaths(order, "a", "b"); checkpaths(order, "same", "same")
+  local function truth(a, b)
+    local result = 0
+    if a then result=result+1 end
+    if not b then result=result+2 end
+    return result, a and b, a or b, a==b, a~=b,
+           a==nil, a~=false, a==17, a~="text"
+  end
+  local choices = {n=7, nil, false, true, 17, "text", {}, truth}
+  for i = 1, choices.n do
+    for j = 1, choices.n do checkpaths(truth, choices[i], choices[j]) end
+  end
+  local calls = 0
+  local mt = {
+    __eq=function(a, b) calls=calls+1; return a.value==b.value end,
+    __lt=function(a, b) calls=calls+1; return a.value<b.value end,
+    __le=function(a, b) calls=calls+1; return a.value<=b.value end
+  }
+  local a, b = setmetatable({value=1}, mt), setmetatable({value=2}, mt)
+  checkpaths(function()
+    calls=0
+    local score, equal, different = order(a, b)
+    return score, equal, different, calls
+  end)
+  local x, y = newproxy(true), newproxy(true)
+  -- Userdata equality also has to reach its metamethod exactly once.
+  local equal = function() calls=calls+1; return true end
+  getmetatable(x).__eq = equal; getmetatable(y).__eq = equal
