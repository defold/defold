+  local object=setmetatable({}, {__concat=function() error('concat marker') end})
+  for _,values in ipairs({{object,''},{'',object},{'','',object,''}}) do
+    local ok,message=pcall(concat,unpack(values))
+    assert(not ok and message:find('concat marker',1,true))
+    verify('after-error','','after-error','')
+  end
+end)
+check('large C argument vectors and mixed empty positions',function()
+  local values,expected={},{}
+  for i=1,180 do
+    values[i]=i%3==0 and tostring(i) or ''
+    expected[i]=values[i]
+  end
+  verify(table.concat(expected),unpack(values))
+end)
+check('metamethod reentry and stack growth',function()
+  local function grow(n) if n==0 then return 'deep' end;return grow(n-1)..'' end
+  local object=setmetatable({}, {__concat=function(left,right)
+    collectgarbage('collect')
+    return concat('',grow(160),'')
+  end})
+  verify('deep','',object,'')
+end)
