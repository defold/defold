+test("tail-call dispatch and helper transitions", function()
+  local function single(a, b, c) return b end
+  local function add(a, b) return a+b end
+  local function exercise()
+    local t, sum = {offset=3}, 0
+    for i = 1, 20000 do
+      t[1] = i
+      sum = add(sum, t[1]+t.offset)
+    end
+    -- Missing arguments must be cleared, including after reused frames.
+    local first = single(1, 7, 9)
+    local missing = single(1)
+    -- Exercise fixed results, discarded results and multiple results.
+    single(1, 2)
+    local x, y = single(1, 5)
+    return sum, first, missing, x, y
+  end
+  local actual = pack(exercise())
+  local counts = 0
+  debug.sethook(function() counts=counts+1 end, "", 13)
+  local expected = pack(exercise())
+  debug.sethook()
+  values(expected, unpack(actual, 1, actual.n))
+  same(actual[1], 200070000)
+  assert(counts > 0)
+  local function fail(n)
+    if n == 0 then error("dispatch error") end
+    return fail(n-1)+1
+  end
+  local ok, err = xpcall(function() return fail(40) end, debug.traceback)
+  same(ok, false)
+  assert(err:match("dispatch error") and err:match("stack traceback"))
+  same(add(20, 22), 42)
+  local function descend(n, root)
+    if n == 0 then
+      same(debug.getinfo(1, "f").func, descend)
+      same(debug.getinfo(2, "f").func, descend)
+      collectgarbage()
+      return root.value
+    end
+    return descend(n-1, root)+1
+  end
+  same(descend(300, {value=42}), 342)
+  local even, odd
+  even = function(n, value, missing)
+    same(missing, nil)
+    if n == 0 then return value end
+    return odd(n-1, value+1)
+  end
+  odd = function(n, value)
+    if n == 0 then return value end
+    return even(n-1, value+1)
+  end
+  same(even(10000, 0), 10000)
+end)
