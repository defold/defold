--- /dev/null
+++ b/tests/wasm/callpath_tests.lua
@@ -0,0 +1,98 @@
+local count = 0
+local function pack(...) return {n=select('#', ...), ...} end
+local function equal(a,b)
+  assert(a.n==b.n)
+  for i=1,a.n do
+    local x,y=a[i],b[i]
+    if type(x)=='number' and x~=x then assert(type(y)=='number' and y~=y)
+    else assert(x==y,tostring(x)..' ~= '..tostring(y)) end
+    if type(x)=='number' and x==0 then assert(1/x==1/y) end
+  end
+end
+local function paths(name,run)
+  local fast=pack(run())
+  local hooks=0
+  debug.sethook(function() hooks=hooks+1 end,'',1)
+  local slow=pack(run())
+  debug.sethook()
+  assert(hooks>0)
+  equal(fast,slow)
+  count=count+1
+  print('ok '..count..' - '..name)
+end
+
+paths('assert result truncation, overlap and padding',function()
+  local effects=0
+  local function bump() effects=effects+1;return effects end
+  assert(true,nil,-0.0,'discarded',bump())
+  local one=assert(true,nil,-0.0,'discarded')
+  local a,b=assert(true,nil,-0.0,'discarded')
+  local c,d,e=assert(true,nil,-0.0,'discarded')
+  local f,g,h,i,j,k=assert(true,nil,-0.0,'retained',false)
+  return effects,one,a,b,c,d,e,f,g,h,i,j,k
+end)
+paths('fixed and multiple results from builtins',function()
+  local a,b,c=string.byte('abcd',1,3)
+  local d,e=string.byte('abcd',1,4)
+  local f=string.byte('abcd',1,4)
+  string.byte('abcd',1,4)
+  local g,h,i=math.modf(-2.75)
+  local j,k,l,m=math.frexp(12)
+  return a,b,c,d,e,f,g,h,i,j,k,l,m,assert(true,nil,17)
+end)
+paths('multiple results used in argument and table expansion',function()
+  local function capture(...) return select('#',...),... end
+  local a,b,c,d=capture(assert(true,nil,17))
+  local t={string.byte('abcdef',2,5)}
+  return a,b,c,d,#t,t[1],t[4],capture(string.byte('xyz',1,3))
+end)
+paths('type builtin and missing-argument errors',function()
+  local a,b,c=type(nil)
+  local ok,err=pcall(type)
+  assert(not ok and type(err)=='string')
+  local failed,message=pcall(assert,false,'expected failure')
+  assert(not failed and tostring(message):find('expected failure'))
+  return a,b,c,type(false),type(0),type({}),type(function() end),ok,failed
+end)
+paths('string helper guards and coercion fallback',function()
+  local a,b,c=string.byte('abcdef',-2)
+  local d,e=string.byte('',1)
+  local f,g=string.sub('abcdef',2,-2)
+  local h=string.sub('abcdef','2','4')
+  local i=string.reverse(12345)
+  local j,k=string.lower('AbC'),string.upper('dEf')
+  assert(not pcall(string.sub,'abc',{}))
+  assert(not pcall(string.byte))
+  return a,b,c,d,e,f,g,h,i,j,k
+end)
+paths('allocating helpers mixed with collection and stack growth',function()
+  local sum=0
+  local function recurse(n,s)
+    if n==0 then return string.reverse(s),string.upper(s),string.sub(s,2,-2) end
+    local a,b,c=recurse(n-1,s)
+    return a,b,c
+  end
+  for i=1,25 do
+    local s='abc'..i..'DEF'
+    local a,b,c=recurse(45,s)
+    sum=sum+#a+#b+#c
+    collectgarbage('collect')
+  end
+  return sum
+end)
+paths('protected Lua calls and coroutine result counts',function()
+  local function values() return true,nil,-0.0,'last' end
+  local a,b,c=pcall(values)
+  local d,e,f,g,h,i=xpcall(values,function(err) return err end)
+  local co=coroutine.create(function()
+    coroutine.yield(values())
+    return values()
+  end)
+  local j,k,l=coroutine.resume(co)
+  local m,n,o,p,q,r=coroutine.resume(co)
+  local wrapped=coroutine.wrap(function() coroutine.yield(2,nil,4);return 5,nil,7 end)
+  local s,t,u=wrapped()
+  local v,w,x,y=wrapped()
+  return a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y
+end)
+print('passed '..count..' call-path regression tests')
diff --git a/tests/wasm/concat_api.c b/tests/wasm/concat_api.c
new file mode 100644
--- /dev/null
+++ b/tests/wasm/concat_api.c
@@ -0,0 +1,34 @@
+#include <assert.h>
+#include <stdio.h>
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+#include "lj_obj.h"
+
+static int c_concat(lua_State *L)
+{
+  lua_concat(L, lua_gettop(L));
+  assert(lua_gettop(L) == 1);
+  return 1;
+}
+
+static int c_concat_gc(lua_State *L)
+{
+  G(L)->gc.threshold = 0;
+  return c_concat(L);
+}
+
+int main(int argc, char **argv)
+{
+  lua_State *L = luaL_newstate();
+  int status;
+  assert(L && argc == 2);
+  luaL_openlibs(L);
+  lua_register(L, "c_concat", c_concat);
+  lua_register(L, "c_concat_gc", c_concat_gc);
+  status = luaL_dofile(L, argv[1]);
+  if (status) fprintf(stderr, "%s\n", lua_tostring(L, -1));
+  assert(status == 0 && lua_gettop(L) == 0);
+  lua_close(L);
+  return 0;
+}
diff --git a/tests/wasm/concat_tests.lua b/tests/wasm/concat_tests.lua
new file mode 100644
--- /dev/null
+++ b/tests/wasm/concat_tests.lua
@@ -0,0 +1,145 @@
+local groups=0
+local function check(name,run)
+  run()
+  local hooks=0
+  debug.sethook(function() hooks=hooks+1 end,'',1)
+  run()
+  debug.sethook()
+  assert(hooks>0,name)
+  groups=groups+1
+  print('ok '..groups..' - '..name)
+end
+local concat=assert(c_concat,'C concat callback required')
+local function pack(...) return {n=select('#',...),...} end
+local function verify(expected,...)
+  local values=pack(...)
+  local actual=concat(unpack(values,1,values.n))
+  assert(actual==expected,'concat content mismatch')
+  if type(expected)=='string' then assert(type(actual)=='string') end
+end
+
+check('zero/one C API arguments and object identity',function()
+  verify('')
+  verify('one','one')
+  verify(7,7)
+  local object={}
+  verify(object,object)
+end)
+check('both empty-string directions and all-empty chains',function()
+  local empty,text='','contents'
+  assert(empty..text==text and text..empty==text and empty..empty=='')
+  verify(text,empty,text)
+  verify(text,text,empty)
+  verify('',empty,empty,empty,empty)
+  verify(text,empty,empty,text,empty,empty)
+  assert(empty..empty..text..empty..empty==text)
+end)
+check('embedded NUL and long rooted strings',function()
+  for _,text in ipairs({'a\0b\0',string.rep('prefix\0suffix',2048)}) do
+    verify(text,'',text)
+    verify(text,text,'')
+    verify('before'..text..'after','before','',text,'','after')
+  end
+end)
+check('numeric operands still become strings',function()
+  for _,value in ipairs({0,-0.0,1,-7,1.25,2147483647,-2147483648,math.huge,-math.huge}) do
+    local text=tostring(value)
+    verify(text,'',value)
+    verify(text,value,'')
+    verify(text..text,'',value,'',value,'')
+    local empty=''
+    assert(empty..value==text and value..empty==text)
+  end
+end)
+check('boolean and nil operands preserve errors',function()
+  for _,value in ipairs({true,false,{}}) do
+    assert(not pcall(concat,'',value))
+    assert(not pcall(concat,value,''))
+  end
+  assert(not pcall(concat,'',nil))
+  assert(not pcall(concat,nil,''))
+end)
+check('metamethods run on empty-string/object pairs',function()
+  local calls=0
+  local object={}
+  setmetatable(object,{})
+  getmetatable(object).__concat=function(left,right)
+    calls=calls+1
+    if left==object then return 'left:'..right end
+    return left..':right'
+  end
+  verify('left:',object,'')
+  verify(':right','',object)
+  assert(object..''=='left:' and ''..object==':right')
+  assert(calls==4)
+end)
+check('right-to-left metamethod ordering across empty strings',function()
+  local log={}
+  local function label(value) return type(value)=='table' and value.label or value end
+  local mt={__concat=function(left,right)
+    log[#log+1]=label(left)..'/'..label(right)
+    return label(left)..label(right)
+  end}
