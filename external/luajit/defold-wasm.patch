+/*
+** Portable bytecode interpreter for WebAssembly.
+** Copyright (C) 2005-2026 Mike Pall. See Copyright Notice in luajit.h
+**
+** The full interpreter handles hooks, stack growth, continuations and errors.
+** Hook-free opcodes use small handlers joined by Wasm tail calls,
+** following replicated dispatch in vm_arm.dasc and vm_arm64.dasc.
+** Those handlers keep function, base and constants in arguments. They must
+** publish the active frame before calling a helper that can throw, allocate
+** or reenter Lua, and reload stack pointers after a helper can resize it.
+*/
+
+#define lj_vminterp_c
+#define LUA_CORE
+
+#include <math.h>
+
+#pragma STDC FP_CONTRACT OFF
+
+#include "lauxlib.h"
+#include "lj_obj.h"
+#include "lj_gc.h"
+#include "lj_err.h"
+#include "lj_buf.h"
+#include "lj_str.h"
+#include "lj_tab.h"
+#include "lj_func.h"
+#include "lj_meta.h"
+#include "lj_state.h"
+#include "lj_frame.h"
+#include "lj_bc.h"
+#include "lj_ff.h"
+#include "lj_dispatch.h"
+#include "lj_lib.h"
+#include "lj_vm.h"
+
+#if !LJ_TARGET_WASM32 || LJ_HASJIT || LJ_HASFFI || LJ_FR2
+#error "The portable interpreter requires wasm32 without JIT or FFI"
+#endif
+
+/* Continuation identities. The interpreter dispatches these without calling
+** through an assembler entry point or a cast function pointer.
+*/
+void lj_cont_cat(void) {}
+void lj_cont_ra(void) {}
+void lj_cont_nop(void) {}
+void lj_cont_condt(void) {}
+void lj_cont_condf(void) {}
+void lj_cont_hook(void) {}
+
+/* -- Numeric conversions ------------------------------------------------- */
+
+int64_t lj_vm_num2int_check(double x)
+{
+  if (x >= -2147483648.0 && x < 2147483648.0) {
+    int32_t i = (int32_t)x;
+    if ((double)i == x) return (int64_t)(uint32_t)i;
+  }
+  return (int64_t)U64x(80000000,80000000);
+}
+
+int64_t lj_vm_num2i64(double x)
+{
+  if (x >= -9223372036854775808.0 && x < 9223372036854775808.0)
+    return (int64_t)x;
+  return (int64_t)U64x(80000000,00000000);
+}
+
+uint64_t lj_vm_num2u64(double x)
+{
+  if (x >= 0 && x < 18446744073709551616.0) return (uint64_t)x;
+  return (uint64_t)lj_vm_num2i64(x);
+}
+
+int32_t lj_vm_tobit(double x)
+{
+  TValue tv;
+  tv.n = x + 6755399441055744.0;
+  return (int32_t)tv.u32.lo;
+}
+
+/* CAT publishes its frame before this helper can allocate or throw, and roots
+** the result before its normal GC step. Allocation itself cannot run GC.
+*/
+static GCstr *vminterp_cat2(lua_State *L, GCstr *left, GCstr *right)
+{
+  uint64_t length;
+  SBuf *sb;
+  if (left->len == 0) return right;
+  if (right->len == 0) return left;
+  length = (uint64_t)left->len+right->len;
+  if (length >= LJ_MAX_STR) lj_err_msg(L, LJ_ERR_STROV);
+  sb = lj_buf_tmp_(L);
+  lj_buf_more(sb, (MSize)length);
+  lj_buf_putmem(sb, strdata(left), left->len);
+  lj_buf_putmem(sb, strdata(right), right->len);
+  return lj_buf_str(L, sb);
+}
+
+/* -- Fast functions ------------------------------------------------------ */
+
+#define VM_TAILCALL	(-2)
+#define VM_FFERR		0x100
+
+/* The caller publishes its frame and checks GC before allocating strings. */
+static GCstr *vminterp_substr(lua_State *L, GCstr *s, int32_t a, int32_t b)
+{
+  int32_t len = (int32_t)s->len;
+  if (a < 0) a += len+1;
+  if (b < 0) b += len+1;
+  if (a < 1) a = 1;
+  if (b > len) b = len;
+  return lj_str_new(L, strdata(s)+(a <= b ? a-1 : 0),
+                    a <= b ? (size_t)(b-a+1) : 0);
+}
+
+static GCstr *vminterp_strop(lua_State *L, GCstr *s, int id)
+{
+  SBuf *sb = lj_buf_tmp_(L);
+  if (id == FF_string_reverse) sb = lj_buf_putstr_reverse(sb, s);
+  else if (id == FF_string_lower) sb = lj_buf_putstr_lower(sb, s);
+  else sb = lj_buf_putstr_upper(sb, s);
+  return lj_buf_str(L, sb);
+}
+
+/* Reuse handlers which already implement their entire operation in C. Their
+** result area overlaps the function frame, so preserve it across the call.
+*/
+static int vminterp_fallback(lua_State *L, GCfunc *fn)
+{
+  TValue frame;
+  int n;
+  lj_gc_check(L);
+  frame = L->base[-1];
+  n = fn->c.f(L);
+  if (n == FFH_TAILCALL) return VM_TAILCALL;
+  lj_assertL(n > 0, "unexpected fast function retry");
+  n--;
+  memmove(L->base, L->base-1, (size_t)n*sizeof(TValue));
+  L->base[-1] = frame;
+  L->top = L->base+n;
+  return n;
+}
+
+static int vminterp_resume(lua_State *L, GCfunc *fn, int wrap)
+{
+  lua_State *co;
+  int n, status, nargs = (int)(L->top-L->base)-!wrap;
+  if (wrap) {
+    co = threadV(&fn->c.upvalue[0]);
+  } else {
+    if (L->top == L->base || !tvisthread(L->base))
+      lj_err_arg(L, 1, LJ_ERR_NOCORO);
+    co = threadV(L->base);
+  }
+  if (co->cframe || co->status > LUA_YIELD ||
+      (co->status == LUA_OK && co->top == co->base)) {
+    ErrMsg em = co->cframe ? LJ_ERR_CORUN : LJ_ERR_CODEAD;
+    if (wrap) lj_err_caller(L, em);
+    setboolV(L->top++, 0);
+    setstrV(L, L->top++, lj_err_str(L, em));
+    return 2;
+  }
+  if (tvref(co->maxstack)-co->top <= nargs &&
+      lj_state_cpgrowstack(co, (MSize)nargs) != LUA_OK) {
+    copyTV(L, L->top++, --co->top);
+    lj_err_run(L);
+  }
+  {
+    TValue *args = L->top-nargs, *cbase = co->top;
+    if (nargs == 1) copyTV(co, cbase, args);
+    else if (nargs > 1) memcpy(cbase, args, (size_t)nargs*sizeof(TValue));
+    L->top = args;
+    co->top = cbase+nargs;
+    /* The status and capacity checks above already cover lua_resume/xmove.
+    ** Keep the resumed thread on the caller's stack while it can run GC.
+    */
+    status = lj_vm_resume(co, cbase, 0, 0);
+  }
+  setgcref(G(L)->cur_L, obj2gco(L));
+  setvmstate(G(L), INTERP);
+  if (status > LUA_YIELD) {
+    if (wrap) {
+      copyTV(L, L->top++, --co->top);
+      lj_err_run(L);
+    }
+    setboolV(L->top++, 0);
+    copyTV(L, L->top++, --co->top);
+    return 2;
+  }
+  n = (int)(co->top-co->base);
+  lj_state_checkstack(L, (MSize)n+1);
+  if (!wrap) setboolV(L->top++, 1);
+  if (n == 1) copyTV(L, L->top, co->base);
+  else if (n > 1) memcpy(L->top, co->base, (size_t)n*sizeof(TValue));
+  L->top += n;
+  co->top = co->base;
+  return n+!wrap;
+}
+
+/* Return C-style results at L->top. pcall/xpcall and yield are handled by
+** the interpreter loop, so their Lua frames survive coroutine suspension.
+*/
+static int vminterp_fast(lua_State *L, GCfunc *fn)
+{
+  int id = fn->c.ffid;
+  double x, y;
+  switch (id) {
+  case FF_assert:
+    if (L->top == L->base || !tvistruecond(L->base))
+      return vminterp_fallback(L, fn);
+    return (int)(L->top-L->base);
+  case FF_type:
+    lj_lib_checkany(L, 1);
+    lua_pushstring(L, lua_typename(L, lua_type(L, 1)));
+    return 1;
+  case FF_next: {
+    GCtab *t = lj_lib_checktab(L, 1);
+    TValue key;
+    int more;
+    if (L->top > L->base+1) copyTV(L, &key, L->base+1);
+    else setnilV(&key);
+    more = lj_tab_next(t, &key, L->top);
+    if (more < 0) lj_err_msg(L, LJ_ERR_NEXTIDX);
+    if (more) { L->top += 2; return 2; }
+    setnilV(L->top++);
+    return 1;
+  }
+  case FF_pairs: case FF_ipairs: {
+#if LJ_52
+    cTValue *mo = lj_meta_lookup(L, lj_lib_checkany(L, 1),
+                               id == FF_pairs ? MM_pairs : MM_ipairs);
+    if (!tvisnil(mo)) return vminterp_fallback(L, fn);
+#endif
+    lj_lib_checktab(L, 1);
+    copyTV(L, L->top++, &fn->c.upvalue[0]);
+    copyTV(L, L->top++, L->base);
+    if (id == FF_pairs) setnilV(L->top++);
+    else setintV(L->top++, 0);
+    return 3;
+  }
+  case FF_ipairs_aux: {
+    GCtab *t = lj_lib_checktab(L, 1);
+    int32_t i = (int32_t)((uint32_t)lj_lib_checkint(L, 2)+1);
+    cTValue *v = lj_tab_getint(t, i);
+    if (!v || tvisnil(v)) return 0;
+    setintV(L->top++, i);
+    copyTV(L, L->top++, v);
+    return 2;
+  }
+  case FF_getmetatable: {
+    cTValue *mo = lj_meta_lookup(L, lj_lib_checkany(L, 1), MM_metatable);
+    if (!tvisnil(mo)) copyTV(L, L->top++, mo);
+    else if (!lua_getmetatable(L, 1)) setnilV(L->top++);
+    return 1;
+  }
+  case FF_rawget:
+    lj_lib_checktab(L, 1);
+    lj_lib_checkany(L, 2);
+    lua_pushvalue(L, 2);
+    lua_rawget(L, 1);
+    return 1;
+  case FF_setmetatable: case FF_tonumber: case FF_tostring:
+  case FF_string_byte: case FF_string_char:
+    return vminterp_fallback(L, fn);
+  case FF_coroutine_resume: case FF_coroutine_wrap_aux:
+    return vminterp_resume(L, fn, id == FF_coroutine_wrap_aux);
+  case FF_math_abs: case FF_math_floor: case FF_math_ceil: {
+    lj_lib_checknumber(L, 1);
+    if (tvisint(L->base)) {
+      int32_t i = intV(L->base);
+      if (id != FF_math_abs || i >= 0) copyTV(L, L->top++, L->base);
+      else setint64V(L->top++, -(int64_t)i);
+    } else {
+      x = numV(L->base);
+      x = id == FF_math_abs ? fabs(x) : id == FF_math_floor ? floor(x) : ceil(x);
+      setnumV(L->top++, x);
+    }
+    return 1;
+  }
+  case FF_math_sqrt: case FF_math_log: case FF_math_log10:
+  case FF_math_exp: case FF_math_sin: case FF_math_cos: case FF_math_tan:
+  case FF_math_asin: case FF_math_acos: case FF_math_atan:
+  case FF_math_sinh: case FF_math_cosh: case FF_math_tanh:
+  case FF_math_frexp: case FF_math_modf:
+    x = lj_lib_checknum(L, 1);
+    switch (id) {
+    case FF_math_sqrt: x = sqrt(x); break;
+    case FF_math_log:
+      if (L->top > L->base+1) {
+        y = lj_lib_checknum(L, 2);
+        x = log2(x)*(1.0/log2(y));
+      } else x = log(x);
+      break;
+    case FF_math_log10: x = log10(x); break;
+    case FF_math_exp: x = exp(x); break;
+    case FF_math_sin: x = sin(x); break;
+    case FF_math_cos: x = cos(x); break;
+    case FF_math_tan: x = tan(x); break;
+    case FF_math_asin: x = asin(x); break;
+    case FF_math_acos: x = acos(x); break;
+    case FF_math_atan: x = atan(x); break;
+    case FF_math_sinh: x = sinh(x); break;
+    case FF_math_cosh: x = cosh(x); break;
+    case FF_math_tanh: x = tanh(x); break;
+    case FF_math_frexp: {
+      int e;
+      x = frexp(x, &e);
+      setnumV(L->top++, x);
+      setintV(L->top++, e);
+      return 2;
+    }
+    default:
+      x = modf(x, &y);
+      setnumV(L->top++, y);
+      setnumV(L->top++, x);
+      return 2;
+    }
+    setnumV(L->top++, x);
+    return 1;
+  case FF_math_atan2: case FF_math_pow: case FF_math_fmod: case FF_math_ldexp:
+    x = lj_lib_checknum(L, 1);
+    y = lj_lib_checknum(L, 2);
+    if (id == FF_math_atan2) x = atan2(x, y);
+    else if (id == FF_math_pow) x = pow(x, y);
+    else if (id == FF_math_fmod) x = fmod(x, y);
+    else x = ldexp(x, lj_lib_checkint(L, 2));
+    setnumV(L->top++, x);
+    return 1;
+  case FF_math_min: case FF_math_max: {
+    int i, n = (int)(L->top-L->base);
+    TValue best;
+    lj_lib_checknumber(L, 1);
+    copyTV(L, &best, L->base);
+    for (i = 2; i <= n; i++) {
+      lj_lib_checknumber(L, i);
+      x = numberVnum(&best); y = numberVnum(L->base+i-1);
+      if (id == FF_math_min ? y < x : x < y)
+        copyTV(L, &best, L->base+i-1);
+    }
+    copyTV(L, L->top++, &best);
+    return 1;
+  }
+  case FF_string_sub: {
+    GCstr *s;
+    int32_t a, b;
+    lj_gc_check(L);
+    s = lj_lib_checkstr(L, 1);
+    a = lj_lib_checkint(L, 2); b = lj_lib_optint(L, 3, -1);
+    setstrV(L, L->top++, vminterp_substr(L, s, a, b));
+    return 1;
+  }
+  case FF_string_reverse: case FF_string_lower: case FF_string_upper: {
+    GCstr *s;
+    lj_gc_check(L);
+    s = lj_lib_checkstr(L, 1);
+    setstrV(L, L->top++, vminterp_strop(L, s, id));
+    return 1;
+  }
+  case FF_bit_tobit: case FF_bit_bnot: case FF_bit_bswap:
+  case FF_bit_band: case FF_bit_bor: case FF_bit_bxor:
+  case FF_bit_lshift: case FF_bit_rshift: case FF_bit_arshift:
+  case FF_bit_rol: case FF_bit_ror: {
+    int i, n = (int)(L->top-L->base);
+    uint32_t v = (uint32_t)lj_num2bit(lj_lib_checknum(L, 1));
+    if (id == FF_bit_bnot) v = ~v;
+    else if (id == FF_bit_bswap) v = lj_bswap(v);
+    else if (id >= FF_bit_lshift && id <= FF_bit_ror) {
+      uint32_t sh = (uint32_t)lj_num2bit(lj_lib_checknum(L, 2)) & 31;
+      if (id == FF_bit_lshift) v <<= sh;
+      else if (id == FF_bit_rshift) v >>= sh;
+      else if (id == FF_bit_arshift) v = (uint32_t)((int32_t)v >> sh);
+      else if (id == FF_bit_rol) v = lj_rol(v, sh);
+      else v = lj_ror(v, sh);
+    } else if (id == FF_bit_band || id == FF_bit_bor || id == FF_bit_bxor) {
+      for (i = 2; i <= n; i++) {
+        uint32_t w = (uint32_t)lj_num2bit(lj_lib_checknum(L, i));
+        if (id == FF_bit_band) v &= w;
+        else if (id == FF_bit_bor) v |= w;
+        else v ^= w;
+      }
+    }
+    setintV(L->top++, (int32_t)v);
+    return 1;
+  }
+  default:
+    lj_assertL(0, "unimplemented fast function %d", id);
+    lj_err_msg(L, LJ_ERR_BCBAD);
+    return 0;
+  }
+}
+
+/* -- Shared bytecode operations ------------------------------------------ */
+
+/* Follow the integer-overflow and FP paths in vm_arm{,64}.dasc. Each opcode
+** selects its operation at compile time; ordinary arithmetic stays inline.
+*/
+#define VM_ARITH_DUAL(oper, overflow, rbexpr, rcexpr, slow) \
+  { \
+    cTValue *rb = (rbexpr), *rc = (rcexpr); \
+    int32_t i; \
+    if (tvisint(rb) && tvisint(rc) && !overflow(intV(rb), intV(rc), &i)) \
+      setintV(base+a, i); \
+    else if (tvisnumber(rb) && tvisnumber(rc)) \
+      setnumV(base+a, numberVnum(rb) oper numberVnum(rc)); \
+    else slow(rb, rc); \
+    break; \
+  }
+
+#define VM_ARITH_FP(expr, rbexpr, rcexpr, slow) \
+  { \
+    cTValue *rb = (rbexpr), *rc = (rcexpr); \
+    if (tvisnumber(rb) && tvisnumber(rc)) { \
+      double x = numberVnum(rb), y = numberVnum(rc); \
+      setnumV(base+a, (expr)); \
+    } else slow(rb, rc); \
+    break; \
+  }
+
+#define VM_ARITH_MOD(rbexpr, rcexpr, slow) \
+  { \
+    cTValue *rb = (rbexpr), *rc = (rcexpr); \
+    if (tvisint(rb) && tvisint(rc) && intV(rc) != 0) { \
+      int32_t x = intV(rb), y = intV(rc); \
+      int32_t r = y == -1 ? 0 : x % y; \
+      if (r != 0 && (r^y) < 0) r += y; \
+      setintV(base+a, r); \
+    } else if (tvisnumber(rb) && tvisnumber(rc)) { \
+      double x = numberVnum(rb), y = numberVnum(rc); \
+      setnumV(base+a, x-floor(x/y)*y); \
+    } else slow(rb, rc); \
+    break; \
+  }
+
+/* Numeric constants in VN/NV bytecodes cannot require coercion. Keep the
+** variable's guards and preserve operand order for metamethod fallbacks.
+*/
+#define VM_ARITH_K(oper, overflow, vexpr, kexpr, reverse, slow) \
+  { \
+    cTValue *v = (vexpr), *k = (kexpr); \
+    cTValue *rb = (reverse) ? k : v, *rc = (reverse) ? v : k; \
+    int32_t result; \
+    if (tvisint(v) && tvisint(k) && !overflow(intV(rb), intV(rc), &result)) \
+      setintV(base+a, result); \
+    else if (tvisnumber(v)) \
+      setnumV(base+a, numberVnum(rb) oper numberVnum(rc)); \
+    else slow(rb, rc); \
+    break; \
+  }
+
+#define VM_ARITH_KFP(expr, vexpr, kexpr, reverse, slow) \
+  { \
+    cTValue *v = (vexpr), *k = (kexpr); \
+    cTValue *rb = (reverse) ? k : v, *rc = (reverse) ? v : k; \
+    if (tvisnumber(v)) { \
+      double x = numberVnum(rb), y = numberVnum(rc); \
+      setnumV(base+a, (expr)); \
+    } else slow(rb, rc); \
+    break; \
+  }
+
+#define VM_ARITH_KMOD(vexpr, kexpr, reverse, slow) \
+  { \
+    cTValue *v = (vexpr), *k = (kexpr); \
+    cTValue *rb = (reverse) ? k : v, *rc = (reverse) ? v : k; \
+    if (tvisint(v) && tvisint(k) && intV(rc) != 0) { \
+      int32_t x = intV(rb), y = intV(rc); \
+      int32_t r = y == -1 ? 0 : x % y; \
+      if (r != 0 && (r^y) < 0) r += y; \
+      setintV(base+a, r); \
+    } else if (tvisnumber(v)) { \
+      double x = numberVnum(rb), y = numberVnum(rc); \
+      setnumV(base+a, x-floor(x/y)*y); \
+    } else slow(rb, rc); \
+    break; \
+  }
+
+/* Same string-ID hash-chain walk and negative metamethod cache checks as
+** BC_TGETS/BC_TSETS in the assembler backends.
+*/
+static LJ_AINLINE cTValue *vminterp_getstr(GCtab *t, GCstr *key)
+{
+  Node *n = hashstr(t, key);
+  do {
+    if (tvisstr(&n->key) && strV(&n->key) == key) return &n->val;
+  } while ((n = nextnode(n)) != NULL);
+  return NULL;
+}
+
+static LJ_AINLINE int vminterp_nomm(GCtab *t, MMS mm)
+{
+  GCtab *mt = tabref(t->metatable);
+  return mt == NULL || (mt->nomm & (1u << mm));
+}
+
+static LJ_AINLINE int vminterp_equal(cTValue *a, cTValue *b)
+{
+  if (itype(a) == itype(b)) {
+    if (tvispri(a)) return 1;
+    if (!tvisnum(a)) return gcrefeq(a->gcr, b->gcr);
+  } else if (!tvisnumber(a) || !tvisnumber(b)) return 0;
+  return numberVnum(a) == numberVnum(b);
+}
+
+/* The assembler comparisons consume their following JMP in the same handler.
+** Only the hook-free handlers use this path, preserving instruction counts.
+*/
+static LJ_AINLINE const BCIns *vminterp_branch(const BCIns *pc, int cond)
+{
+  if (!cond) return pc+1;
+  if (bc_op(*pc) == BC_JMP) return pc+1+bc_j(*pc);
+  return pc;
+}
+
+#define VM_KNUM(idx) \
+  check_exp((uintptr_t)(idx) < pt->sizekn, &kbase[(idx)])
+
+/* -- Numeric reduction fusion -------------------------------------------- */
+
+/* A reduction followed by its numeric-loop backedge can run without decoding
+** the same pair of bytecodes on every iteration. This is an interpreter
+** superinstruction: the bytecode is unchanged, and no code is generated.
+** Guards exclude hooks, metamethods and writes to the loop-control registers.
+*/
+static LJ_NOINLINE int vminterp_fuseloop(lua_State *L, TValue *base, BCReg a, BCIns ins,
+                           cTValue *kbase)
+{
+  BCOp op = bc_op(ins);
+  BCReg dst = bc_a(ins), b = bc_b(ins), c = bc_c(ins);
+  TValue value, operand;
+  int source = 0, reverse = 0;
+  int32_t idx, stop, step;
+  if (dst >= a && dst <= a+3) return 0;
+  if (!(tvisint(base+a) && tvisint(base+a+1) && tvisint(base+a+2)))
+    return 0;
+  if (op >= BC_ADDVN && op <= BC_MULVN && b == dst) {
+    copyTV(L, &operand, kbase+c);
+  } else if (op >= BC_ADDNV && op <= BC_MULNV && b == dst) {
+    copyTV(L, &operand, kbase+c);
+    reverse = 1;
+    op = (BCOp)(op-BC_ADDNV+BC_ADDVN);
+  } else if (op >= BC_ADDVV && op <= BC_MULVV && (b == dst || c == dst)) {
+    BCReg other = b == dst ? c : b;
+    copyTV(L, &operand, base+other);
+    source = other == dst ? 2 : (other == a || other == a+3);
+    reverse = b != dst;
+    op = (BCOp)(op-BC_ADDVV+BC_ADDVN);
+  } else return 0;
+  if (!tvisnumber(base+dst) || !tvisnumber(&operand)) return 0;
+  copyTV(L, &value, base+dst);
+  idx = intV(base+a); stop = intV(base+a+1); step = intV(base+a+2);
+#define VM_FUSE_NEXT() \
+  do { \
+    int32_t next; \
+    if (__builtin_add_overflow(idx, step, &next)) goto done; \
+    idx = next; \
+    if (step >= 0 ? idx > stop : idx < stop) goto done; \
+  } while (0)
+#define VM_FUSE_ARITH(oper, overflow) \
+  { \
+    if (tvisint(&value) && tvisint(&operand)) { \
+      int32_t v = intV(&value), arg = intV(&operand), r; \
+      for (;;) { \
+        int32_t x, y; \
+        if (source == 1) arg = idx; \
+        else if (source == 2) arg = v; \
+        x = reverse ? arg : v; y = reverse ? v : arg; \
+        if (overflow(x, y, &r)) { \
+          setnumV(&value, (double)x oper (double)y); \
+          VM_FUSE_NEXT(); \
+          break; \
+        } \
+        v = r; \
+        setintV(&value, v); \
+        VM_FUSE_NEXT(); \
+      } \
+    } \
+    { \
+      double v = numberVnum(&value), arg = numberVnum(&operand); \
+      for (;;) { \
+        if (source == 1) arg = (double)idx; \
+        else if (source == 2) arg = v; \
+        v = reverse ? arg oper v : v oper arg; \
+        setnumV(&value, v); \
+        VM_FUSE_NEXT(); \
+      } \
+    } \
+  }
+  switch (op) {
+  case BC_ADDVN: VM_FUSE_ARITH(+, __builtin_add_overflow);
+  case BC_SUBVN: VM_FUSE_ARITH(-, __builtin_sub_overflow);
+  case BC_MULVN: VM_FUSE_ARITH(*, __builtin_mul_overflow);
+  default: return 0;
+  }
+done:
+  copyTV(L, base+dst, &value);
+  setintV(base+a, idx); setintV(base+a+3, idx);
+  return 1;
+#undef VM_FUSE_ARITH
+#undef VM_FUSE_NEXT
+}
+
+/* Fuse two- or three-instruction multiply/add loop bodies. The scalar values
+** stay local until loop exit; no helper, GC, coercion or hook runs here.
+*/
+static LJ_NOINLINE int vminterp_fusemuladd(lua_State *L, TValue *base, BCReg a,
+                              const BCIns *body, cTValue *kbase, int count)
+{
+  BCIns mul = body[0], add = body[1];
+  BCReg temp = bc_a(mul), dest = bc_a(add), inputreg = bc_b(mul);
+  TValue value, product, factor, bias, accumulator, input;
+  int32_t idx, stop, step;
+  int source, reverse = 0;
+  BCReg accumreg = 0;
+  if (!tvisint(base+a) || !tvisint(base+a+1) || !tvisint(base+a+2)) return 0;
+  if ((temp >= a && temp <= a+3) || (dest >= a && dest <= a+3)) return 0;
+  idx = intV(base+a); stop = intV(base+a+1); step = intV(base+a+2);
+  if (step == 0) return 0;
+#define VM_CHAIN_ARITH(out, left, right, oper, overflow) \
+  do { \
+    int32_t result; \
+    if (tvisint(left) && tvisint(right) && \
+        !overflow(intV(left), intV(right), &result)) \
+      setintV(out, result); \
+    else \
+      setnumV(out, numberVnum(left) oper numberVnum(right)); \
+  } while (0)
+#define VM_CHAIN_NEXT(label) \
+  do { \
+    int32_t next; \
+    if (__builtin_add_overflow(idx, step, &next)) goto label; \
+    idx = next; \
+    if (step >= 0 ? idx > stop : idx < stop) goto label; \
+  } while (0)
+  if (bc_op(mul) == BC_MULVN && bc_op(add) == BC_ADDVN && bc_b(add) == temp) {
+    if (inputreg == temp && temp != dest) return 0;
+    if (!tvisnumber(base+inputreg)) return 0;
+    copyTV(L, &value, base+inputreg);
+    copyTV(L, &input, &value);
+    copyTV(L, &factor, kbase+bc_c(mul));
+    copyTV(L, &bias, kbase+bc_c(add));
+    source = inputreg == dest ? 0 : (inputreg == a || inputreg == a+3) ? 1 : 2;
+    if (count == 3) {
+      BCIns sum = body[2];
+      accumreg = bc_a(sum);
+      if (bc_op(sum) != BC_ADDVV || accumreg == temp || accumreg == dest ||
+          (accumreg >= a && accumreg <= a+3) || !tvisnumber(base+accumreg)) return 0;
+      if (bc_b(sum) == accumreg && bc_c(sum) == dest) reverse = 0;
+      else if (bc_c(sum) == accumreg && bc_b(sum) == dest) reverse = 1;
+      else return 0;
+      copyTV(L, &accumulator, base+accumreg);
+      if (inputreg == accumreg) source = 3;
+    } else if (count != 2) return 0;
+    /* A floating factor keeps every product and following add floating. */
+    if (tvisnum(&factor)) {
+      double v = numberVnum(&value), x = numberVnum(&input), p;
+      double f = numV(&factor), k = numberVnum(&bias);
+      double total = count == 3 ? numberVnum(&accumulator) : 0.0;
+      for (;;) {
+        if (source == 0) x = v;
+        else if (source == 1) x = (double)idx;
+        else if (source == 3) x = total;
+        p = x*f;
+        v = p+k;
+        if (count == 3) total = reverse ? v+total : total+v;
+        VM_CHAIN_NEXT(fp_constant_done);
+      }
+fp_constant_done:
+      setnumV(&product, p); setnumV(&value, v);
+      if (count == 3) setnumV(&accumulator, total);
+      goto done;
+    }
+    for (;;) {
+      if (source == 0) copyTV(L, &input, &value);
+      else if (source == 1) setintV(&input, idx);
+      else if (source == 3) copyTV(L, &input, &accumulator);
+      VM_CHAIN_ARITH(&product, &input, &factor, *, __builtin_mul_overflow);
+      VM_CHAIN_ARITH(&value, &product, &bias, +, __builtin_add_overflow);
+      if (count == 3) {
+        if (reverse) VM_CHAIN_ARITH(&accumulator, &value, &accumulator, +, __builtin_add_overflow);
+        else VM_CHAIN_ARITH(&accumulator, &accumulator, &value, +, __builtin_add_overflow);
+      }
+      VM_CHAIN_NEXT(done);
+    }
+  } else if (count == 2 && bc_op(mul) == BC_MULVV && bc_op(add) == BC_ADDVV) {
+    BCReg left = bc_b(mul), right = bc_c(mul);
+    int ls, rs;
+    TValue lhs, rhs;
+    if (temp == dest || left == temp || right == temp || !tvisnumber(base+dest) ||
+        !tvisnumber(base+left) || !tvisnumber(base+right)) return 0;
+    if (bc_b(add) == dest && bc_c(add) == temp) reverse = 0;
+    else if (bc_c(add) == dest && bc_b(add) == temp) reverse = 1;
+    else return 0;
+    ls = left == dest ? 2 : (left == a || left == a+3) ? 1 : 0;
+    rs = right == dest ? 2 : (right == a || right == a+3) ? 1 : 0;
+    copyTV(L, &factor, base+left); copyTV(L, &bias, base+right);
+    copyTV(L, &value, base+dest);
+    if ((ls == 0 && tvisnum(&factor)) || (rs == 0 && tvisnum(&bias)) ||
+        ((ls == 2 || rs == 2) && tvisnum(&value))) {
+      double v = numberVnum(&value), x = numberVnum(&factor), y = numberVnum(&bias), p;
+      for (;;) {
+        double l = ls == 2 ? v : ls == 1 ? (double)idx : x;
+        double r = rs == 2 ? v : rs == 1 ? (double)idx : y;
+        p = l*r;
+        v = reverse ? p+v : v+p;
+        VM_CHAIN_NEXT(fp_variable_done);
+      }
+fp_variable_done:
+      setnumV(&product, p); setnumV(&value, v);
+      goto done;
+    }
+    for (;;) {
+      if (ls == 2) copyTV(L, &lhs, &value);
+      else if (ls == 1) setintV(&lhs, idx);
+      else copyTV(L, &lhs, &factor);
+      if (rs == 2) copyTV(L, &rhs, &value);
+      else if (rs == 1) setintV(&rhs, idx);
+      else copyTV(L, &rhs, &bias);
+      VM_CHAIN_ARITH(&product, &lhs, &rhs, *, __builtin_mul_overflow);
+      if (reverse) VM_CHAIN_ARITH(&value, &product, &value, +, __builtin_add_overflow);
+      else VM_CHAIN_ARITH(&value, &value, &product, +, __builtin_add_overflow);
+      VM_CHAIN_NEXT(done);
+    }
+  } else return 0;
+done:
+  if (temp != dest) copyTV(L, base+temp, &product);
+  copyTV(L, base+dest, &value);
+  if (count == 3) copyTV(L, base+accumreg, &accumulator);
+  setintV(base+a, idx); setintV(base+a+3, idx);
+  return 1;
+#undef VM_CHAIN_ARITH
+#undef VM_CHAIN_NEXT
+}
+
+/* -- Tail-call opcode dispatch ------------------------------------------- */
+
+/* Mirror the replicated dispatch in the assembler VMs with Wasm tail calls.
+** Handlers which need a helper return the unexecuted instruction to the full
+** interpreter, preserving its error, GC and continuation paths.
+*/
+typedef struct VMFastState {
+  lua_State *L;
+  void *cf;
+  int status;  /* LUA_OK or LUA_YIELD when the handler stream finishes. */
+} VMFastState;
+
+/* Adjust results directly in the Lua caller's slots, like assembler returns.
+*/
+static LJ_AINLINE void vminterp_fastresults(VMFastState *vm, GCproto *pt, TValue *base,
+                                          TValue *dest, cTValue *src,
+                                          int nres, int want)
+{
+  lua_State *L = vm->L;
+  int i;
+  if (nres == 1) copyTV(L, dest, src);
+  else if (nres > 1) memmove(dest, src, (size_t)nres*sizeof(TValue));
+  for (i = nres; i < want; i++) setnilV(dest+i);
+  cframe_multres(vm->cf) = (uint32_t)nres+1;
+  L->top = base+pt->framesize;
+  if (want < 0 && dest+nres > L->top) L->top = dest+nres;
+}
+
+#define VM_FASTARGS \
+  VMFastState *vm, const BCIns *pc, TValue *base, cTValue *kbase, GCfunc *fn, BCIns ins
+typedef const BCIns *(*VMFastHandler)(VM_FASTARGS);
+#define VM_FASTDECL(name, ma, mb, mc, mt) \
+  static const BCIns *vminterp_op_##name(VM_FASTARGS);
+BCDEF(VM_FASTDECL)
+#undef VM_FASTDECL
+static const BCIns *vminterp_hotloop(VM_FASTARGS);
+
+static const VMFastHandler vminterp_handlers[] = {
+#define VM_FASTENTRY(name, ma, mb, mc, mt) vminterp_op_##name,
+BCDEF(VM_FASTENTRY)
+#undef VM_FASTENTRY
+};
+
+/* Shared dispatch includes the existing nonallocating table and iterator
+** paths. Allocating operations and Lua/C calls keep their original handlers.
+*/
+#define VM_ENTRY_OPCODE(op) ((op) == BC_MOV || \
+     (op) == BC_NOT || \
+     (op) == BC_UNM || \
+     (op) == BC_LEN || \
+     (op) == BC_KSTR || \
+     (op) == BC_KSHORT || \
+     (op) == BC_KNUM || \
+     (op) == BC_KPRI || \
+     (op) == BC_KNIL || \
+     (op) == BC_UGET || \
+     (op) == BC_ISLT || \
+     (op) == BC_ISGE || \
+     (op) == BC_ISLE || \
+     (op) == BC_ISGT || \
+     (op) == BC_ISEQV || \
+     (op) == BC_ISNEV || \
+     (op) == BC_ISEQS || \
+     (op) == BC_ISNES || \
+     (op) == BC_ISEQN || \
+     (op) == BC_ISNEN || \
+     (op) == BC_ISEQP || \
+     (op) == BC_ISNEP || \
+     (op) == BC_ISTC || \
+     (op) == BC_ISFC || \
+     (op) == BC_IST || \
+     (op) == BC_ISF || \
+     (op) == BC_ISTYPE || \
+     (op) == BC_ISNUM || \
+     (op) == BC_ADDVN || \
+     (op) == BC_SUBVN || \
+     (op) == BC_MULVN || \
+     (op) == BC_DIVVN || \
+     (op) == BC_MODVN || \
+     (op) == BC_ADDNV || \
+     (op) == BC_SUBNV || \
+     (op) == BC_MULNV || \
+     (op) == BC_DIVNV || \
+     (op) == BC_MODNV || \
+     (op) == BC_ADDVV || \
+     (op) == BC_SUBVV || \
+     (op) == BC_MULVV || \
+     (op) == BC_DIVVV || \
+     (op) == BC_MODVV || \
+     (op) == BC_GGET || \
+     (op) == BC_GSET || \
+     (op) == BC_TGETV || \
+     (op) == BC_TGETS || \
+     (op) == BC_TGETB || \
+     (op) == BC_TSETV || \
+     (op) == BC_TSETS || \
+     (op) == BC_TSETB || \
+     (op) == BC_ITERC || \
+     (op) == BC_ITERL || \
+     (op) == BC_IITERL || \
+     (op) == BC_POW || \
+     (op) == BC_FORI || \
+     (op) == BC_FORL || \
+     (op) == BC_IFORL || \
+     (op) == BC_JMP || \
+     (op) == BC_LOOP || \
+     (op) == BC_ILOOP)
+static const VMFastHandler vminterp_dispatchers[] = {
+#define VM_HOTENTRY(name, ma, mb, mc, mt) \
+  VM_ENTRY_OPCODE(BC_##name) ? vminterp_hotloop : vminterp_op_##name,
