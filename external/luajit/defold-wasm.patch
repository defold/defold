+  same(pcall(add, nil, 2), false)
+  values({false, "handled"}, xpcall(add, handled, nil, 2))
+  local function fail() error(marker) end
+  values({false, marker}, pcall(fail))
+  local function nested() return pcall(fail) end
+  values({true, false, marker}, pcall(nested))
+  local function tail() return pcall(add, 20, 22) end
+  values({true, true, 42}, pcall(tail))
+  a, b, c, ok = assert("value", nil, marker)
+  values({"value", nil, marker, n=4}, a, b, c, ok)
+  assert(true)
+  same(pcall(assert), false)
+  same(pcall(assert, false), false)
+  same(type(marker, "ignored"), "table")
+  a, b = type(0/0)
+  values({"number", n=2}, a, b)
+  same(type(coroutine.create(none)), "thread")
+  same(type(newproxy()), "userdata")
+  local byte = string.byte
+  values({65}, byte("AB"))
+  values({66}, byte("AB", -1))
+  values({}, byte("AB", 0))
+  values({}, byte("AB", 3))
+  a, b = byte("AB", 2)
+  values({66, n=2}, a, b)
+  values({65, 66}, byte("AB", 1, 2))
+end)
+
+test("coroutines and yieldable protected calls", function()
+  local co = coroutine.create(function(a)
+    values({7, 8}, coroutine.yield(a, 2))
+    local ok, result = pcall(function() return coroutine.yield("pcall") end)
+    same(ok, true); same(result, "resumed")
+    ok, result = xpcall(function() coroutine.yield("xpcall"); error("after yield") end,
+                         function() return "caught" end)
+    same(ok, false); same(result, "caught")
+    return "done"
+  end)
+  values({true, 1, 2}, coroutine.resume(co, 1))
+  same(coroutine.status(co), "suspended")
+  values({true, "pcall"}, coroutine.resume(co, 7, 8))
+  values({true, "xpcall"}, coroutine.resume(co, "resumed"))
+  values({true, "done"}, coroutine.resume(co))
+  same(coroutine.status(co), "dead")
+  same(coroutine.resume(co), false)
+  local f = coroutine.wrap(function() coroutine.yield(10); return 20 end)
+  same(f(), 10); same(f(), 20); same(pcall(f), false)
+  f = coroutine.wrap(function() error("wrapped error") end)
+  local ok, err = pcall(f)
+  same(ok, false); assert(err:match("wrapped error"))
+  same(pcall(coroutine.yield), false)
+  co = coroutine.create(function()
+    for i = 1, 10000 do coroutine.yield(i) end
+  end)
+  for i = 1, 10000 do values({true, i}, coroutine.resume(co)) end
+  values({true}, coroutine.resume(co))
+end)
+
+test("coroutine result growth, errors and hook changes", function()
+  local marker = {}
+  local co = coroutine.create(function(a, b, c)
+    values({1, nil, 3, n=3}, a, b, c)
+    collectgarbage()
+    local x, y, z = coroutine.yield(marker, nil, 7)
+    values({4, nil, 6, n=3}, x, y, z)
+    local ok = pcall(function() error("caught in coroutine") end)
+    same(ok, false)
+    coroutine.yield("recovered")
+    return marker, nil, "done"
+  end)
+  values({true, marker, nil, 7, n=4}, coroutine.resume(co, 1, nil, 3))
+  values({true, "recovered"}, coroutine.resume(co, 4, nil, 6))
+  values({true, marker, nil, "done", n=4}, coroutine.resume(co))
+  local payload = {}
+  for i = 1, 1500 do payload[i] = i end
+  co = coroutine.create(function()
+    collectgarbage()
+    local received = {coroutine.yield(unpack(payload))}
+    same(#received, 1500)
+    for i = 1, 1500 do same(received[i], i) end
+    return unpack(received)
+  end)
+  local result = pack(coroutine.resume(co))
+  same(result.n, 1501); same(result[1], true)
+  for i = 1, 1500 do same(result[i+1], i) end
+  result = pack(coroutine.resume(co, unpack(payload)))
+  same(result.n, 1501); same(result[1], true)
+  for i = 1, 1500 do same(result[i+1], i) end
+  local wrapped = coroutine.wrap(function()
+    coroutine.yield(unpack(payload))
+    return marker, nil, "wrapped"
+  end)
+  result = pack(wrapped())
+  same(result.n, 1500); same(result[1500], 1500)
+  values({marker, nil, "wrapped", n=3}, wrapped())
+  local hits = 0
+  co = coroutine.create(function()
+    debug.sethook(function() hits=hits+1 end, "", 1)
+    return 42
+  end)
+  local ok, value = coroutine.resume(co)
+  local before = hits
+  local a = 1
+  a = a+2
+  a = a+3
+  debug.sethook()
+  same(ok, true); same(value, 42); same(a, 6)
+  assert(hits > before)
+end)
+
+test("yielding metamethod continuations", function()
+  local co = coroutine.create(function()
+    local t = setmetatable({}, {
+      __index=function(_, k) return coroutine.yield("get:"..k) end,
+      __newindex=function(_, k, v) coroutine.yield("set:"..k..v) end,
+      __add=function() return coroutine.yield("add") end,
+      __lt=function() return coroutine.yield("lt") end,
+      __concat=function() return coroutine.yield("cat") end,
+      __tostring=function() return coroutine.yield("str") end
+    })
+    same(t.foo, 42)
+    t.bar = 7
+    same(t+t, 5)
+    assert(t < t)
+    same("a"..t..t.."b", "afinal")
+    same(tostring(t), "text")
+    return "done"
+  end)
+  values({true, "get:foo"}, coroutine.resume(co))
+  values({true, "set:bar7"}, coroutine.resume(co, 42))
+  values({true, "add"}, coroutine.resume(co))
+  values({true, "lt"}, coroutine.resume(co, 5))
+  values({true, "cat"}, coroutine.resume(co, true))
+  values({true, "cat"}, coroutine.resume(co, "right"))
+  values({true, "str"}, coroutine.resume(co, "final"))
+  values({true, "done"}, coroutine.resume(co, "text"))
+end)
+
+test("debug hooks and stack inspection", function()
+  local counts = {call=0, ["return"]=0, line=0, count=0}
+  debug.sethook(function(event)
+    counts[event] = counts[event]+1
+    same(type(debug.getinfo(2, "f").func), "function")
+  end, "crl", 10)
+  local function f(n) if n == 0 then return 0 end; return f(n-1)+1 end
+  same(f(5), 5)
+  debug.sethook()
+  assert(counts.call > 0 and counts["return"] > 0 and counts.count > 0)
+  -- Stripped bytecode may have no line events.
+  local ok, err = xpcall(function() error("trace me") end, debug.traceback)
+  same(ok, false); assert(err:match("trace me") and err:match("stack traceback"))
+  local f = assert(loadstring("local a=1\nlocal b=2\nlocal missing=nil\nreturn missing.x",
+                              "@wasm-saved-pc.lua"))
+  ok, err = pcall(f)
+  same(ok, false); assert(err:match("wasm%-saved%-pc.lua:4:"))
+end)
+
+-- Garbage collection and host I/O.
+
+test("garbage collection in allocating builtins", function()
+  collectgarbage()
+  local before = collectgarbage("count")
+  local last
+  for i = 1, 100000 do
+    last = string.char(i%256, math.floor(i/256)%256, math.floor(i/65536)%256)
+  end
+  same(#last, 3)
+  assert(collectgarbage("count")-before < 2048)
+  local seed = string.rep("a", 3000)
+  collectgarbage()
+  before = collectgarbage("count")
+  for i = 1, 3000 do last = string.sub(seed, 1, i) end
+  same(#last, 3000)
+  assert(collectgarbage("count")-before < 2048)
+end)
+
+test("garbage collection, weak tables and finalizers", function()
+  local closed
+  do
+    local value
+    closed = function(v) if v then value = v end; return value end
+  end
+  collectgarbage()
+  for i = 1, 5000 do
+    closed({i, string.rep("x", 100)})
+    if i % 100 == 0 then collectgarbage("step", 1) end
+  end
+  collectgarbage()
+  same(closed()[1], 5000)
+  local weak = setmetatable({}, {__mode="v"})
+  weak[1] = {}
+  collectgarbage(); same(weak[1], nil)
+  local finalized = 0
+  for i = 1, 20 do
+    local p = newproxy(true)
+    getmetatable(p).__gc = function() finalized = finalized+1 end
+  end
+  collectgarbage(); collectgarbage()
+  same(finalized, 20)
+  local buffer = require("string.buffer")
+  local b = buffer.new()
+  b:put("hello", " ", 42)
+  same(b:get(), "hello 42")
+  same(buffer.decode(buffer.encode({a=42})).a, 42)
+end)
+
+test("Node filesystem access", function()
+  local f = assert(io.tmpfile())
+  assert(f:write("hello\n", 42, "\n"))
+  same(f:seek("set"), 0)
+  same(f:read("*l"), "hello")
+  same(f:read("*n"), 42)
+  assert(f:close())
+end)
+
+print("passed " .. tests .. " interpreter tests")
